{"number":105,"source":"Kur’an metni ve kelime çözümlemesi: Quran.com · Türkçe meal: Shaban Britch; birleşik dört ayetin ayrımı: Dar Al-Salam Center","verses":[{"number":1,"reference":"105:1","arabic":"أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِأَصْحَـٰبِ ٱلْفِيلِ","meaning":"Rabbinin, fil sahiplerini ne yaptığını görmedin mi?","words":[{"arabic":"أَلَمْ","meaning":"görmedin mi?"},{"arabic":"تَرَ","meaning":""},{"arabic":"كَيْفَ","meaning":"nasıl"},{"arabic":"فَعَلَ","meaning":"yaptığını"},{"arabic":"رَبُّكَ","meaning":"Rabbinin"},{"arabic":"بِأَصْحَـٰبِ","meaning":"sahiplerine"},{"arabic":"ٱلْفِيلِ","meaning":"fil"}]},{"number":2,"reference":"105:2","arabic":"أَلَمْ يَجْعَلْ كَيْدَهُمْ فِى تَضْلِيلٍ","meaning":"Onların tuzaklarını boşa çıkarmadı mı?","words":[{"arabic":"أَلَمْ","meaning":"çıkarmadı mı?"},{"arabic":"يَجْعَلْ","meaning":""},{"arabic":"كَيْدَهُمْ","meaning":"onların tuzaklarını"},{"arabic":"فِى","meaning":"boşa"},{"arabic":"تَضْلِيلٍۢ","meaning":""}]},{"number":3,"reference":"105:3","arabic":"وَأَرْسَلَ عَلَيْهِمْ طَيْرًا أَبَابِيلَ","meaning":"Onların üzerine sürü sürü kuşlar gönderdi.","words":[{"arabic":"وَأَرْسَلَ","meaning":"ve gönderdi"},{"arabic":"عَلَيْهِمْ","meaning":"üzerlerine"},{"arabic":"طَيْرًا","meaning":"kuşlar"},{"arabic":"أَبَابِيلَ","meaning":"sürü sürü"}]},{"number":4,"reference":"105:4","arabic":"تَرْمِيهِم بِحِجَارَةٍ مِّن سِجِّيلٍ","meaning":"Pişirilmiş çamurdan taşlar atan.","words":[{"arabic":"تَرْمِيهِم","meaning":"onlara atıyorlardı"},{"arabic":"بِحِجَارَةٍۢ","meaning":"sertleşmiş taşlar"},{"arabic":"مِّن","meaning":"çamurdan"},{"arabic":"سِجِّيلٍۢ","meaning":""}]},{"number":5,"reference":"105:5","arabic":"فَجَعَلَهُمْ كَعَصْفٍ مَّأْكُولٍۭ","meaning":"Onları yenilip çiğnenmiş ekin gibi yaptı.","words":[{"arabic":"فَجَعَلَهُمْ","meaning":"nihayet onları yaptı"},{"arabic":"كَعَصْفٍۢ","meaning":"ekin yaprağı gibi"},{"arabic":"مَّأْكُولٍۭ","meaning":"yenmiş"}]}]}
