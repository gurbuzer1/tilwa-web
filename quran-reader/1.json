{"number":1,"source":"Kur’an metni ve kelime çözümlemesi: Quran.com · Türkçe meal: Shaban Britch; birleşik dört ayetin ayrımı: Dar Al-Salam Center","verses":[{"number":1,"reference":"1:1","arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ","meaning":"Rahman ve Rahim Allah’ın adıyla...","words":[{"arabic":"بِسْمِ","meaning":"adıyla"},{"arabic":"ٱللَّهِ","meaning":"Allah'ın"},{"arabic":"ٱلرَّحْمَـٰنِ","meaning":"Rahman"},{"arabic":"ٱلرَّحِيمِ","meaning":"Rahim"}]},{"number":2,"reference":"1:2","arabic":"ٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَـٰلَمِينَ","meaning":"Hamd, alemlerin Rab'bi Allah'a mahsustur.","words":[{"arabic":"ٱلْحَمْدُ","meaning":"hamdolsun"},{"arabic":"لِلَّهِ","meaning":"Allah'a"},{"arabic":"رَبِّ","meaning":"Rabbi"},{"arabic":"ٱلْعَـٰلَمِينَ","meaning":"Alemlerin"}]},{"number":3,"reference":"1:3","arabic":"ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ","meaning":"O Rahman'dır, O Rahim'dir.","words":[{"arabic":"ٱلرَّحْمَـٰنِ","meaning":"(O) Rahman'dır"},{"arabic":"ٱلرَّحِيمِ","meaning":"Rahim'dir"}]},{"number":4,"reference":"1:4","arabic":"مَـٰلِكِ يَوْمِ ٱلدِّينِ","meaning":"Hesap gününün hakimi Allah’a mahsustur.","words":[{"arabic":"مَـٰلِكِ","meaning":"sahibidir"},{"arabic":"يَوْمِ","meaning":"gününün"},{"arabic":"ٱلدِّينِ","meaning":"Din"}]},{"number":5,"reference":"1:5","arabic":"إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ","meaning":"Yalnız sana ibadet ederiz ve yalnız senden yardım dileriz.","words":[{"arabic":"إِيَّاكَ","meaning":"ancak sana"},{"arabic":"نَعْبُدُ","meaning":"kulluk ederiz"},{"arabic":"وَإِيَّاكَ","meaning":"ancak senden"},{"arabic":"نَسْتَعِينُ","meaning":"yardım isteriz"}]},{"number":6,"reference":"1:6","arabic":"ٱهْدِنَا ٱلصِّرَٰطَ ٱلْمُسْتَقِيمَ","meaning":"Bizi doğru yola ilet.","words":[{"arabic":"ٱهْدِنَا","meaning":"bizi ilet"},{"arabic":"ٱلصِّرَٰطَ","meaning":"yola"},{"arabic":"ٱلْمُسْتَقِيمَ","meaning":"doğru"}]},{"number":7,"reference":"1:7","arabic":"صِرَٰطَ ٱلَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ ٱلْمَغْضُوبِ عَلَيْهِمْ وَلَا ٱلضَّآلِّينَ","meaning":"Nimet verdiğin kimselerin yoluna. Gazaba uğrayanların ve sapanların değil.","words":[{"arabic":"صِرَٰطَ","meaning":"yoluna"},{"arabic":"ٱلَّذِينَ","meaning":"onlar ki"},{"arabic":"أَنْعَمْتَ","meaning":"ni'met verdin"},{"arabic":"عَلَيْهِمْ","meaning":"kimselerin"},{"arabic":"غَيْرِ","meaning":"değil"},{"arabic":"ٱلْمَغْضُوبِ","meaning":"gazabedilmiş olanların"},{"arabic":"عَلَيْهِمْ","meaning":"kendilerine"},{"arabic":"وَلَا","meaning":"ve değil"},{"arabic":"ٱلضَّآلِّينَ","meaning":"sapmışların"}]}]}
