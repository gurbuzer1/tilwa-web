{"number":97,"source":"Kur’an metni ve kelime çözümlemesi: Quran.com · Türkçe meal: Shaban Britch; birleşik dört ayetin ayrımı: Dar Al-Salam Center","verses":[{"number":1,"reference":"97:1","arabic":"إِنَّآ أَنزَلْنَـٰهُ فِى لَيْلَةِ ٱلْقَدْرِ","meaning":"Şüphesiz biz, (Kur’an’ı) Kadir Gecesi'nde indirdik.","words":[{"arabic":"إِنَّآ","meaning":"elbette biz"},{"arabic":"أَنزَلْنَـٰهُ","meaning":"onu indirdik"},{"arabic":"فِى","meaning":"gecesinde"},{"arabic":"لَيْلَةِ","meaning":""},{"arabic":"ٱلْقَدْرِ","meaning":"kadir"}]},{"number":2,"reference":"97:2","arabic":"وَمَآ أَدْرَىٰكَ مَا لَيْلَةُ ٱلْقَدْرِ","meaning":"Kadir Gecesi'nin ne olduğunu sana bildiren nedir?","words":[{"arabic":"وَمَآ","meaning":"nedir?"},{"arabic":"أَدْرَىٰكَ","meaning":"sana bildiren"},{"arabic":"مَا","meaning":"ne olduğunu"},{"arabic":"لَيْلَةُ","meaning":"gecesi(nin)"},{"arabic":"ٱلْقَدْرِ","meaning":"kadir"}]},{"number":3,"reference":"97:3","arabic":"لَيْلَةُ ٱلْقَدْرِ خَيْرٌ مِّنْ أَلْفِ شَهْرٍ","meaning":"Kadir Gecesi bin aydan hayırlıdır.","words":[{"arabic":"لَيْلَةُ","meaning":"gecesi"},{"arabic":"ٱلْقَدْرِ","meaning":"kadir"},{"arabic":"خَيْرٌۭ","meaning":"hayırlıdır"},{"arabic":"مِّنْ","meaning":"bin-dan"},{"arabic":"أَلْفِ","meaning":"bin"},{"arabic":"شَهْرٍۢ","meaning":""}]},{"number":4,"reference":"97:4","arabic":"تَنَزَّلُ ٱلْمَلَـٰٓئِكَةُ وَٱلرُّوحُ فِيهَا بِإِذْنِ رَبِّهِم مِّن كُلِّ أَمْرٍ","meaning":"Melekler ve Ruh, Rabbinin izni ile her iş için o gece iner.","words":[{"arabic":"تَنَزَّلُ","meaning":"iner de iner"},{"arabic":"ٱلْمَلَـٰٓئِكَةُ","meaning":"melekler"},{"arabic":"وَٱلرُّوحُ","meaning":"ve Ruh"},{"arabic":"فِيهَا","meaning":"onda"},{"arabic":"بِإِذْنِ","meaning":"izniyle"},{"arabic":"رَبِّهِم","meaning":"Rab'lerinin"},{"arabic":"مِّن","meaning":"için"},{"arabic":"كُلِّ","meaning":"her"},{"arabic":"أَمْرٍۢ","meaning":"iş"}]},{"number":5,"reference":"97:5","arabic":"سَلَـٰمٌ هِىَ حَتَّىٰ مَطْلَعِ ٱلْفَجْرِ","meaning":"Fecrin doğana kadar bir selamet olsun.","words":[{"arabic":"سَلَـٰمٌ","meaning":"esenliktir"},{"arabic":"هِىَ","meaning":"o"},{"arabic":"حَتَّىٰ","meaning":"kadar"},{"arabic":"مَطْلَعِ","meaning":"ağarıncaya"},{"arabic":"ٱلْفَجْرِ","meaning":"tan yeri"}]}]}
