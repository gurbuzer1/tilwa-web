{"number":83,"source":"Kur’an metni ve kelime çözümlemesi: Quran.com · Türkçe meal: Shaban Britch; birleşik dört ayetin ayrımı: Dar Al-Salam Center","verses":[{"number":1,"reference":"83:1","arabic":"وَيْلٌ لِّلْمُطَفِّفِينَ","meaning":"Ölçüde hile yapanların vay haline!","words":[{"arabic":"وَيْلٌۭ","meaning":"vay haline"},{"arabic":"لِّلْمُطَفِّفِينَ","meaning":"ölçü ve tartıda hile yapanların"}]},{"number":2,"reference":"83:2","arabic":"ٱلَّذِينَ إِذَا ٱكْتَالُوا۟ عَلَى ٱلنَّاسِ يَسْتَوْفُونَ","meaning":"İnsanlardan/halktan aldıklarında tam alan,","words":[{"arabic":"ٱلَّذِينَ","meaning":"onlar"},{"arabic":"إِذَا","meaning":"zaman"},{"arabic":"ٱكْتَالُوا۟","meaning":"bir şey ölçüp aldıkları"},{"arabic":"عَلَى","meaning":"insanlardan"},{"arabic":"ٱلنَّاسِ","meaning":""},{"arabic":"يَسْتَوْفُونَ","meaning":"ölçüyü tam yaparlar"}]},{"number":3,"reference":"83:3","arabic":"وَإِذَا كَالُوهُمْ أَو وَّزَنُوهُمْ يُخْسِرُونَ","meaning":"Onlara tartıp/ölçtüklerinde eksik verenler,","words":[{"arabic":"وَإِذَا","meaning":"ve zaman"},{"arabic":"كَالُوهُمْ","meaning":"kendileri onlara bir şey ölçtükleri"},{"arabic":"أَو","meaning":"veya"},{"arabic":"وَّزَنُوهُمْ","meaning":"tarttıkları"},{"arabic":"يُخْسِرُونَ","meaning":"eksik yaparlar"}]},{"number":4,"reference":"83:4","arabic":"أَلَا يَظُنُّ أُو۟لَـٰٓئِكَ أَنَّهُم مَّبْعُوثُونَ","meaning":"Onlar yeniden dirileceklerini inanmıyorlar mı?","words":[{"arabic":"أَلَا","meaning":"sanmıyorlar mı?"},{"arabic":"يَظُنُّ","meaning":""},{"arabic":"أُو۟لَـٰٓئِكَ","meaning":"işte"},{"arabic":"أَنَّهُم","meaning":"onlar"},{"arabic":"مَّبْعُوثُونَ","meaning":"tekrar diriltileceklerini"}]},{"number":5,"reference":"83:5","arabic":"لِيَوْمٍ عَظِيمٍ","meaning":"Büyük bir günde…","words":[{"arabic":"لِيَوْمٍ","meaning":"bir gün için"},{"arabic":"عَظِيمٍۢ","meaning":"büyük"}]},{"number":6,"reference":"83:6","arabic":"يَوْمَ يَقُومُ ٱلنَّاسُ لِرَبِّ ٱلْعَـٰلَمِينَ","meaning":"O gün insanlar, alemlerin Rabbi için ayağa kalkar.","words":[{"arabic":"يَوْمَ","meaning":"o gün"},{"arabic":"يَقُومُ","meaning":"dururlar"},{"arabic":"ٱلنَّاسُ","meaning":"insanlar"},{"arabic":"لِرَبِّ","meaning":"Rabbinin divanında"},{"arabic":"ٱلْعَـٰلَمِينَ","meaning":"alemlerin"}]},{"number":7,"reference":"83:7","arabic":"كَلَّآ إِنَّ كِتَـٰبَ ٱلْفُجَّارِ لَفِى سِجِّينٍ","meaning":"Hayır! Şüphesiz günahkârların kitabı Siccin'dedir.","words":[{"arabic":"كَلَّآ","meaning":"hayır"},{"arabic":"إِنَّ","meaning":"doğrusu"},{"arabic":"كِتَـٰبَ","meaning":"yazıcısı"},{"arabic":"ٱلْفُجَّارِ","meaning":"sapanların"},{"arabic":"لَفِى","meaning":"elbette"},{"arabic":"سِجِّينٍۢ","meaning":"Siccin'dedir"}]},{"number":8,"reference":"83:8","arabic":"وَمَآ أَدْرَىٰكَ مَا سِجِّينٌ","meaning":"Siccin'in ne olduğunu nereden bileceksin?","words":[{"arabic":"وَمَآ","meaning":"nedir?"},{"arabic":"أَدْرَىٰكَ","meaning":"sana bildiren"},{"arabic":"مَا","meaning":"ne olduğunu"},{"arabic":"سِجِّينٌۭ","meaning":"Siccin('in)"}]},{"number":9,"reference":"83:9","arabic":"كِتَـٰبٌ مَّرْقُومٌ","meaning":"(Amelleri) yazılmış bir kitaptır.","words":[{"arabic":"كِتَـٰبٌۭ","meaning":"bir Kitaptır"},{"arabic":"مَّرْقُومٌۭ","meaning":"yazılmış"}]},{"number":10,"reference":"83:10","arabic":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","meaning":"Yalanlayanların o gün vay haline!","words":[{"arabic":"وَيْلٌۭ","meaning":"vay haline"},{"arabic":"يَوْمَئِذٍۢ","meaning":"o gün"},{"arabic":"لِّلْمُكَذِّبِينَ","meaning":"yalanlayanların"}]},{"number":11,"reference":"83:11","arabic":"ٱلَّذِينَ يُكَذِّبُونَ بِيَوْمِ ٱلدِّينِ","meaning":"Din gününü yalanlayanların.","words":[{"arabic":"ٱلَّذِينَ","meaning":"onlar"},{"arabic":"يُكَذِّبُونَ","meaning":"yalanlamaktadırlar"},{"arabic":"بِيَوْمِ","meaning":"gününü"},{"arabic":"ٱلدِّينِ","meaning":"ceza"}]},{"number":12,"reference":"83:12","arabic":"وَمَا يُكَذِّبُ بِهِۦٓ إِلَّا كُلُّ مُعْتَدٍ أَثِيمٍ","meaning":"Onu, her haddi aşan günahkârdan başkası yalanlamaz.","words":[{"arabic":"وَمَا","meaning":"yalanlamaz"},{"arabic":"يُكَذِّبُ","meaning":""},{"arabic":"بِهِۦٓ","meaning":"onu"},{"arabic":"إِلَّا","meaning":"başkası"},{"arabic":"كُلُّ","meaning":"her"},{"arabic":"مُعْتَدٍ","meaning":"saldırgan"},{"arabic":"أَثِيمٍ","meaning":"günahkardan"}]},{"number":13,"reference":"83:13","arabic":"إِذَا تُتْلَىٰ عَلَيْهِ ءَايَـٰتُنَا قَالَ أَسَـٰطِيرُ ٱلْأَوَّلِينَ","meaning":"Ona ayetlerimiz okunduğu zaman \"evvelkilerin masalları\" der.","words":[{"arabic":"إِذَا","meaning":"zaman"},{"arabic":"تُتْلَىٰ","meaning":"okunduğu"},{"arabic":"عَلَيْهِ","meaning":"ona"},{"arabic":"ءَايَـٰتُنَا","meaning":"ayetlerimiz"},{"arabic":"قَالَ","meaning":"der"},{"arabic":"أَسَـٰطِيرُ","meaning":"masalları"},{"arabic":"ٱلْأَوَّلِينَ","meaning":"eskilerin"}]},{"number":14,"reference":"83:14","arabic":"كَلَّا ۖ بَلْ ۜ رَانَ عَلَىٰ قُلُوبِهِم مَّا كَانُوا۟ يَكْسِبُونَ","meaning":"Hayır! Aksine, kazandıkları (günahlar) onların kalplerini bürümüştür.","words":[{"arabic":"كَلَّا ۖ","meaning":"hayır"},{"arabic":"بَلْ ۜ","meaning":"doğrusu"},{"arabic":"رَانَ","meaning":"paslanmıştır"},{"arabic":"عَلَىٰ","meaning":"üzeri"},{"arabic":"قُلُوبِهِم","meaning":"kalblerinin"},{"arabic":"مَّا","meaning":"şeyler"},{"arabic":"كَانُوا۟","meaning":"oldukları"},{"arabic":"يَكْسِبُونَ","meaning":"kazanıyor(lar)"}]},{"number":15,"reference":"83:15","arabic":"كَلَّآ إِنَّهُمْ عَن رَّبِّهِمْ يَوْمَئِذٍ لَّمَحْجُوبُونَ","meaning":"Hayır! Gerçek şu ki, onlar o gün Rab’lerinden (görmekten) mahrum olanlardır.","words":[{"arabic":"كَلَّآ","meaning":"hayır"},{"arabic":"إِنَّهُمْ","meaning":"doğrusu onlar"},{"arabic":"عَن","meaning":"Rablerinden"},{"arabic":"رَّبِّهِمْ","meaning":""},{"arabic":"يَوْمَئِذٍۢ","meaning":"o gün"},{"arabic":"لَّمَحْجُوبُونَ","meaning":"perdelenmişlerdir"}]},{"number":16,"reference":"83:16","arabic":"ثُمَّ إِنَّهُمْ لَصَالُوا۟ ٱلْجَحِيمِ","meaning":"Sonra da onlar Cehennem'e sokulacaktır.","words":[{"arabic":"ثُمَّ","meaning":"sonra"},{"arabic":"إِنَّهُمْ","meaning":"onlar"},{"arabic":"لَصَالُوا۟","meaning":"elbette gireceklerdir"},{"arabic":"ٱلْجَحِيمِ","meaning":"cehenneme"}]},{"number":17,"reference":"83:17","arabic":"ثُمَّ يُقَالُ هَـٰذَا ٱلَّذِى كُنتُم بِهِۦ تُكَذِّبُونَ","meaning":"Sonra da onlara denilecek ki: Bu yalanlamış olduğunuz şeydir.","words":[{"arabic":"ثُمَّ","meaning":"sonra"},{"arabic":"يُقَالُ","meaning":"denilecektir"},{"arabic":"هَـٰذَا","meaning":"işte budur"},{"arabic":"ٱلَّذِى","meaning":"şey"},{"arabic":"كُنتُم","meaning":"olduğunuz"},{"arabic":"بِهِۦ","meaning":"onu"},{"arabic":"تُكَذِّبُونَ","meaning":"yalanlıyor(lar)"}]},{"number":18,"reference":"83:18","arabic":"كَلَّآ إِنَّ كِتَـٰبَ ٱلْأَبْرَارِ لَفِى عِلِّيِّينَ","meaning":"Hayır! İyilerin kitabı, “İlliyyun”dedir.","words":[{"arabic":"كَلَّآ","meaning":"hayır"},{"arabic":"إِنَّ","meaning":"şüphesiz"},{"arabic":"كِتَـٰبَ","meaning":"yazısı"},{"arabic":"ٱلْأَبْرَارِ","meaning":"iyilerin"},{"arabic":"لَفِى","meaning":"elbette"},{"arabic":"عِلِّيِّينَ","meaning":"İlliyyindedir"}]},{"number":19,"reference":"83:19","arabic":"وَمَآ أَدْرَىٰكَ مَا عِلِّيُّونَ","meaning":"İlliyyun’un ne olduğunu nereden bileceksin?","words":[{"arabic":"وَمَآ","meaning":"nedir?"},{"arabic":"أَدْرَىٰكَ","meaning":"sana bildiren"},{"arabic":"مَا","meaning":"ne olduğunu"},{"arabic":"عِلِّيُّونَ","meaning":"İlliyyin('in)"}]},{"number":20,"reference":"83:20","arabic":"كِتَـٰبٌ مَّرْقُومٌ","meaning":"(Amelleri) yazılmış bir kitaptır.","words":[{"arabic":"كِتَـٰبٌۭ","meaning":"bir Kitaptır"},{"arabic":"مَّرْقُومٌۭ","meaning":"yazılmış"}]},{"number":21,"reference":"83:21","arabic":"يَشْهَدُهُ ٱلْمُقَرَّبُونَ","meaning":"Ona yakınlaştırılmış olanlar (Melekler) şahit olurlar.","words":[{"arabic":"يَشْهَدُهُ","meaning":"ona tanık olurlar"},{"arabic":"ٱلْمُقَرَّبُونَ","meaning":"yaklaştırılmış olanlar"}]},{"number":22,"reference":"83:22","arabic":"إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍ","meaning":"İyiler, elbette nimetler içindedir.","words":[{"arabic":"إِنَّ","meaning":"şüphesiz"},{"arabic":"ٱلْأَبْرَارَ","meaning":"iyiler"},{"arabic":"لَفِى","meaning":"elbette içindedirler"},{"arabic":"نَعِيمٍ","meaning":"ni'met"}]},{"number":23,"reference":"83:23","arabic":"عَلَى ٱلْأَرَآئِكِ يَنظُرُونَ","meaning":"Koltuklar üzerinde, bakıyorlar.","words":[{"arabic":"عَلَى","meaning":"üzerinde"},{"arabic":"ٱلْأَرَآئِكِ","meaning":"divanlar"},{"arabic":"يَنظُرُونَ","meaning":"oturup bakarlar"}]},{"number":24,"reference":"83:24","arabic":"تَعْرِفُ فِى وُجُوهِهِمْ نَضْرَةَ ٱلنَّعِيمِ","meaning":"Onları, yüzlerindeki nimet parıltısından tanırsın.","words":[{"arabic":"تَعْرِفُ","meaning":"sezersin"},{"arabic":"فِى","meaning":"yüzlerinde"},{"arabic":"وُجُوهِهِمْ","meaning":""},{"arabic":"نَضْرَةَ","meaning":"sevinç ve parıltısını"},{"arabic":"ٱلنَّعِيمِ","meaning":"ni'metin"}]},{"number":25,"reference":"83:25","arabic":"يُسْقَوْنَ مِن رَّحِيقٍ مَّخْتُومٍ","meaning":"Onlar, mühürlenmiş, katıksız bir içecekten içerler.","words":[{"arabic":"يُسْقَوْنَ","meaning":"onlara içirilir"},{"arabic":"مِن","meaning":"halis bir şaraptan"},{"arabic":"رَّحِيقٍۢ","meaning":""},{"arabic":"مَّخْتُومٍ","meaning":"mühürlü"}]},{"number":26,"reference":"83:26","arabic":"خِتَـٰمُهُۥ مِسْكٌ ۚ وَفِى ذَٰلِكَ فَلْيَتَنَافَسِ ٱلْمُتَنَـٰفِسُونَ","meaning":"Onun mührü misktir. Yarışanlar, işte bunun için yarışsınlar!","words":[{"arabic":"خِتَـٰمُهُۥ","meaning":"ki onun sonu"},{"arabic":"مِسْكٌۭ ۚ","meaning":"misktir"},{"arabic":"وَفِى","meaning":"ve"},{"arabic":"ذَٰلِكَ","meaning":"işte bunun için"},{"arabic":"فَلْيَتَنَافَسِ","meaning":"yarışsınlar"},{"arabic":"ٱلْمُتَنَـٰفِسُونَ","meaning":"yarışanlar"}]},{"number":27,"reference":"83:27","arabic":"وَمِزَاجُهُۥ مِن تَسْنِيمٍ","meaning":"Onun karışımı Tesnim’dendir.","words":[{"arabic":"وَمِزَاجُهُۥ","meaning":"karışımı"},{"arabic":"مِن","meaning":"tesnimdendir"},{"arabic":"تَسْنِيمٍ","meaning":""}]},{"number":28,"reference":"83:28","arabic":"عَيْنًا يَشْرَبُ بِهَا ٱلْمُقَرَّبُونَ","meaning":"O, yakınlaştırılmış olanların içeceği bir kaynaktır.","words":[{"arabic":"عَيْنًۭا","meaning":"bir çeşme (ki)"},{"arabic":"يَشْرَبُ","meaning":"içerler"},{"arabic":"بِهَا","meaning":"ondan"},{"arabic":"ٱلْمُقَرَّبُونَ","meaning":"yaklaştırılanlar"}]},{"number":29,"reference":"83:29","arabic":"إِنَّ ٱلَّذِينَ أَجْرَمُوا۟ كَانُوا۟ مِنَ ٱلَّذِينَ ءَامَنُوا۟ يَضْحَكُونَ","meaning":"Suç/günah işlemiş olanlar, iman edenlere gülüyorlardı.","words":[{"arabic":"إِنَّ","meaning":"şüphesiz"},{"arabic":"ٱلَّذِينَ","meaning":"kimseler"},{"arabic":"أَجْرَمُوا۟","meaning":"suç işleyen(ler)"},{"arabic":"كَانُوا۟","meaning":"idiler"},{"arabic":"مِنَ","meaning":"kimselere"},{"arabic":"ٱلَّذِينَ","meaning":""},{"arabic":"ءَامَنُوا۟","meaning":"inanan(lara)"},{"arabic":"يَضْحَكُونَ","meaning":"gülüyor(lar)"}]},{"number":30,"reference":"83:30","arabic":"وَإِذَا مَرُّوا۟ بِهِمْ يَتَغَامَزُونَ","meaning":"Onların yanlarından geçtiklerinde birbirlerine kaş göz ediyorlardı.","words":[{"arabic":"وَإِذَا","meaning":"ve zaman"},{"arabic":"مَرُّوا۟","meaning":"yanından geçtikleri"},{"arabic":"بِهِمْ","meaning":"onların"},{"arabic":"يَتَغَامَزُونَ","meaning":"birbirlerine kaş göz ederlerdi"}]},{"number":31,"reference":"83:31","arabic":"وَإِذَا ٱنقَلَبُوٓا۟ إِلَىٰٓ أَهْلِهِمُ ٱنقَلَبُوا۟ فَكِهِينَ","meaning":"Ailelerinin yanına döndüklerinde alaylarından dolayı mutlu dönerlerdi.","words":[{"arabic":"وَإِذَا","meaning":"zaman da"},{"arabic":"ٱنقَلَبُوٓا۟","meaning":"döndükleri"},{"arabic":"إِلَىٰٓ","meaning":"ailelerine"},{"arabic":"أَهْلِهِمُ","meaning":""},{"arabic":"ٱنقَلَبُوا۟","meaning":"dönerlerdi"},{"arabic":"فَكِهِينَ","meaning":"eğlenerek"}]},{"number":32,"reference":"83:32","arabic":"وَإِذَا رَأَوْهُمْ قَالُوٓا۟ إِنَّ هَـٰٓؤُلَآءِ لَضَآلُّونَ","meaning":"Onları gördükleri zaman: \"İşte bunlar, doğru yoldan sapmış\" derlerdi.","words":[{"arabic":"وَإِذَا","meaning":"ve zaman"},{"arabic":"رَأَوْهُمْ","meaning":"onları gördükleri"},{"arabic":"قَالُوٓا۟","meaning":"derlerdi"},{"arabic":"إِنَّ","meaning":"şüphesiz"},{"arabic":"هَـٰٓؤُلَآءِ","meaning":"şunlar"},{"arabic":"لَضَآلُّونَ","meaning":"sapıklardır"}]},{"number":33,"reference":"83:33","arabic":"وَمَآ أُرْسِلُوا۟ عَلَيْهِمْ حَـٰفِظِينَ","meaning":"Oysa onlara bekçi olarak da gönderilmemişlerdi.","words":[{"arabic":"وَمَآ","meaning":"ve"},{"arabic":"أُرْسِلُوا۟","meaning":"kendileri gönderilmemişlerdi"},{"arabic":"عَلَيْهِمْ","meaning":"onların üzerine"},{"arabic":"حَـٰفِظِينَ","meaning":"bekçi olarak"}]},{"number":34,"reference":"83:34","arabic":"فَٱلْيَوْمَ ٱلَّذِينَ ءَامَنُوا۟ مِنَ ٱلْكُفَّارِ يَضْحَكُونَ","meaning":"Bugün de iman edenler, kâfir olanlara gülerler.","words":[{"arabic":"فَٱلْيَوْمَ","meaning":"işte bugün"},{"arabic":"ٱلَّذِينَ","meaning":"kimseler"},{"arabic":"ءَامَنُوا۟","meaning":"inanan(lar)"},{"arabic":"مِنَ","meaning":"kafirlere"},{"arabic":"ٱلْكُفَّارِ","meaning":""},{"arabic":"يَضْحَكُونَ","meaning":"gülerler"}]},{"number":35,"reference":"83:35","arabic":"عَلَى ٱلْأَرَآئِكِ يَنظُرُونَ","meaning":"Koltuklarına yaslanıp bakarlar.","words":[{"arabic":"عَلَى","meaning":"üzerinde"},{"arabic":"ٱلْأَرَآئِكِ","meaning":"divanlar"},{"arabic":"يَنظُرُونَ","meaning":"(oturup) bakarlar"}]},{"number":36,"reference":"83:36","arabic":"هَلْ ثُوِّبَ ٱلْكُفَّارُ مَا كَانُوا۟ يَفْعَلُونَ","meaning":"Kâfirler, yaptıklarının cezasını gördüler mi? diye.","words":[{"arabic":"هَلْ","meaning":"cezalandılarmı?"},{"arabic":"ثُوِّبَ","meaning":""},{"arabic":"ٱلْكُفَّارُ","meaning":"kafirler"},{"arabic":"مَا","meaning":"şeylerle"},{"arabic":"كَانُوا۟","meaning":"oldukları"},{"arabic":"يَفْعَلُونَ","meaning":"yapıyor(lar)"}]}]}
