{"number":80,"source":"Kur’an metni ve kelime çözümlemesi: Quran.com · Türkçe meal: Shaban Britch; birleşik dört ayetin ayrımı: Dar Al-Salam Center","verses":[{"number":1,"reference":"80:1","arabic":"عَبَسَ وَتَوَلَّىٰٓ","meaning":"(Peygamber) Yüzünü ekşitti ve döndü.","words":[{"arabic":"عَبَسَ","meaning":"surat astı"},{"arabic":"وَتَوَلَّىٰٓ","meaning":"ve döndü"}]},{"number":2,"reference":"80:2","arabic":"أَن جَآءَهُ ٱلْأَعْمَىٰ","meaning":"Ona gözleri görmeyen kimse geldi diye…","words":[{"arabic":"أَن","meaning":"diye"},{"arabic":"جَآءَهُ","meaning":"ona geldi"},{"arabic":"ٱلْأَعْمَىٰ","meaning":"kör"}]},{"number":3,"reference":"80:3","arabic":"وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ","meaning":"Ne bilirsin belki o, arınacaktır.","words":[{"arabic":"وَمَا","meaning":"ve ne?"},{"arabic":"يُدْرِيكَ","meaning":"bilirsin"},{"arabic":"لَعَلَّهُۥ","meaning":"belki o"},{"arabic":"يَزَّكَّىٰٓ","meaning":"arınacaktır"}]},{"number":4,"reference":"80:4","arabic":"أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ","meaning":"Veya öğüt alacak da öğüt ona fayda verecektir.","words":[{"arabic":"أَوْ","meaning":"yahut"},{"arabic":"يَذَّكَّرُ","meaning":"öğüt dinleyecektir"},{"arabic":"فَتَنفَعَهُ","meaning":"ve kendisine yarayacaktır"},{"arabic":"ٱلذِّكْرَىٰٓ","meaning":"öğüt"}]},{"number":5,"reference":"80:5","arabic":"أَمَّا مَنِ ٱسْتَغْنَىٰ","meaning":"Ama, kendisini ihtiyaçsız görene.","words":[{"arabic":"أَمَّا","meaning":"ama"},{"arabic":"مَنِ","meaning":"kimse ise"},{"arabic":"ٱسْتَغْنَىٰ","meaning":"kendisini muhtaç hissetmeyen"}]},{"number":6,"reference":"80:6","arabic":"فَأَنتَ لَهُۥ تَصَدَّىٰ","meaning":"Sen, yöneliyorsun ona.","words":[{"arabic":"فَأَنتَ","meaning":"sen"},{"arabic":"لَهُۥ","meaning":"ona"},{"arabic":"تَصَدَّىٰ","meaning":"yöneliyorsun"}]},{"number":7,"reference":"80:7","arabic":"وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ","meaning":"Arınmamasından sen sorumlu değilsin!","words":[{"arabic":"وَمَا","meaning":"nedir?"},{"arabic":"عَلَيْكَ","meaning":"sana düşen"},{"arabic":"أَلَّا","meaning":"onun arınmamasından"},{"arabic":"يَزَّكَّىٰ","meaning":""}]},{"number":8,"reference":"80:8","arabic":"وَأَمَّا مَن جَآءَكَ يَسْعَىٰ","meaning":"Ama, sana koşarak gelen,","words":[{"arabic":"وَأَمَّا","meaning":"fakat"},{"arabic":"مَن","meaning":"kimse ise"},{"arabic":"جَآءَكَ","meaning":"sana gelen"},{"arabic":"يَسْعَىٰ","meaning":"koşarak"}]},{"number":9,"reference":"80:9","arabic":"وَهُوَ يَخْشَىٰ","meaning":"Ve korkarak.","words":[{"arabic":"وَهُوَ","meaning":"ve o"},{"arabic":"يَخْشَىٰ","meaning":"saygı duyarak"}]},{"number":10,"reference":"80:10","arabic":"فَأَنتَ عَنْهُ تَلَهَّىٰ","meaning":"Sen ise ilgilenmiyorsun.","words":[{"arabic":"فَأَنتَ","meaning":"sen"},{"arabic":"عَنْهُ","meaning":"onunla"},{"arabic":"تَلَهَّىٰ","meaning":"ilgilenmiyorsun"}]},{"number":11,"reference":"80:11","arabic":"كَلَّآ إِنَّهَا تَذْكِرَةٌ","meaning":"Hayır! (Şunu iyi bil ki) şüphesiz bu bir öğüttür.","words":[{"arabic":"كَلَّآ","meaning":"hayır"},{"arabic":"إِنَّهَا","meaning":"elbette o"},{"arabic":"تَذْكِرَةٌۭ","meaning":"bir hatırlatmadır"}]},{"number":12,"reference":"80:12","arabic":"فَمَن شَآءَ ذَكَرَهُۥ","meaning":"Dileyen kimse düşünüp, öğüt alır.","words":[{"arabic":"فَمَن","meaning":"kimse"},{"arabic":"شَآءَ","meaning":"dileyen"},{"arabic":"ذَكَرَهُۥ","meaning":"onu düşünür öğüt alır"}]},{"number":13,"reference":"80:13","arabic":"فِى صُحُفٍ مُّكَرَّمَةٍ","meaning":"Şerefli sahifelerde.","words":[{"arabic":"فِى","meaning":"içindedir"},{"arabic":"صُحُفٍۢ","meaning":"sahifeler"},{"arabic":"مُّكَرَّمَةٍۢ","meaning":"değer verilen"}]},{"number":14,"reference":"80:14","arabic":"مَّرْفُوعَةٍ مُّطَهَّرَةٍۭ","meaning":"Yükseltilmiş ve tertemiz.","words":[{"arabic":"مَّرْفُوعَةٍۢ","meaning":"(saygı ile) yükseltilen"},{"arabic":"مُّطَهَّرَةٍۭ","meaning":"tertemiz"}]},{"number":15,"reference":"80:15","arabic":"بِأَيْدِى سَفَرَةٍ","meaning":"Elçilerin ellerinde.","words":[{"arabic":"بِأَيْدِى","meaning":"ellerinde"},{"arabic":"سَفَرَةٍۢ","meaning":"yazıcıların"}]},{"number":16,"reference":"80:16","arabic":"كِرَامٍۭ بَرَرَةٍ","meaning":"Şerefli ve tertemiz/itaatkar.","words":[{"arabic":"كِرَامٍۭ","meaning":"değerli"},{"arabic":"بَرَرَةٍۢ","meaning":"iyilik sahibi"}]},{"number":17,"reference":"80:17","arabic":"قُتِلَ ٱلْإِنسَـٰنُ مَآ أَكْفَرَهُۥ","meaning":"Kahrolası (kâfir) insan ne de çok kâfirdir!","words":[{"arabic":"قُتِلَ","meaning":"kahrolası"},{"arabic":"ٱلْإِنسَـٰنُ","meaning":"insan"},{"arabic":"مَآ","meaning":"ne kadar"},{"arabic":"أَكْفَرَهُۥ","meaning":"nankördür"}]},{"number":18,"reference":"80:18","arabic":"مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ","meaning":"Allah, onu hangi şeyden yarattı?","words":[{"arabic":"مِنْ","meaning":"hangi-den?"},{"arabic":"أَىِّ","meaning":"hangi"},{"arabic":"شَىْءٍ","meaning":""},{"arabic":"خَلَقَهُۥ","meaning":"onu yarattı"}]},{"number":19,"reference":"80:19","arabic":"مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ","meaning":"Bir sperm damlasından onu yaratıp, (aşamalardan geçirerek) biçime koydu.","words":[{"arabic":"مِن","meaning":"nutfe (sperm)den"},{"arabic":"نُّطْفَةٍ","meaning":""},{"arabic":"خَلَقَهُۥ","meaning":"onu yarattı"},{"arabic":"فَقَدَّرَهُۥ","meaning":"sonra ona biçim verdi"}]},{"number":20,"reference":"80:20","arabic":"ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ","meaning":"Sonra da ona yolu kolaylaştırdı.","words":[{"arabic":"ثُمَّ","meaning":"sonra"},{"arabic":"ٱلسَّبِيلَ","meaning":"yolu"},{"arabic":"يَسَّرَهُۥ","meaning":"ona kolaylaştırdı"}]},{"number":21,"reference":"80:21","arabic":"ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥ","meaning":"Sonra onu öldürüp kabre koydu.","words":[{"arabic":"ثُمَّ","meaning":"sonra"},{"arabic":"أَمَاتَهُۥ","meaning":"onu öldürdü"},{"arabic":"فَأَقْبَرَهُۥ","meaning":"kabre koydurdu"}]},{"number":22,"reference":"80:22","arabic":"ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ","meaning":"Sonra, onu dilediği zaman yeniden diriltecek.","words":[{"arabic":"ثُمَّ","meaning":"sonra"},{"arabic":"إِذَا","meaning":"zaman"},{"arabic":"شَآءَ","meaning":"dilediği"},{"arabic":"أَنشَرَهُۥ","meaning":"onu diriltip kaldırdı"}]},{"number":23,"reference":"80:23","arabic":"كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥ","meaning":"Hayır! Buna rağmen henüz onun emrini yerine getirmedi.","words":[{"arabic":"كَلَّا","meaning":"hayır"},{"arabic":"لَمَّا","meaning":"yerine getirmedi"},{"arabic":"يَقْضِ","meaning":""},{"arabic":"مَآ","meaning":"şeyi"},{"arabic":"أَمَرَهُۥ","meaning":"O'nun kendisine emrettiği"}]},{"number":24,"reference":"80:24","arabic":"فَلْيَنظُرِ ٱلْإِنسَـٰنُ إِلَىٰ طَعَامِهِۦٓ","meaning":"İnsan yemeğine bir baksın.","words":[{"arabic":"فَلْيَنظُرِ","meaning":"o halde baksın"},{"arabic":"ٱلْإِنسَـٰنُ","meaning":"insan"},{"arabic":"إِلَىٰ","meaning":"şu yiyeceğine"},{"arabic":"طَعَامِهِۦٓ","meaning":""}]},{"number":25,"reference":"80:25","arabic":"أَنَّا صَبَبْنَا ٱلْمَآءَ صَبًّا","meaning":"Ki, biz suyu döktükçe döktük.","words":[{"arabic":"اَنَّا","meaning":"biz"},{"arabic":"صَبَبْنَا","meaning":"döktük"},{"arabic":"ٱلْمَآءَ","meaning":"suyu"},{"arabic":"صَبًّۭا","meaning":"iyice döküşle"}]},{"number":26,"reference":"80:26","arabic":"ثُمَّ شَقَقْنَا ٱلْأَرْضَ شَقًّا","meaning":"Sonra yeri yardıkça yardık.","words":[{"arabic":"ثُمَّ","meaning":"sonra"},{"arabic":"شَقَقْنَا","meaning":"yardık"},{"arabic":"ٱلْأَرْضَ","meaning":"toprağı"},{"arabic":"شَقًّۭا","meaning":"güzel bir yarışla"}]},{"number":27,"reference":"80:27","arabic":"فَأَنۢبَتْنَا فِيهَا حَبًّا","meaning":"Ve orada taneler bitirdik.","words":[{"arabic":"فَأَنۢبَتْنَا","meaning":"ve bitirdik"},{"arabic":"فِيهَا","meaning":"orada"},{"arabic":"حَبًّۭا","meaning":"dane"}]},{"number":28,"reference":"80:28","arabic":"وَعِنَبًا وَقَضْبًا","meaning":"Üzümler, yoncalar.","words":[{"arabic":"وَعِنَبًۭا","meaning":"ve üzüm"},{"arabic":"وَقَضْبًۭا","meaning":"ve yonca"}]},{"number":29,"reference":"80:29","arabic":"وَزَيْتُونًا وَنَخْلًا","meaning":"Zeytinler, hurmalar.","words":[{"arabic":"وَزَيْتُونًۭا","meaning":"ve zeytin"},{"arabic":"وَنَخْلًۭا","meaning":"ve hurma"}]},{"number":30,"reference":"80:30","arabic":"وَحَدَآئِقَ غُلْبًا","meaning":"İri ağaçlı bahçeler.","words":[{"arabic":"وَحَدَآئِقَ","meaning":"ve bahçeler"},{"arabic":"غُلْبًۭا","meaning":"iri ve gür"}]},{"number":31,"reference":"80:31","arabic":"وَفَـٰكِهَةً وَأَبًّا","meaning":"Meyveler ve otlaklar.","words":[{"arabic":"وَفَـٰكِهَةًۭ","meaning":"ve meyva"},{"arabic":"وَأَبًّۭا","meaning":"ve çayır"}]},{"number":32,"reference":"80:32","arabic":"مَّتَـٰعًا لَّكُمْ وَلِأَنْعَـٰمِكُمْ","meaning":"Sizin ve hayvanlarınız için bir meta olarak.","words":[{"arabic":"مَّتَـٰعًۭا","meaning":"geçim olarak"},{"arabic":"لَّكُمْ","meaning":"sizin için"},{"arabic":"وَلِأَنْعَـٰمِكُمْ","meaning":"ve hayvanlarınız için"}]},{"number":33,"reference":"80:33","arabic":"فَإِذَا جَآءَتِ ٱلصَّآخَّةُ","meaning":"O büyük gürültü geldiği zaman,","words":[{"arabic":"فَإِذَا","meaning":"zaman"},{"arabic":"جَآءَتِ","meaning":"geldiği"},{"arabic":"ٱلصَّآخَّةُ","meaning":"kulakları sağır eden o ses"}]},{"number":34,"reference":"80:34","arabic":"يَوْمَ يَفِرُّ ٱلْمَرْءُ مِنْ أَخِيهِ","meaning":"O gün kişi kardeşinden kaçar.","words":[{"arabic":"يَوْمَ","meaning":"işte o gün"},{"arabic":"يَفِرُّ","meaning":"kaçar"},{"arabic":"ٱلْمَرْءُ","meaning":"kişi"},{"arabic":"مِنْ","meaning":"kardeşinden"},{"arabic":"أَخِيهِ","meaning":""}]},{"number":35,"reference":"80:35","arabic":"وَأُمِّهِۦ وَأَبِيهِ","meaning":"Anasından, babasından.","words":[{"arabic":"وَأُمِّهِۦ","meaning":"ve anasından"},{"arabic":"وَأَبِيهِ","meaning":"ve babası(ndan)"}]},{"number":36,"reference":"80:36","arabic":"وَصَـٰحِبَتِهِۦ وَبَنِيهِ","meaning":"Eşinden ve evladından.","words":[{"arabic":"وَصَـٰحِبَتِهِۦ","meaning":"ve eşi(nden)"},{"arabic":"وَبَنِيهِ","meaning":"ve oğulları(ndan)"}]},{"number":37,"reference":"80:37","arabic":"لِكُلِّ ٱمْرِئٍ مِّنْهُمْ يَوْمَئِذٍ شَأْنٌ يُغْنِيهِ","meaning":"O gün herkes için kendine yetecek bir işi vardır.","words":[{"arabic":"لِكُلِّ","meaning":"hepsinin vardır"},{"arabic":"ٱمْرِئٍۢ","meaning":"her kişinin"},{"arabic":"مِّنْهُمْ","meaning":"onlardan"},{"arabic":"يَوْمَئِذٍۢ","meaning":"o gün"},{"arabic":"شَأْنٌۭ","meaning":"bir derdi"},{"arabic":"يُغْنِيهِ","meaning":"kendisine yeter"}]},{"number":38,"reference":"80:38","arabic":"وُجُوهٌ يَوْمَئِذٍ مُّسْفِرَةٌ","meaning":"Yüzler vardır o gün apaydınlık.","words":[{"arabic":"وُجُوهٌۭ","meaning":"yüzler (var ki)"},{"arabic":"يَوْمَئِذٍۢ","meaning":"o gün"},{"arabic":"مُّسْفِرَةٌۭ","meaning":"parıl parıl"}]},{"number":39,"reference":"80:39","arabic":"ضَاحِكَةٌ مُّسْتَبْشِرَةٌ","meaning":"Güleç ve neşeli.","words":[{"arabic":"ضَاحِكَةٌۭ","meaning":"güleçtir"},{"arabic":"مُّسْتَبْشِرَةٌۭ","meaning":"sevinçlidir"}]},{"number":40,"reference":"80:40","arabic":"وَوُجُوهٌ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌ","meaning":"Yüzler vardır o gün, üzeri tozlu.","words":[{"arabic":"وَوُجُوهٌۭ","meaning":"ve yüzler (vardır)"},{"arabic":"يَوْمَئِذٍ","meaning":"o gün"},{"arabic":"عَلَيْهَا","meaning":"üzeri"},{"arabic":"غَبَرَةٌۭ","meaning":"tozlanmış"}]},{"number":41,"reference":"80:41","arabic":"تَرْهَقُهَا قَتَرَةٌ","meaning":"Karartı bürümüş.","words":[{"arabic":"تَرْهَقُهَا","meaning":"onları bürümüş"},{"arabic":"قَتَرَةٌ","meaning":"karanlık"}]},{"number":42,"reference":"80:42","arabic":"أُو۟لَـٰٓئِكَ هُمُ ٱلْكَفَرَةُ ٱلْفَجَرَةُ","meaning":"İşte onlar, kâfirler ve facirler onlardır.","words":[{"arabic":"أُو۟لَـٰٓئِكَ","meaning":"işte"},{"arabic":"هُمُ","meaning":"onlar"},{"arabic":"ٱلْكَفَرَةُ","meaning":"kafirlerdir"},{"arabic":"ٱلْفَجَرَةُ","meaning":"Hak'tan sapanlardır"}]}]}
