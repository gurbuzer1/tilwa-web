{"number":93,"source":"Kur’an metni ve kelime çözümlemesi: Quran.com · Türkçe meal: Shaban Britch; birleşik dört ayetin ayrımı: Dar Al-Salam Center","verses":[{"number":1,"reference":"93:1","arabic":"وَٱلضُّحَىٰ","meaning":"Andolsun kuşluk vaktine,","words":[{"arabic":"وَٱلضُّحَىٰ","meaning":"kuşluk vaktine andolsun"}]},{"number":2,"reference":"93:2","arabic":"وَٱلَّيْلِ إِذَا سَجَىٰ","meaning":"Sükuna erdiği vakit geceye,","words":[{"arabic":"وَٱلَّيْلِ","meaning":"ve geceye andolsun"},{"arabic":"إِذَا","meaning":"sakinleşen"},{"arabic":"سَجَىٰ","meaning":""}]},{"number":3,"reference":"93:3","arabic":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ","meaning":"Rabbin seni terk etmedi ve (vahyi geciktirerek) seni öfkelendirmedi.","words":[{"arabic":"مَا","meaning":"seni bırakmadı"},{"arabic":"وَدَّعَكَ","meaning":""},{"arabic":"رَبُّكَ","meaning":"Rabbin"},{"arabic":"وَمَا","meaning":"ve"},{"arabic":"قَلَىٰ","meaning":"darılmadı"}]},{"number":4,"reference":"93:4","arabic":"وَلَلْـَٔاخِرَةُ خَيْرٌ لَّكَ مِنَ ٱلْأُولَىٰ","meaning":"Gerçekten ahiret senin için dünyadan daha hayırlıdır.","words":[{"arabic":"وَلَلْـَٔاخِرَةُ","meaning":"ve sonu"},{"arabic":"خَيْرٌۭ","meaning":"iyi olacaktır"},{"arabic":"لَّكَ","meaning":"senin için"},{"arabic":"مِنَ","meaning":"ilkinden"},{"arabic":"ٱلْأُولَىٰ","meaning":""}]},{"number":5,"reference":"93:5","arabic":"وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰٓ","meaning":"Rabbin sana verecek ve sen de hoşnut olacaksın.","words":[{"arabic":"وَلَسَوْفَ","meaning":"ve yakında"},{"arabic":"يُعْطِيكَ","meaning":"sana verecektir"},{"arabic":"رَبُّكَ","meaning":"Rabbin"},{"arabic":"فَتَرْضَىٰٓ","meaning":"ve sen razı olacaksın"}]},{"number":6,"reference":"93:6","arabic":"أَلَمْ يَجِدْكَ يَتِيمًا فَـَٔاوَىٰ","meaning":"Seni yetim bulup barındırmadı mı?","words":[{"arabic":"أَلَمْ","meaning":"seni bulmadı mı?"},{"arabic":"يَجِدْكَ","meaning":""},{"arabic":"يَتِيمًۭا","meaning":"yetim"},{"arabic":"فَـَٔاوَىٰ","meaning":"ve barındırmadı mı?"}]},{"number":7,"refere