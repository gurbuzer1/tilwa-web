ُونَ","meaning":"Onları bitiren siz misiniz yoksa biz mi bitiriyoruz?","words":[{"arabic":"ءَأَنتُمْ","meaning":"siz mi?"},{"arabic":"تَزْرَعُونَهُۥٓ","meaning":"onu bitiyorsunuz"},{"arabic":"أَمْ","meaning":"yoks"},{"arabic":"نَحْنُ","meaning":"biz (miyiz?)"},{"arabic":"ٱلزَّٰرِعُونَ","meaning":"bitirenler"}]},{"number":65,"reference":"56:65","arabic":"لَوْ نَشَآءُ لَجَعَلْنَـٰهُ حُطَـٰمًا فَظَلْتُمْ تَفَكَّهُونَ","meaning":"Dilersek, onu çör çöp yaparız da şaşırıp kalırsınız.","words":[{"arabic":"لَوْ","meaning":"şayet"},{"arabic":"نَشَآءُ","meaning":"dileseydik"},{"arabic":"لَجَعَلْنَـٰهُ","meaning":"onu yapardık"},{"arabic":"حُطَـٰمًۭا","meaning":"kuru bir çöp"},{"arabic":"فَظَلْتُمْ","meaning":"dururdunuz"},{"arabic":"تَفَكَّهُونَ","meaning":"sızlanıp"}]},{"number":66,"reference":"56:66","arabic":"إِنَّا لَمُغْرَمُونَ","meaning":"Muhakkak biz çok ziyandayız!","words":[{"arabic":"إِنَّا","meaning":"elbette biz"},{"arabic":"لَمُغْرَمُونَ","meaning":"borçlandık"}]},{"number":67,"reference":"56:67","arabic":"بَلْ نَحْنُ مَحْرُومُونَ","meaning":"Doğrusu biz mahrum bırakıldık, dersiniz.","words":[{"arabic":"بَلْ","meaning":"doğrusu"},{"arabic":"نَحْنُ","meaning":"biz"},{"arabic":"مَحْرُومُونَ","meaning":"yoksun bırakıldık"}]},{"number":68,"reference":"56:68","arabic":"أَفَرَءَيْتُمُ ٱلْمَآءَ ٱلَّذِى تَشْرَبُونَ","meaning":"İçtiğiniz suyu gördünüz mü?","words":[{"arabic":"أَفَرَءَيْتُمُ","meaning":"baktınız mı?"},{"arabic":"ٱلْمَآءَ","meaning":"suya"},{"arabic":"ٱلَّذِى","meaning":"içtiğiniz"},{"arabic":"تَشْرَبُونَ","meaning":""}]},{"number":69,"reference":"56:69","arabic":"ءَأَنتُمْ أَنزَلْتُمُوهُ مِنَ ٱلْمُزْنِ أَمْ نَحْنُ ٱلْمُنزِلُونَ","meaning":"Onu buluttan siz mi indirdiniz yoksa indiren biz miyiz?","words":[{"arabic":"ءَأَنتُمْ","meaning":"siz mi?"},{"arabic":"أَنزَلْتُمُوهُ","meaning":"onu indirdiniz"},{"arabic":"مِنَ","meaning":"buluttan"},{"arabic":"ٱلْمُزْنِ","meaning":""},{"arabic":"أَمْ","meaning":"yoksa"},{"arabic":"نَحْنُ","meaning":"biz (miyiz?)"},{"arabic":"ٱلْمُنزِلُونَ","meaning":"indirenler"}]},{"number":70,"reference":"56:70","arabic":"لَوْ نَشَآءُ جَعَلْنَـٰهُ أُجَاجًا فَلَوْلَا تَشْكُرُونَ","meaning":"İsteseydik onu tuzlu bir su yapardık; şükretmeniz gerekmez mi?","words":[{"arabic":"لَوْ","meaning":"şayet"},{"arabic":"نَشَآءُ","meaning":"dileseydik"},{"arabic":"جَعَلْنَـٰهُ","meaning":"onu yapardık"},{"arabic":"أُجَاجًۭا","meaning":"tuzlu"},{"arabic":"فَلَوْلَا","meaning":"şüketmezmisiniz?"},{"arabic":"تَشْكُرُونَ","meaning":""}]},{"number":71,"reference":"56:71","arabic":"أَفَرَءَيْتُمُ ٱلنَّارَ ٱلَّتِى تُورُونَ","meaning":"Tutuşturduğunuz ateşi gördünüz mü?","words":[{"arabic":"أَفَرَءَيْتُمُ","meaning":"gördünüz mü?"},{"arabic":"ٱلنَّارَ","meaning":"ateşi"},{"arabic":"ٱلَّتِى","meaning":"çıkardığınız"},{"arabic":"تُورُونَ","meaning":""}]},{"number":72,"reference":"56:72","arabic":"ءَأَنتُمْ أَنشَأْتُمْ شَجَرَتَهَآ أَمْ نَحْنُ ٱلْمُنشِـُٔونَ","meaning":"Onun ağacını siz mi yarattınız yoksa yaratan biz miyiz?","words":[{"arabic":"ءَأَنتُمْ","meaning":"siz mi?"},{"arabic":"أَنشَأْتُمْ","meaning":"yarattınız"},{"arabic":"شَجَرَتَهَآ","meaning":"onun ağacını"},{"arabic":"أَمْ","meaning":"yoksa"},{"arabic":"نَحْنُ","meaning":"biz (miyiz?)"},{"arabic":"ٱلْمُنشِـُٔونَ","meaning":"yaratanlar"}]},{"number":73,"reference":"56:73","arabic":"نَحْنُ جَعَلْنَـٰهَا تَذْكِرَةً وَمَتَـٰعًا لِّلْمُقْوِينَ","meaning":"Biz onu bir ibret ve gelip geçen yolcuların istifadesi için yarattık.","words":[{"arabic":"نَحْنُ","meaning":"biz"},{"arabic":"جَعَلْنَـٰهَا","meaning":"onu yaptık"},{"arabic":"تَذْكِرَةًۭ","meaning":"bir ibret"},{"arabic":"وَمَتَـٰعًۭا","meaning":"ve bir fayda"},{"arabic":"لِّلْمُقْوِينَ","meaning":"çölden gelip geçenlere"}]},{"number":74,"reference":"56:74","arabic":"فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ","meaning":"O halde yüce Rabbinin adını tesbih et!","words":[{"arabic":"فَسَبِّحْ","meaning":"öyleyse yücelt"},{"arabic":"بِٱسْمِ","meaning":"adını"},{"arabic":"رَبِّكَ","meaning":"Rabbinin"},{"arabic":"ٱلْعَظِيمِ","meaning":"büyük"}]},{"number":75,"reference":"56:75","arabic":"۞ فَلَآ أُقْسِمُ بِمَوَٰقِعِ ٱلنُّجُومِ","meaning":"Yıldızların yerlerine yemin ederim ki!","words":[{"arabic":"۞ فَلَآ","meaning":"hayır"},{"arabic":"أُقْسِمُ","meaning":"yemin ederim"},{"arabic":"بِمَوَٰقِعِ","meaning":"yerlerine"},{"arabic":"ٱلنُّجُومِ","meaning":"yıldızların"}]},{"number":76,"reference":"56:76","arabic":"وَإِنَّهُۥ لَقَسَمٌ لَّوْ تَعْلَمُونَ عَظِيمٌ","meaning":"Şüphesiz bu, büyük bir yemindir, eğer bilirseniz.","words":[{"arabic":"وَإِنَّهُۥ","meaning":"muhakkak o"},{"arabic":"لَقَسَمٌۭ","meaning":"bir yemindir"},{"arabic":"لَّوْ","meaning":"eğer"},{"arabic":"تَعْلَمُونَ","meaning":"bilirseniz"},{"arabic":"عَظِيمٌ","meaning":"büyük"}]},{"number":77,"reference":"56:77","arabic":"إِنَّهُۥ لَقُرْءَانٌ كَرِيمٌ","meaning":"Şüphesiz bu, değerli bir Kur'an'dır.","words":[{"arabic":"إِنَّهُۥ","meaning":"elbette O"},{"arabic":"لَقُرْءَانٌۭ","meaning":"kesinlikle bir Kur'an'dır"},{"arabic":"كَرِيمٌۭ","meaning":"değerli"}]},{"number":78,"reference":"56:78","arabic":"فِى كِتَـٰبٍ مَّكْنُونٍ","meaning":"Gizli/korunmuş bir kitaptadır.","words":[{"arabic":"فِى","meaning":"bir Kitaptadır"},{"arabic":"كِتَـٰبٍۢ","meaning":""},{"arabic":"مَّكْنُونٍۢ","meaning":"saklı"}]},{"number":79,"reference":"56:79","arabic":"لَّا يَمَسُّهُۥٓ إِلَّا ٱلْمُطَهَّرُونَ","meaning":"Ona ancak temizlenenler dokunabilir.","words":[{"arabic":"لَّا","meaning":"ona dokunmaz"},{"arabic":"يَمَسُّهُۥٓ","meaning":""},{"arabic":"إِلَّا","meaning":"başkası"},{"arabic":"ٱلْمُطَهَّرُونَ","meaning":"temizlerden"}]},{"number":80,"reference":"56:80","arabic":"تَنزِيلٌ مِّن رَّبِّ ٱلْعَـٰلَمِينَ","meaning":"Alemlerin Rabbinden indirilmiştir.","words":[{"arabic":"تَنزِيلٌۭ","meaning":"indirilmiştir"},{"arabic":"مِّن","meaning":"Rabbinden"},{"arabic":"رَّبِّ","meaning":""},{"arabic":"ٱلْعَـٰلَمِينَ","meaning":"alemlerin"}]},{"number":81,"reference":"56:81","arabic":"أَفَبِهَـٰذَا ٱلْحَدِيثِ أَنتُم مُّدْهِنُونَ","meaning":"Siz bu sözü mü hor görüyorsunuz?","words":[{"arabic":"أَفَبِهَـٰذَا","meaning":"şimdi bunu mu?"},{"arabic":"ٱلْحَدِيثِ","meaning":"sözü"},{"arabic":"أَنتُم","meaning":"siz"},{"arabic":"مُّدْهِنُونَ","meaning":"küçümsüyorsunuz"}]},{"number":82,"reference":"56:82","arabic":"وَتَجْعَلُونَ رِزْقَكُمْ أَنَّكُمْ تُكَذِّبُونَ","meaning":"Onu yalanlayarak mı size verilen nimete şükür ediyorsunuz?","words":[{"arabic":"وَتَجْعَلُونَ","meaning":"ve kılıyorsunuz?"},{"arabic":"رِزْقَكُمْ","meaning":"rızkınızı"},{"arabic":"أَنَّكُمْ","meaning":"sizin"},{"arabic":"تُكَذِّبُونَ","meaning":"yalanlamanızdan (ibaret)"}]},{"number":83,"reference":"56:83","arabic":"فَلَوْلَآ إِذَا بَلَغَتِ ٱلْحُلْقُومَ","meaning":"Hele bir (ruh) boğaza gelmiş olmasın.","words":[{"arabic":"فَلَوْلَآ","meaning":"ya ?"},{"arabic":"إِذَا","meaning":"zaman"},{"arabic":"بَلَغَتِ","meaning":"(can) dayandığı"},{"arabic":"ٱلْحُلْقُومَ","meaning":"boğaza"}]},{"number":84,"reference":"56:84","arabic":"وَأَنتُمْ حِينَئِذٍ تَنظُرُونَ","meaning":"Siz, o zaman bakıp kalırsınız","words":[{"arabic":"وَأَنتُمْ","meaning":"ve siz de"},{"arabic":"حِينَئِذٍۢ","meaning":"o zaman"},{"arabic":"تَنظُرُونَ","meaning":"bakıp durursunuz"}]},{"number":85,"reference":"56:85","arabic":"وَنَحْنُ أَقْرَبُ إِلَيْهِ مِنكُمْ وَلَـٰكِن لَّا تُبْصِرُونَ","meaning":"Biz, ona sizden daha yakınız, ama göremezsiniz.","words":[{"arabic":"وَنَحْنُ","meaning":"ve biz"},{"arabic":"أَقْرَبُ","meaning":"daha yakınız"},{"arabic":"إِلَيْهِ","meaning":"ona"},{"arabic":"مِنكُمْ","meaning":"sizden"},{"arabic":"وَلَـٰكِن","meaning":"fakat"},{"arabic":"لَّا","meaning":"siz görmezsiniz"},{"arabic":"تُبْصِرُونَ","meaning":""}]},{"number":86,"reference":"56:86","arabic":"فَلَوْلَآ إِن كُنتُمْ غَيْرَ مَدِينِينَ","meaning":"Madem ki (tekrardan dirilip) ceza görmeyecekmişsiniz.","words":[{"arabic":"فَلَوْلَآ","meaning":"eğer"},{"arabic":"إِن","meaning":""},{"arabic":"كُنتُمْ","meaning":"iseniz"},{"arabic":"غَيْرَ","meaning":"cezalandırılmayacak"},{"arabic":"مَدِينِينَ","meaning":""}]},{"number":87,"reference":"56:87","arabic":"تَرْجِعُونَهَآ إِن كُنتُمْ صَـٰدِقِينَ","meaning":"Onu (ruhu) geri çeviriniz. Doğru söyleyenlerden iseniz…","words":[{"arabic":"تَرْجِعُونَهَآ","meaning":"onu geri döndürsenize"},{"arabic":"إِن","meaning":"eğer"},{"arabic":"كُنتُمْ","meaning":"iseniz"},{"arabic":"صَـٰدِقِينَ","meaning":"doğrulardan"}]},{"number":88,"reference":"56:88","arabic":"فَأَمَّآ إِن كَانَ مِنَ ٱلْمُقَرَّبِينَ","meaning":"Eğer o (ölen kişi), yakın kılınanlardan ise.","words":[{"arabic":"فَأَمَّآ","meaning":"ama"},{"arabic":"إِن","meaning":"eğer"},{"arabic":"كَانَ","meaning":"ise"},{"arabic":"مِنَ","meaning":"yaklaştırılanlardan"},{"arabic":"ٱلْمُقَرَّبِينَ","meaning":""}]},{"number":89,"reference":"56:89","arabic":"فَرَوْحٌ وَرَيْحَانٌ وَجَنَّتُ نَعِيمٍ","meaning":"Ona rahatlık, güzel rızık ve Naim Cenneti vardır.","words":[{"arabic":"فَرَوْحٌۭ","meaning":"(O'na) rahatlık (vardır)"},{"arabic":"وَرَيْحَانٌۭ","meaning":"ve güzel rızık (vardır)"},{"arabic":"وَجَنَّتُ","meaning":"ve cenneti (vardır)"},{"arabic":"نَعِيمٍۢ","meaning":"ni'met"}]},{"number":90,"reference":"56:90","arabic":"وَأَمَّآ إِن كَانَ مِنْ أَصْحَـٰبِ ٱلْيَمِينِ","meaning":"Eğer o, sağdakilerden ise.","words":[{"arabic":"وَأَمَّآ","meaning":"ama"},{"arabic":"إِن","meaning":"eğer"},{"arabic":"كَانَ","meaning":"ise"},{"arabic":"مِنْ","meaning":"ashabından"},{"arabic":"أَصْحَـٰبِ","meaning":""},{"arabic":"ٱلْيَمِينِ","meaning":"sağ"}]},{"number":91,"reference":"56:91","arabic":"فَسَلَـٰمٌ لَّكَ مِنْ أَصْحَـٰبِ ٱلْيَمِينِ","meaning":"Ey sağdaki! Sana selam olsun!","words":[{"arabic":"فَسَلَـٰمٌۭ","meaning":"selam"},{"arabic":"لَّكَ","meaning":"sana"},{"arabic":"مِنْ","meaning":"ashabından"},{"arabic":"أَصْحَـٰبِ","meaning":""},{"arabic":"ٱلْيَمِينِ","meaning":"sağ"}]},{"number":92,"reference":"56:92","arabic":"وَأَمَّآ إِن كَانَ مِنَ ٱلْمُكَذِّبِينَ ٱلضَّآلِّينَ","meaning":"Eğer o, yalanlayanlardan ve sapıklardan ise.","words":[{"arabic":"وَأَمَّآ","meaning":"ama"},{"arabic":"إِن","meaning":"eğer"},{"arabic":"كَانَ","meaning":"ise"},{"arabic":"مِنَ","meaning":"yalanlayıcılardan"},{"arabic":"ٱلْمُكَذِّبِينَ","meaning":""},{"arabic":"ٱلضَّآلِّينَ","meaning":"sapık"}]},{"number":93,"reference":"56:93","arabic":"فَنُزُلٌ مِّنْ حَمِيمٍ","meaning":"Kaynar suda bir ziyafet!","words":[{"arabic":"فَنُزُلٌۭ","meaning":"bir ziyafet"},{"arabic":"مِّنْ","meaning":"kaynar sudan"},{"arabic":"حَمِيمٍۢ","meaning":""}]},{"number":94,"reference":"56:94","arabic":"وَتَصْلِيَةُ جَحِيمٍ","meaning":"Ve cehenneme atılış.","words":[{"arabic":"وَتَصْلِيَةُ","meaning":"ve atılma (vardır)"},{"arabic":"جَحِيمٍ","meaning":"cehenneme"}]},{"number":95,"reference":"56:95","arabic":"إِنَّ هَـٰذَا لَهُوَ حَقُّ ٱلْيَقِينِ","meaning":"Bu, kesin olan hakkın ta kendisidir.","words":[{"arabic":"إِنَّ","meaning":"elbette"},{"arabic":"هَـٰذَا","meaning":"budur işte"},{"arabic":"لَهُوَ","meaning":"elbette o"},{"arabic":"حَقُّ","meaning":"gerçek"},{"arabic":"ٱلْيَقِينِ","meaning":"kesin"}]},{"number":96,"reference":"56:96","arabic":"فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ","meaning":"Öyleyse yüce Rabbinin adını tesbih et!","words":[{"arabic":"فَسَبِّحْ","meaning":"öyleyse tesbih et"},{"arabic":"بِٱسْمِ","meaning":"adını"},{"arabic":"رَبِّكَ","meaning":"Rabbinin"},{"arabic":"ٱلْعَظِيمِ","meaning":"büyük"}]}]}
