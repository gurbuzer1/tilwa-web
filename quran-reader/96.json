{"number":96,"source":"Kur’an metni ve kelime çözümlemesi: Quran.com · Türkçe meal: Shaban Britch; birleşik dört ayetin ayrımı: Dar Al-Salam Center","verses":[{"number":1,"reference":"96:1","arabic":"ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ","meaning":"Oku! Yaratan Rabbinin adıyla.","words":[{"arabic":"ٱقْرَأْ","meaning":"oku"},{"arabic":"بِٱسْمِ","meaning":"adıyle"},{"arabic":"رَبِّكَ","meaning":"Rabbinin"},{"arabic":"ٱلَّذِى","meaning":"yaratan"},{"arabic":"خَلَقَ","meaning":""}]},{"number":2,"reference":"96:2","arabic":"خَلَقَ ٱلْإِنسَـٰنَ مِنْ عَلَقٍ","meaning":"İnsanı alaktan yaratan,","words":[{"arabic":"خَلَقَ","meaning":"O yarattı"},{"arabic":"ٱلْإِنسَـٰنَ","meaning":"insanı"},{"arabic":"مِنْ","meaning":"alaktan"},{"arabic":"عَلَقٍ","meaning":""}]},{"number":3,"reference":"96:3","arabic":"ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ","meaning":"Oku! Rabbin, en büyük kerem sahibidir.","words":[{"arabic":"ٱقْرَأْ","meaning":"oku"},{"arabic":"وَرَبُّكَ","meaning":"ve Rabbin"},{"arabic":"ٱلْأَكْرَمُ","meaning":"en büyük kerem sahibidir"}]},{"number":4,"reference":"96:4","arabic":"ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ","meaning":"Kalemle öğreten…","words":[{"arabic":"ٱلَّذِى","meaning":"O ki"},{"arabic":"عَلَّمَ","meaning":"öğretti"},{"arabic":"بِٱلْقَلَمِ","meaning":"kalemle"}]},{"number":5,"reference":"96:5","arabic":"عَلَّمَ ٱلْإِنسَـٰنَ مَا لَمْ يَعْلَمْ","meaning":"İnsana bilmediğini öğretendir.","words":[{"arabic":"عَلَّمَ","meaning":"öğretti"},{"arabic":"ٱلْإِنسَـٰنَ","meaning":"insana"},{"arabic":"مَا","meaning":"şeyi"},{"arabic":"لَمْ","meaning":"bilmediği"},{"arabic":"يَعْلَمْ","meaning":""}]},{"number":6,"reference":"96:6","arabic":"كَلَّآ إِنَّ ٱلْإِنسَـٰنَ لَيَطْغَىٰٓ","meaning":"Hayır! Şüphesiz insan azgınlık eder.","words":[{"arabic":"كَلَّآ","meaning":"hayır"},{"arabic":"إِنَّ","meaning":"şüphesiz"},{"arabic":"ٱلْإِنسَـٰنَ","meaning":"insan"},{"arabic":"لَيَطْغَىٰٓ","meaning":"azar"}]},{"number":7,"reference":"96:7","arabic":"أَن رَّءَاهُ ٱسْتَغْنَىٰٓ","meaning":"Kendini 