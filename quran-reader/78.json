{"number":78,"source":"Kur’an metni ve kelime çözümlemesi: Quran.com · Türkçe meal: Shaban Britch; birleşik dört ayetin ayrımı: Dar Al-Salam Center","verses":[{"number":1,"reference":"78:1","arabic":"عَمَّ يَتَسَآءَلُونَ","meaning":"Neyi soruşturup duruyorlar?","words":[{"arabic":"عَمَّ","meaning":"hangi şeyden?"},{"arabic":"يَتَسَآءَلُونَ","meaning":"birbirlerine soruyorlar"}]},{"number":2,"reference":"78:2","arabic":"عَنِ ٱلنَّبَإِ ٱلْعَظِيمِ","meaning":"Büyük haberi mi?","words":[{"arabic":"عَنِ","meaning":"haberden (mi?)"},{"arabic":"ٱلنَّبَإِ","meaning":""},{"arabic":"ٱلْعَظِيمِ","meaning":"büyük"}]},{"number":3,"reference":"78:3","arabic":"ٱلَّذِى هُمْ فِيهِ مُخْتَلِفُونَ","meaning":"Onlar ki, hakkında ihtilaf ediyorlar.","words":[{"arabic":"ٱلَّذِى","meaning":"ki"},{"arabic":"هُمْ","meaning":"onlar"},{"arabic":"فِيهِ","meaning":"onda"},{"arabic":"مُخْتَلِفُونَ","meaning":"ayrılığa düşmektedirler"}]},{"number":4,"reference":"78:4","arabic":"كَلَّا سَيَعْلَمُونَ","meaning":"Hayır, yakında öğrenecekler.","words":[{"arabic":"كَلَّا","meaning":"hayır"},{"arabic":"سَيَعْلَمُونَ","meaning":"yakında bilecekler"}]},{"number":5,"reference":"78:5","arabic":"ثُمَّ كَلَّا سَيَعْلَمُونَ","meaning":"Sonra, Hayır! Yakında öğrenecekler.","words":[{"arabic":"ثُمَّ","meaning":"sonra"},{"arabic":"كَلَّا","meaning":"hayır"},{"arabic":"سَيَعْلَمُونَ","meaning":"yakında bilecekler"}]},{"number":6,"reference":"78:6","arabic":"أَلَمْ نَجْعَلِ ٱلْأَرْضَ مِهَـٰدًا","meaning":"Yeri bir döşek kılmadık mı?","words":[{"arabic":"أَلَمْ","meaning":"yapmadık mı?"},{"arabic":"نَجْعَلِ","meaning":""},{"arabic":"ٱلْأَرْضَ","meaning":"arzı"},{"arabic":"مِهَـٰدًۭا","meaning":"bir beşik"}]},{"number":7,"reference":"78:7","arabic":"وَٱلْجِبَالَ أَوْتَادًا","meaning":"Dağları da birer kazık.","words":[{"arabic":"وَٱلْجِبَالَ","meaning":"ve dağları"},{"arabic":"أَوْتَادًۭا","meaning":"birer kazık"}]},{"number":8,"reference":"78:8","arabic":"وَخَلَقْنَـٰكُمْ أَزْوَٰجًا","meaning":"Sizi de çift çift yarattık.","words":[{"arabic":"وَخَلَقْنَـٰكُمْ","meaning":"ve sizi yarattık"},{"arabic":"أَزْوَٰجًۭا","meaning":"çift çift"}]},{"number":9,"reference":"78:9","arabic":"وَجَعَلْنَا نَوْمَكُمْ سُبَاتًا","meaning":"Uykunuzu dinlenme kıldık.","words":[{"arabic":"وَجَعَلْنَا","meaning":"ve yaptık"},{"arabic":"نَوْمَكُمْ","meaning":"uykunuzu"},{"arabic":"سُبَاتًۭا","meaning":"dinlenme"}]},{"number":10,"reference":"78:10","arabic":"وَجَعَلْنَا ٱلَّيْلَ لِبَاسًا","meaning":"Geceyi örtü kıldık.","words":[{"arabic":"وَجَعَلْنَا","meaning":"ve yaptık"},{"arabic":"ٱلَّيْلَ","meaning":"geceyi"},{"arabic":"لِبَاسًۭا","meaning":"bir giysi"}]},{"number":11,"reference":"78:11","arabic":"وَجَعَلْنَا ٱلنَّهَارَ مَعَاشًا","meaning":"Gündüzü de geçimlik kıldık.","words":[{"arabic":"وَجَعَلْنَا","meaning":"ve yaptık"},{"arabic":"ٱلنَّهَارَ","meaning":"gündüzü"},{"arabic":"مَعَاشًۭا","meaning":"geçim zamanı"}]},{"number":12,"reference":"78:12","arabic":"وَبَنَيْنَا فَوْقَكُمْ سَبْعًا شِدَادًا","meaning":"Üstünüze de sapasağlam yedi kat bina ettik.","words":[{"arabic":"وَبَنَيْنَا","meaning":"ve bina ettik"},{"arabic":"فَوْقَكُمْ","meaning":"üstünüzde"},{"arabic":"سَبْعًۭا","meaning":"yedi (gök)"},{"arabic":"شِدَادًۭا","meaning":"sağlam"}]},{"number":13,"reference":"78:13","arabic":"وَجَعَلْنَا سِرَاجًا وَهَّاجًا","meaning":"Işık saçan bir de lamba yarattık.","words":[{"arabic":"وَجَعَلْنَا","meaning":"ve yarattık"},{"arabic":"سِرَاجًۭا","meaning":"bir lamba"},{"arabic":"وَهَّاجًۭا","meaning":"parıl parıl parlayan"}]},{"number":14,"reference":"78:14","arabic":"وَأَنزَلْنَا مِنَ ٱلْمُعْصِرَٰتِ مَآءً ثَجَّاجًا","meaning":"Ve o sıkıştıranlardan/bulutlardan şarıl şarıl bir su indirdik.","words":[{"arabic":"وَأَنزَلْنَا","meaning":"ve indirdik"},{"arabic":"مِنَ","meaning":"sıkışan(bulut)lardan"},{"arabic":"ٱلْمُعْصِرَٰتِ","meaning":""},{"arabic":"مَآءًۭ","meaning":"su"},{"arabic":"ثَجَّاجًۭا","meaning":"şarıl şarıl"}]},{"number":15,"reference":"78:15","arabic":"لِّنُخْرِجَ بِهِۦ حَبًّا وَنَبَاتًا","meaning":"Onunla taneler ve bitkiler çıkaralım diye.","words":[{"arabic":"لِّنُخْرِجَ","meaning":"çıkaralım diye"},{"arabic":"بِهِۦ","meaning":"onunla"},{"arabic":"حَبًّۭا","meaning":"dane(ler)"},{"arabic":"وَنَبَاتًۭا","meaning":"ve bitki(ler)"}]},{"number":16,"reference":"78:16","arabic":"وَجَنَّـٰتٍ أَلْفَافًا","meaning":"Ve birbirine girmiş sarmaş dolaş bahçeler...","words":[{"arabic":"وَجَنَّـٰتٍ","meaning":"ve bahçeler"},{"arabic":"أَلْفَافًا","meaning":"birbirine sarmaş dolaş"}]},{"number":17,"reference":"78:17","arabic":"إِنَّ يَوْمَ ٱلْفَصْلِ كَانَ مِيقَـٰتًا","meaning":"Ayırım/fasl günü belirlenmiş bir vakittir.","words":[{"arabic":"إِنَّ","meaning":"muhakkak ki"},{"arabic":"يَوْمَ","meaning":"günü"},{"arabic":"ٱلْفَصْلِ","meaning":"hüküm"},{"arabic":"كَانَ","meaning":"belirlenmiş bir vakittir"},{"arabic":"مِيقَـٰتًۭا","meaning":""}]},{"number":18,"reference":"78:18","arabic":"يَوْمَ يُنفَخُ فِى ٱلصُّورِ فَتَأْتُونَ أَفْوَاجًا","meaning":"Sur’a üflendiği gün bölük bölük geleceksiniz.","words":[{"arabic":"يَوْمَ","meaning":"o gün"},{"arabic":"يُنفَخُ","meaning":"üflenir"},{"arabic":"فِى","meaning":"Sur'a"},{"arabic":"ٱلصُّورِ","meaning":""},{"arabic":"فَتَأْتُونَ","meaning":"gelirsiniz"},{"arabic":"أَفْوَاجًۭا","meaning":"bölük bölük"}]},{"number":19,"reference":"78:19","arabic":"وَفُتِحَتِ ٱلسَّمَآءُ فَكَانَتْ أَبْوَٰبًا","meaning":"(O gün) gök açılıp, kapı kapı olmuştur.","words":[{"arabic":"وَفُتِحَتِ","meaning":"ve açılmıştır"},{"arabic":"ٱلسَّمَآءُ","meaning":"gök"},{"arabic":"فَكَانَتْ","meaning":"ve olmuştur"},{"arabic":"أَبْوَٰبًۭا","meaning":"kapı kapı"}]},{"number":20,"reference":"78:20","arabic":"وَسُيِّرَتِ ٱلْجِبَالُ فَكَانَتْ سَرَابًا","meaning":"Dağlar yürütülüp, serap olmuştur.","words":[{"arabic":"وَسُيِّرَتِ","meaning":"ve yürütülmüştür"},{"arabic":"ٱلْجِبَالُ","meaning":"dağlar"},{"arabic":"فَكَانَتْ","meaning":"olmuştur"},{"arabic":"سَرَابًا","meaning":"bir serab"}]},{"number":21,"reference":"78:21","arabic":"إِنَّ جَهَنَّمَ كَانَتْ مِرْصَادًا","meaning":"Cehennem de gözlemektedir.","words":[{"arabic":"إِنَّ","meaning":"şüphesiz"},{"arabic":"جَهَنَّمَ","meaning":"cehennem"},{"arabic":"كَانَتْ","meaning":"olmuştur"},{"arabic":"مِرْصَادًۭا","meaning":"gözetleme yeri"}]},{"number":22,"reference":"78:22","arabic":"لِّلطَّـٰغِينَ مَـَٔابًا","meaning":"Azgınların varacağı sığınak,","words":[{"arabic":"لِّلطَّـٰغِينَ","meaning":"azgınların"},{"arabic":"مَـَٔابًۭا","meaning":"varacağı yerdir"}]},{"number":23,"reference":"78:23","arabic":"لَّـٰبِثِينَ فِيهَآ أَحْقَابًا","meaning":"Orada çağlar boyu kalacaklardır.","words":[{"arabic":"لَّـٰبِثِينَ","meaning":"kalacaklardır"},{"arabic":"فِيهَآ","meaning":"orada"},{"arabic":"أَحْقَابًۭا","meaning":"çağlar boyu"}]},{"number":24,"reference":"78:24","arabic":"لَّا يَذُوقُونَ فِيهَا بَرْدًا وَلَا شَرَابًا","meaning":"Orada ne serinlik tadacaklar, ne de bir içecek.","words":[{"arabic":"لَّا","meaning":"tadmazlar"},{"arabic":"يَذُوقُونَ","meaning":""},{"arabic":"فِيهَا","meaning":"orada"},{"arabic":"بَرْدًۭا","meaning":"bir serinlik"},{"arabic":"وَلَا","meaning":"ve ne de"},{"arabic":"شَرَابًا","meaning":"içilecek bir şey"}]},{"number":25,"reference":"78:25","arabic":"إِلَّا حَمِيمًا وَغَسَّاقًا","meaning":"Kaynar su ve irinden başka...","words":[{"arabic":"إِلَّا","meaning":"yalnız (içerler)"},{"arabic":"حَمِيمًۭا","meaning":"kaynar su"},{"arabic":"وَغَسَّاقًۭا","meaning":"ve irin"}]},{"number":26,"reference":"78:26","arabic":"جَزَآءً وِفَاقًا","meaning":"Uygun bir ceza!","words":[{"arabic":"جَزَآءًۭ","meaning":"bir ceza olarak"},{"arabic":"وِفَاقًا","meaning":"uygun"}]},{"number":27,"reference":"78:27","arabic":"إِنَّهُمْ كَانُوا۟ لَا يَرْجُونَ حِسَابًا","meaning":"Çünkü onlar, hesabı ummuyorlardı.","words":[{"arabic":"إِنَّهُمْ","meaning":"çünkü onlar"},{"arabic":"كَانُوا۟","meaning":"idiler"},{"arabic":"لَا","meaning":"ummuyor(lar)"},{"arabic":"يَرْجُونَ","meaning":""},{"arabic":"حِسَابًۭا","meaning":"bir hesap"}]},{"number":28,"reference":"78:28","arabic":"وَكَذَّبُوا۟ بِـَٔايَـٰتِنَا كِذَّابًا","meaning":"Ayetlerimizi yalanladıkça yalanlamışlardı.","words":[{"arabic":"وَكَذَّبُوا۟","meaning":"ve yalanlamışlardı"},{"arabic":"بِـَٔايَـٰتِنَا","meaning":"ayetlerimizi"},{"arabic":"كِذَّابًۭا","meaning":"tekzib ile"}]},{"number":29,"reference":"78:29","arabic":"وَكُلَّ شَىْءٍ أَحْصَيْنَـٰهُ كِتَـٰبًا","meaning":"Her şeyi bir kitapta sayıp yazmışızdır.","words":[{"arabic":"وَكُلَّ","meaning":"ve her"},{"arabic":"شَىْءٍ","meaning":"şeyi"},{"arabic":"أَحْصَيْنَـٰهُ","meaning":"saymıştık"},{"arabic":"كِتَـٰبًۭا","meaning":"yazmıştık"}]},{"number":30,"reference":"78:30","arabic":"فَذُوقُوا۟ فَلَن نَّزِيدَكُمْ إِلَّا عَذَابًا","meaning":"İşte, tadına bakın, size azaptan başka bir şey artırmayacağız.","words":[{"arabic":"فَذُوقُوا۟","meaning":"şimdi tadın"},{"arabic":"فَلَن","meaning":"artık asla"},{"arabic":"نَّزِيدَكُمْ","meaning":"size artırmayacağız"},{"arabic":"إِلَّا","meaning":"başka bir şey"},{"arabic":"عَذَابًا","meaning":"azabdan"}]},{"number":31,"reference":"78:31","arabic":"إِنَّ لِلْمُتَّقِينَ مَفَازًا","meaning":"Muttakiler için kurtuluş...","words":[{"arabic":"إِنَّ","meaning":"şüphesiz"},{"arabic":"لِلْمُتَّقِينَ","meaning":"muttakiler için vardır"},{"arabic":"مَفَازًا","meaning":"başarı ödülü"}]},{"number":32,"reference":"78:32","arabic":"حَدَآئِقَ وَأَعْنَـٰبًا","meaning":"Bahçeler ve bağlar,","words":[{"arabic":"حَدَآئِقَ","meaning":"bahçeler"},{"arabic":"وَأَعْنَـٰبًۭا","meaning":"ve bağlar"}]},{"number":33,"reference":"78:33","arabic":"وَكَوَاعِبَ أَتْرَابًا","meaning":"Göğüsleri olgun, yaşıt kızlar,","words":[{"arabic":"وَكَوَاعِبَ","meaning":"ve göğüsleri tomurcuklanmış"},{"arabic":"أَتْرَابًۭا","meaning":"yaşıt kızlar"}]},{"number":34,"reference":"78:34","arabic":"وَكَأْسًا دِهَاقًا","meaning":"Dolu dolu kadehler.","words":[{"arabic":"وَكَأْسًۭا","meaning":"ve kadeh(ler)"},{"arabic":"دِهَاقًۭا","meaning":"dolu"}]},{"number":35,"reference":"78:35","arabic":"لَّا يَسْمَعُونَ فِيهَا لَغْوًا وَلَا كِذَّٰبًا","meaning":"Orada boş ve yalan söz işitmezler.","words":[{"arabic":"لَّا","meaning":"işitmezler"},{"arabic":"يَسْمَعُونَ","meaning":""},{"arabic":"فِيهَا","meaning":"orada"},{"arabic":"لَغْوًۭا","meaning":"boş söz"},{"arabic":"وَلَا","meaning":"ve ne de"},{"arabic":"كِذَّٰبًۭا","meaning":"yalan"}]},{"number":36,"reference":"78:36","arabic":"جَزَآءً مِّن رَّبِّكَ عَطَآءً حِسَابًا","meaning":"(Bunlar) Rabbinden bir karşılık, bol bir bağıştır.","words":[{"arabic":"جَزَآءًۭ","meaning":"bir karşılık"},{"arabic":"مِّن","meaning":"Rabbinden"},{"arabic":"رَّبِّكَ","meaning":""},{"arabic":"عَطَآءً","meaning":"bir bağış olarak"},{"arabic":"حِسَابًۭا","meaning":"yeterli"}]},{"number":37,"reference":"78:37","arabic":"رَّبِّ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَا ٱلرَّحْمَـٰنِ ۖ لَا يَمْلِكُونَ مِنْهُ خِطَابًا","meaning":"(Bunlar) göklerin, yerin ve ikisi arasında bulunanların Rabbindendir. O, Rahman'dır. Ona hitap etmeye güç yetiremezler.","words":[{"arabic":"رَّبِّ","meaning":"Rabbi"},{"arabic":"ٱلسَّمَـٰوَٰتِ","meaning":"göklerin"},{"arabic":"وَٱلْأَرْضِ","meaning":"ve yerin"},{"arabic":"وَمَا","meaning":"ve bulunanların"},{"arabic":"بَيْنَهُمَا","meaning":"ikisi arasında"},{"arabic":"ٱلرَّحْمَـٰنِ ۖ","meaning":"çok merhametli"},{"arabic":"لَا","meaning":"güçleri yetmez"},{"arabic":"يَمْلِكُونَ","meaning":""},{"arabic":"مِنْهُ","meaning":"O'nun huzurunda"},{"arabic":"خِطَابًۭا","meaning":"konuşmaya"}]},{"number":38,"reference":"78:38","arabic":"يَوْمَ يَقُومُ ٱلرُّوحُ وَٱلْمَلَـٰٓئِكَةُ صَفًّا ۖ لَّا يَتَكَلَّمُونَ إِلَّا مَنْ أَذِنَ لَهُ ٱلرَّحْمَـٰنُ وَقَالَ صَوَابًا","meaning":"Ruh/Cebrail ve meleklerin saf halinde durdukları gün, ancak Rahman’ın kendisine izin verdiği konuşabilir. O da doğruyu konuşur.","words":[{"arabic":"يَوْمَ","meaning":"o gün"},{"arabic":"يَقُومُ","meaning":"dururlar"},{"arabic":"ٱلرُّوحُ","meaning":"Ruh"},{"arabic":"وَٱلْمَلَـٰٓئِكَةُ","meaning":"ve melekler"},{"arabic":"صَفًّۭا ۖ","meaning":"sıra sıra"},{"arabic":"لَّا","meaning":"konuşamaz"},{"arabic":"يَتَكَلَّمُونَ","meaning":""},{"arabic":"إِلَّا","meaning":"dışındakiler"},{"arabic":"مَنْ","meaning":"kimseler"},{"arabic":"أَذِنَ","meaning":"izin verdiği"},{"arabic":"لَهُ","meaning":"kendisine"},{"arabic":"ٱلرَّحْمَـٰنُ","meaning":"Rahman'ın"},{"arabic":"وَقَالَ","meaning":"ve o da söyler"},{"arabic":"صَوَابًۭا","meaning":"doğruyu"}]},{"number":39,"reference":"78:39","arabic":"ذَٰلِكَ ٱلْيَوْمُ ٱلْحَقُّ ۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ مَـَٔابًا","meaning":"İşte bu, hak olan gündür. Dileyen Rabbine dönüş yolu tutar.","words":[{"arabic":"ذَٰلِكَ","meaning":"işte bu"},{"arabic":"ٱلْيَوْمُ","meaning":"günüdür"},{"arabic":"ٱلْحَقُّ ۖ","meaning":"hak"},{"arabic":"فَمَن","meaning":"artık kimse"},{"arabic":"شَآءَ","meaning":"dileyen"},{"arabic":"ٱتَّخَذَ","meaning":"tutar"},{"arabic":"إِلَىٰ","meaning":"varan"},{"arabic":"رَبِّهِۦ","meaning":"Rabbine"},{"arabic":"مَـَٔابًا","meaning":"bir yol"}]},{"number":40,"reference":"78:40","arabic":"إِنَّآ أَنذَرْنَـٰكُمْ عَذَابًا قَرِيبًا يَوْمَ يَنظُرُ ٱلْمَرْءُ مَا قَدَّمَتْ يَدَاهُ وَيَقُولُ ٱلْكَافِرُ يَـٰلَيْتَنِى كُنتُ تُرَٰبًۢا","meaning":"Biz, sizi yakın bir azap ile uyardık. Kişi o gün, elleri ile ne sunduğuna bakar. Kâfir olan da: \"Keşke toprak olsaydım!\" der.","words":[{"arabic":"إِنَّآ","meaning":"elbette biz"},{"arabic":"أَنذَرْنَـٰكُمْ","meaning":"siz uyardık"},{"arabic":"عَذَابًۭا","meaning":"bir azab ile"},{"arabic":"قَرِيبًۭا","meaning":"yakın"},{"arabic":"يَوْمَ","meaning":"o gün"},{"arabic":"يَنظُرُ","meaning":"bakar"},{"arabic":"ٱلْمَرْءُ","meaning":"kişi"},{"arabic":"مَا","meaning":"işlere"},{"arabic":"قَدَّمَتْ","meaning":"öne sürdüğü"},{"arabic":"يَدَاهُ","meaning":"ellerinin"},{"arabic":"وَيَقُولُ","meaning":"ve der"},{"arabic":"ٱلْكَافِرُ","meaning":"kafir"},{"arabic":"يَـٰلَيْتَنِى","meaning":"ey keşke"},{"arabic":"كُنتُ","meaning":"ben olsaydım"},{"arabic":"تُرَٰبًۢا","meaning":"toprak"}]}]}
