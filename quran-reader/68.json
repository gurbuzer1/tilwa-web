{"number":68,"source":"Kur’an metni ve kelime çözümlemesi: Quran.com · Türkçe meal: Shaban Britch; birleşik dört ayetin ayrımı: Dar Al-Salam Center","verses":[{"number":1,"reference":"68:1","arabic":"نٓ ۚ وَٱلْقَلَمِ وَمَا يَسْطُرُونَ","meaning":"Nûn, kaleme ve (onunla) yazdıklarına yemin olsun.","words":[{"arabic":"نٓ ۚ","meaning":"Nun"},{"arabic":"وَٱلْقَلَمِ","meaning":"kaleme andolsun"},{"arabic":"وَمَا","meaning":"ve"},{"arabic":"يَسْطُرُونَ","meaning":"yazdıklarına"}]},{"number":2,"reference":"68:2","arabic":"مَآ أَنتَ بِنِعْمَةِ رَبِّكَ بِمَجْنُونٍ","meaning":"Sen Rabbinin nimeti sayesinde cinlenmiş değilsin.","words":[{"arabic":"مَآ","meaning":"değilsin"},{"arabic":"أَنتَ","meaning":"sen"},{"arabic":"بِنِعْمَةِ","meaning":"ni'metiyle"},{"arabic":"رَبِّكَ","meaning":"Rabbinin"},{"arabic":"بِمَجْنُونٍۢ","meaning":"cinlenmiş (deli)"}]},{"number":3,"reference":"68:3","arabic":"وَإِنَّ لَكَ لَأَجْرًا غَيْرَ مَمْنُونٍ","meaning":"Senin için tükenmez bir ecir vardır.","words":[{"arabic":"وَإِنَّ","meaning":"ve şüphesiz"},{"arabic":"لَكَ","meaning":"senin için vardır"},{"arabic":"لَأَجْرًا","meaning":"bir mükafat"},{"arabic":"غَيْرَ","meaning":"olmayan"},{"arabic":"مَمْنُونٍۢ","meaning":"kesintisi"}]},{"number":4,"reference":"68:4","arabic":"وَإِنَّكَ لَعَلَىٰ خُلُقٍ عَظِيمٍ","meaning":"Sen, büyük bir ahlak üzeresin.","words":[{"arabic":"وَإِنَّكَ","meaning":"ve şüphesiz sen"},{"arabic":"لَعَلَىٰ","meaning":"üzerindesin"},{"arabic":"خُلُقٍ","meaning":"bir ahlak"},{"arabic":"عَظِيمٍۢ","meaning":"büyük"}]},{"number":5,"reference":"68:5","arabic":"فَسَتُبْصِرُ وَيُبْصِرُونَ","meaning":"Sen de göreceksin, onlar da görecekler.","words":[{"arabic":"فَسَتُبْصِرُ","meaning":"göreceksin"},{"arabic":"وَيُبْصِرُونَ","meaning":"onlar da görecekler"}]},{"number":6,"reference":"68:6","arabic":"بِأَييِّكُمُ ٱلْمَفْتُونُ","meaning":"Hanginizin deli olduğunu…","words":[{"arabic":"بِأَييِّكُمُ","meaning":"hanginiz"},{"arabic":"ٱلْمَفْتُونُ","meaning":"fitnelenmiştir"}]},{"number":7,"reference":"68:7","arabic":"إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِمَن ضَلَّ عَن سَبِيلِهِۦ وَهُوَ أَعْلَمُ بِٱلْمُهْتَدِينَ","meaning":"Doğrusu Rabbin, kendi yolundan sapan kişiyi en iyi bilendir, hidayete erenleri de en iyi bilen O'dur.","words":[{"arabic":"إِنَّ","meaning":"şüphesiz"},{"arabic":"رَبَّكَ","meaning":"Rabbin"},{"arabic":"هُوَ","meaning":"O'dur"},{"arabic":"أَعْلَمُ","meaning":"en iyi bilen"},{"arabic":"بِمَن","meaning":"kim(ler)"},{"arabic":"ضَلَّ","meaning":"sapmıştır"},{"arabic":"عَن","meaning":"kendi yolundan"},{"arabic":"سَبِيلِهِۦ","meaning":""},{"arabic":"وَهُوَ","meaning":"ve O'dur"},{"arabic":"أَعْلَمُ","meaning":"en iyi bilen"},{"arabic":"بِٱلْمُهْتَدِينَ","meaning":"doğru yoldadır"}]},{"number":8,"reference":"68:8","arabic":"فَلَا تُطِعِ ٱلْمُكَذِّبِينَ","meaning":"Sakın yalanlayanlara itaat etme!","words":[{"arabic":"فَلَا","meaning":"öyleyse"},{"arabic":"تُطِعِ","meaning":"ita'at etme"},{"arabic":"ٱلْمُكَذِّبِينَ","meaning":"yalanlayanlara"}]},{"number":9,"reference":"68:9","arabic":"وَدُّوا۟ لَوْ تُدْهِنُ فَيُدْهِنُونَ","meaning":"Onlar ister ki, sen müsamaha gösterip, yumuşak davranasın da onlar da sana yumuşak davransınlar.","words":[{"arabic":"وَدُّوا۟","meaning":"istediler ki"},{"arabic":"لَوْ","meaning":"keşke"},{"arabic":"تُدْهِنُ","meaning":"sen yağcılık yapasın"},{"arabic":"فَيُدْهِنُونَ","meaning":"onlar da yağcılık yapsınlar"}]},{"number":10,"reference":"68:10","arabic":"وَلَا تُطِعْ كُلَّ حَلَّافٍ مَّهِينٍ","meaning":"Yemin edip duran alçağa itaat etme!","words":[{"arabic":"وَلَا","meaning":"ve"},{"arabic":"تُطِعْ","meaning":"ita'at etme"},{"arabic":"كُلَّ","meaning":"hiçbirine"},{"arabic":"حَلَّافٍۢ","meaning":"yemin edip duran"},{"arabic":"مَّهِينٍ","meaning":"aşağılık"}]},{"number":11,"reference":"68:11","arabic":"هَمَّازٍ مَّشَّآءٍۭ بِنَمِيمٍ","meaning":"Ayıp arayana ve laf götürüp getirene.","words":[{"arabic":"هَمَّازٍۢ","meaning":"kötüleyip duran"},{"arabic":"مَّشَّآءٍۭ","meaning":"götürüp getiren"},{"arabic":"بِنَمِيمٍۢ","meaning":"söz"}]},{"number":12,"reference":"68:12","arabic":"مَّنَّاعٍ لِّلْخَيْرِ مُعْتَدٍ أَثِيمٍ","meaning":"İyiliği engelleyene, mütecaviz ve saldırgan günahkâra.","words":[{"arabic":"مَّنَّاعٍۢ","meaning":"engel olan"},{"arabic":"لِّلْخَيْرِ","meaning":"hayra"},{"arabic":"مُعْتَدٍ","meaning":"saldırgan"},{"arabic":"أَثِيمٍ","meaning":"günahkar"}]},{"number":13,"reference":"68:13","arabic":"عُتُلٍّۭ بَعْدَ ذَٰلِكَ زَنِيمٍ","meaning":"Kabaya, sonra da soysuza.","words":[{"arabic":"عُتُلٍّۭ","meaning":"kaba"},{"arabic":"بَعْدَ","meaning":"sonra da"},{"arabic":"ذَٰلِكَ","meaning":"bundan"},{"arabic":"زَنِيمٍ","meaning":"kötülükle damgalı"}]},{"number":14,"reference":"68:14","arabic":"أَن كَانَ ذَا مَالٍ وَبَنِينَ","meaning":"Mal ve oğul sahibi olması sebebiyle.","words":[{"arabic":"أَن","meaning":"diye"},{"arabic":"كَانَ","meaning":"olmuş"},{"arabic":"ذَا","meaning":"sahibi"},{"arabic":"مَالٍۢ","meaning":"mal"},{"arabic":"وَبَنِينَ","meaning":"ve oğullar"}]},{"number":15,"reference":"68:15","arabic":"إِذَا تُتْلَىٰ عَلَيْهِ ءَايَـٰتُنَا قَالَ أَسَـٰطِيرُ ٱلْأَوَّلِينَ","meaning":"Ona ayetlerimiz okunduğu zaman: \"Eskilerin masalları\" der.","words":[{"arabic":"إِذَا","meaning":"zaman"},{"arabic":"تُتْلَىٰ","meaning":"okunduğu"},{"arabic":"عَلَيْهِ","meaning":"kendisine"},{"arabic":"ءَايَـٰتُنَا","meaning":"ayetlerimiz"},{"arabic":"قَالَ","meaning":"der"},{"arabic":"أَسَـٰطِيرُ","meaning":"masallarıdır"},{"arabic":"ٱلْأَوَّلِينَ","meaning":"eskilerin"}]},{"number":16,"reference":"68:16","arabic":"سَنَسِمُهُۥ عَلَى ٱلْخُرْطُومِ","meaning":"Yakında biz onun burnu üzerine damga vuracağız.","words":[{"arabic":"سَنَسِمُهُۥ","meaning":"biz onu damgalayacağız"},{"arabic":"عَلَى","meaning":"üzerini"},{"arabic":"ٱلْخُرْطُومِ","meaning":"burnunun"}]},{"number":17,"reference":"68:17","arabic":"إِنَّا بَلَوْنَـٰهُمْ كَمَا بَلَوْنَآ أَصْحَـٰبَ ٱلْجَنَّةِ إِذْ أَقْسَمُوا۟ لَيَصْرِمُنَّهَا مُصْبِحِينَ","meaning":"Biz onları, sabahleyin meyvelerini toplamaya yemin eden bahçe sahiplerini denediğimiz gibi denedik.","words":[{"arabic":"إِنَّا","meaning":"elbette biz"},{"arabic":"بَلَوْنَـٰهُمْ","meaning":"bunlara da bela verdik"},{"arabic":"كَمَا","meaning":"gibi"},{"arabic":"بَلَوْنَآ","meaning":"bela verdiğimiz"},{"arabic":"أَصْحَـٰبَ","meaning":"sahiplerine"},{"arabic":"ٱلْجَنَّةِ","meaning":"bahçe"},{"arabic":"إِذْ","meaning":"hani"},{"arabic":"أَقْسَمُوا۟","meaning":"onlar yemin etmişlerdi"},{"arabic":"لَيَصْرِمُنَّهَا","meaning":"bahçeyi mutlaka devşireceklerine"},{"arabic":"مُصْبِحِينَ","meaning":"sabah olunca"}]},{"number":18,"reference":"68:18","arabic":"وَلَا يَسْتَثْنُونَ","meaning":"(İnşaallah diyerek, yeminlerinde) istisnâ da yapmıyorlardı.","words":[{"arabic":"وَلَا","meaning":"ve"},{"arabic":"يَسْتَثْنُونَ","meaning":"istisna da etmiyorlardı"}]},{"number":19,"reference":"68:19","arabic":"فَطَافَ عَلَيْهَا طَآئِفٌ مِّن رَّبِّكَ وَهُمْ نَآئِمُونَ","meaning":"Onlar uyurken, Rabbin tarafından bir kuşatıcı (ateş) bahçeyi sarıverdi.","words":[{"arabic":"فَطَافَ","meaning":"fakat sardı"},{"arabic":"عَلَيْهَا","meaning":"onu"},{"arabic":"طَآئِفٌۭ","meaning":"dolaşıcı bir bela"},{"arabic":"مِّن","meaning":"Rabbinden"},{"arabic":"رَّبِّكَ","meaning":""},{"arabic":"وَهُمْ","meaning":"ve onlar"},{"arabic":"نَآئِمُونَ","meaning":"uyurlarken"}]},{"number":20,"reference":"68:20","arabic":"فَأَصْبَحَتْ كَٱلصَّرِيمِ","meaning":"Ve bahçe kapkara kesildi.","words":[{"arabic":"فَأَصْبَحَتْ","meaning":"(bahçe) kesiliverdi"},{"arabic":"كَٱلصَّرِيمِ","meaning":"simsiyah"}]},{"number":21,"reference":"68:21","arabic":"فَتَنَادَوْا۟ مُصْبِحِينَ","meaning":"Sabahleyin birbirlerine seslendiler:","words":[{"arabic":"فَتَنَادَوْا۟","meaning":"birbirlerine seslendiler"},{"arabic":"مُصْبِحِينَ","meaning":"sabahleyin"}]},{"number":22,"reference":"68:22","arabic":"أَنِ ٱغْدُوا۟ عَلَىٰ حَرْثِكُمْ إِن كُنتُمْ صَـٰرِمِينَ","meaning":"Mahsulü toplayacaksanız, erkenden yola çıkın!","words":[{"arabic":"أَنِ","meaning":"diye"},{"arabic":"ٱغْدُوا۟","meaning":"erkenden gidin"},{"arabic":"عَلَىٰ","meaning":"ekininize"},{"arabic":"حَرْثِكُمْ","meaning":""},{"arabic":"إِن","meaning":"eğer"},{"arabic":"كُنتُمْ","meaning":"devşirecekseniz"},{"arabic":"صَـٰرِمِينَ","meaning":""}]},{"number":23,"reference":"68:23","arabic":"فَٱنطَلَقُوا۟ وَهُمْ يَتَخَـٰفَتُونَ","meaning":"Diye gizlice konuşarak yola düştüler.","words":[{"arabic":"فَٱنطَلَقُوا۟","meaning":"derken yürüdüler"},{"arabic":"وَهُمْ","meaning":"ve onlar"},{"arabic":"يَتَخَـٰفَتُونَ","meaning":"fısıldaşıyorlardı"}]},{"number":24,"reference":"68:24","arabic":"أَن لَّا يَدْخُلَنَّهَا ٱلْيَوْمَ عَلَيْكُم مِّسْكِينٌ","meaning":"Sakın bugün hiçbir yoksul oraya yanınıza girmesin, diyerek.","words":[{"arabic":"أَن","meaning":"diye"},{"arabic":"لَّا","meaning":"sakın sokulmasın"},{"arabic":"يَدْخُلَنَّهَا","meaning":""},{"arabic":"ٱلْيَوْمَ","meaning":"bugün"},{"arabic":"عَلَيْكُم","meaning":"yanınıza"},{"arabic":"مِّسْكِينٌۭ","meaning":"hiçbir yoksul"}]},{"number":25,"reference":"68:25","arabic":"وَغَدَوْا۟ عَلَىٰ حَرْدٍ قَـٰدِرِينَ","meaning":"(Zanlarınca yoksulları) Engellemeye güç yetirenler olarak erkenden gittiler.","words":[{"arabic":"وَغَدَوْا۟","meaning":"ve erkenden gittiler"},{"arabic":"عَلَىٰ","meaning":"engellemeye"},{"arabic":"حَرْدٍۢ","meaning":""},{"arabic":"قَـٰدِرِينَ","meaning":"güçleri yettiği halde"}]},{"number":26,"reference":"68:26","arabic":"فَلَمَّا رَأَوْهَا قَالُوٓا۟ إِنَّا لَضَآلُّونَ","meaning":"Onu gördüklerinde: Yolu şaşırdık, dediler.","words":[{"arabic":"فَلَمَّا","meaning":"fakat"},{"arabic":"رَأَوْهَا","meaning":"bahçeyi görünce"},{"arabic":"قَالُوٓا۟","meaning":"dediler"},{"arabic":"إِنَّا","meaning":"elbette biz"},{"arabic":"لَضَآلُّونَ","meaning":"biz (yolu) şaşırdık"}]},{"number":27,"reference":"68:27","arabic":"بَلْ نَحْنُ مَحْرُومُونَ","meaning":"Hayır! Biz mahrum bırakıldık.","words":[{"arabic":"بَلْ","meaning":"hayır"},{"arabic":"نَحْنُ","meaning":"biz"},{"arabic":"مَحْرُومُونَ","meaning":"mahrum bırakıldık"}]},{"number":28,"reference":"68:28","arabic":"قَالَ أَوْسَطُهُمْ أَلَمْ أَقُل لَّكُمْ لَوْلَا تُسَبِّحُونَ","meaning":"Onların en insaflı olanı: \"Ben size (Allah’ı) tesbih etmemiz gerekmez mi, dememiş miydim?\" dedi.","words":[{"arabic":"قَالَ","meaning":"dedi"},{"arabic":"أَوْسَطُهُمْ","meaning":"orta yol üzere olanları"},{"arabic":"أَلَمْ","meaning":"ben demedim mi?"},{"arabic":"أَقُل","meaning":""},{"arabic":"لَّكُمْ","meaning":"size"},{"arabic":"لَوْلَا","meaning":"gerekmez miydi?"},{"arabic":"تُسَبِّحُونَ","meaning":"tesbih etmeniz"}]},{"number":29,"reference":"68:29","arabic":"قَالُوا۟ سُبْحَـٰنَ رَبِّنَآ إِنَّا كُنَّا ظَـٰلِمِينَ","meaning":"Rabbimizi tesbih ederiz; doğrusu biz (kendi kendimize) zulmedenlerdenmişiz dediler.","words":[{"arabic":"قَالُوا۟","meaning":"dediler"},{"arabic":"سُبْحَـٰنَ","meaning":"tesbih ederiz"},{"arabic":"رَبِّنَآ","meaning":"Rabbimizi"},{"arabic":"إِنَّا","meaning":"doğrusu biz"},{"arabic":"كُنَّا","meaning":"zulmedenlermişiz"},{"arabic":"ظَـٰلِمِينَ","meaning":""}]},{"number":30,"reference":"68:30","arabic":"فَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍ يَتَلَـٰوَمُونَ","meaning":"Başladılar birbirlerini kınamaya.","words":[{"arabic":"فَأَقْبَلَ","meaning":"dönüp başladılar"},{"arabic":"بَعْضُهُمْ","meaning":"bir kısmı"},{"arabic":"عَلَىٰ","meaning":"diğerini"},{"arabic":"بَعْضٍۢ","meaning":""},{"arabic":"يَتَلَـٰوَمُونَ","meaning":"kınamağa"}]},{"number":31,"reference":"68:31","arabic":"قَالُوا۟ يَـٰوَيْلَنَآ إِنَّا كُنَّا طَـٰغِينَ","meaning":"Yazıklar olsun bize, azgınlardan olduk, dediler.","words":[{"arabic":"قَالُوا۟","meaning":"dediler"},{"arabic":"يَـٰوَيْلَنَآ","meaning":"ey yazık bize"},{"arabic":"إِنَّا","meaning":"elbette biz"},{"arabic":"كُنَّا","meaning":"azgınlarmışız"},{"arabic":"طَـٰغِينَ","meaning":""}]},{"number":32,"reference":"68:32","arabic":"عَسَىٰ رَبُّنَآ أَن يُبْدِلَنَا خَيْرًا مِّنْهَآ إِنَّآ إِلَىٰ رَبِّنَا رَٰغِبُونَ","meaning":"Belki Rabbimiz bize bundan daha iyisini verir. Biz, ancak Rabbimizden dilemekteyiz.","words":[{"arabic":"عَسَىٰ","meaning":"belki"},{"arabic":"رَبُّنَآ","meaning":"Rabbimiz"},{"arabic":"أَن","meaning":"bize onun yerine verir"},{"arabic":"يُبْدِلَنَا","meaning":""},{"arabic":"خَيْرًۭا","meaning":"daha iyisini"},{"arabic":"مِّنْهَآ","meaning":"ondan"},{"arabic":"إِنَّآ","meaning":"elbette biz"},{"arabic":"إِلَىٰ","meaning":"Rabbimizi"},{"arabic":"رَبِّنَا","meaning":""},{"arabic":"رَٰغِبُونَ","meaning":"arzulayanlarız"}]},{"number":33,"reference":"68:33","arabic":"كَذَٰلِكَ ٱلْعَذَابُ ۖ وَلَعَذَابُ ٱلْـَٔاخِرَةِ أَكْبَرُ ۚ لَوْ كَانُوا۟ يَعْلَمُونَ","meaning":"İşte azap böyledir. Ahiret azabı daha büyüktür. Bilmiş olsalardı.","words":[{"arabic":"كَذَٰلِكَ","meaning":"işte böyledir"},{"arabic":"ٱلْعَذَابُ ۖ","meaning":"azab"},{"arabic":"وَلَعَذَابُ","meaning":"ve azabı ise"},{"arabic":"ٱلْـَٔاخِرَةِ","meaning":"ahiret"},{"arabic":"أَكْبَرُ ۚ","meaning":"daha büyüktür"},{"arabic":"لَوْ","meaning":"keşke"},{"arabic":"كَانُوا۟","meaning":"idi"},{"arabic":"يَعْلَمُونَ","meaning":"bilseler"}]},{"number":34,"reference":"68:34","arabic":"إِنَّ لِلْمُتَّقِينَ عِندَ رَبِّهِمْ جَنَّـٰتِ ٱلنَّعِيمِ","meaning":"Şüphesiz takva sahipleri için Rableri katında Naim Cennetleri vardır","words":[{"arabic":"إِنَّ","meaning":"şüphesiz"},{"arabic":"لِلْمُتَّقِينَ","meaning":"muttakiler için vardır"},{"arabic":"عِندَ","meaning":"katında"},{"arabic":"رَبِّهِمْ","meaning":"Rableri"},{"arabic":"جَنَّـٰتِ","meaning":"bahçeleri"},{"arabic":"ٱلنَّعِيمِ","meaning":"ni'met"}]},{"number":35,"reference":"68:35","arabic":"أَفَنَجْعَلُ ٱلْمُسْلِمِينَ كَٱلْمُجْرِمِينَ","meaning":"Müslüman olanlarla suçluları (kâfirleri) bir tutar mıyız?","words":[{"arabic":"أَفَنَجْعَلُ","meaning":"biz yapar mıyız?"},{"arabic":"ٱلْمُسْلِمِينَ","meaning":"müslümanları"},{"arabic":"كَٱلْمُجْرِمِينَ","meaning":"suçlular gibi"}]},{"number":36,"reference":"68:36","arabic":"مَا لَكُمْ كَيْفَ تَحْكُمُونَ","meaning":"Ne oluyor size? Nasıl hüküm veriyorsunuz?","words":[{"arabic":"مَا","meaning":"neyiniz var?"},{"arabic":"لَكُمْ","meaning":""},{"arabic":"كَيْفَ","meaning":"nasıl"},{"arabic":"تَحْكُمُونَ","meaning":"hüküm veriyorsunuz"}]},{"number":37,"reference":"68:37","arabic":"أَمْ لَكُمْ كِتَـٰبٌ فِيهِ تَدْرُسُونَ","meaning":"Yoksa sizin bir kitabınız var da oradan mı ders alıyorsunuz?","words":[{"arabic":"أَمْ","meaning":"yoksa"},{"arabic":"لَكُمْ","meaning":"sizin var mı?"},{"arabic":"كِتَـٰبٌۭ","meaning":"bir Kitabınız"},{"arabic":"فِيهِ","meaning":"onda (mı?)"},{"arabic":"تَدْرُسُونَ","meaning":"okuyorsunuz"}]},{"number":38,"reference":"68:38","arabic":"إِنَّ لَكُمْ فِيهِ لَمَا تَخَيَّرُونَ","meaning":"Onda, “Beğendiğiniz her şey sizindir” (diye mi yazılı?).","words":[{"arabic":"إِنَّ","meaning":"şüphesiz"},{"arabic":"لَكُمْ","meaning":"sizin için var"},{"arabic":"فِيهِ","meaning":"onda"},{"arabic":"لَمَا","meaning":"her şey"},{"arabic":"تَخَيَّرُونَ","meaning":"istediğiniz"}]},{"number":39,"reference":"68:39","arabic":"أَمْ لَكُمْ أَيْمَـٰنٌ عَلَيْنَا بَـٰلِغَةٌ إِلَىٰ يَوْمِ ٱلْقِيَـٰمَةِ ۙ إِنَّ لَكُمْ لَمَا تَحْكُمُونَ","meaning":"Yoksa “Neye hükmederseniz o yerine getirilir” diye kıyamete kadar geçerli olacak, size verilmiş yeminler/sözler mi var?","words":[{"arabic":"أَمْ","meaning":"yoksa"},{"arabic":"لَكُمْ","meaning":"sizin -mı var?"},{"arabic":"أَيْمَـٰنٌ","meaning":""},{"arabic":"عَلَيْنَا","meaning":"üzerimizde"},{"arabic":"بَـٰلِغَةٌ","meaning":"sürecek"},{"arabic":"إِلَىٰ","meaning":"kadar"},{"arabic":"يَوْمِ","meaning":"gününe"},{"arabic":"ٱلْقِيَـٰمَةِ ۙ","meaning":"kıyamet"},{"arabic":"إِنَّ","meaning":"şüphesiz"},{"arabic":"لَكُمْ","meaning":"sizindir"},{"arabic":"لَمَا","meaning":"ne"},{"arabic":"تَحْكُمُونَ","meaning":"hükmederseniz"}]},{"number":40,"reference":"68:40","arabic":"سَلْهُمْ أَيُّهُم بِذَٰلِكَ زَعِيمٌ","meaning":"Onlara sor, hangisi buna kefil olacak?","words":[{"arabic":"سَلْهُمْ","meaning":"sor onlara"},{"arabic":"أَيُّهُم","meaning":"onların hangisi?"},{"arabic":"بِذَٰلِكَ","meaning":"buna"},{"arabic":"زَعِيمٌ","meaning":"kefildir"}]},{"number":41,"reference":"68:41","arabic":"أَمْ لَهُمْ شُرَكَآءُ فَلْيَأْتُوا۟ بِشُرَكَآئِهِمْ إِن كَانُوا۟ صَـٰدِقِينَ","meaning":"Yoksa ortakları mı var onların? Sözlerinde doğru iseler, hadi getirsinler ortaklarını!","words":[{"arabic":"أَمْ","meaning":"yoksa"},{"arabic":"لَهُمْ","meaning":"kendilerinin -mı var?"},{"arabic":"شُرَكَآءُ","meaning":""},{"arabic":"فَلْيَأْتُوا۟","meaning":"o halde çağırsınlar"},{"arabic":"بِشُرَكَآئِهِمْ","meaning":"ortaklarını"},{"arabic":"إِن","meaning":"eğer"},{"arabic":"كَانُوا۟","meaning":"iseler"},{"arabic":"صَـٰدِقِينَ","meaning":"doğrulardan"}]},{"number":42,"reference":"68:42","arabic":"يَوْمَ يُكْشَفُ عَن سَاقٍ وَيُدْعَوْنَ إِلَى ٱلسُّجُودِ فَلَا يَسْتَطِيعُونَ","meaning":"O gün incik açılır ve secdeye davet edilirler; fakat güç getiremezler.","words":[{"arabic":"يَوْمَ","meaning":"gün"},{"arabic":"يُكْشَفُ","meaning":"açılacağı sıvanacağı'"},{"arabic":"عَن","meaning":"bacakların"},{"arabic":"سَاقٍۢ","meaning":""},{"arabic":"وَيُدْعَوْنَ","meaning":"ve da'vet edilecekleri"},{"arabic":"إِلَى","meaning":"secdeye;"},{"arabic":"ٱلسُّجُودِ","meaning":""},{"arabic":"فَلَا","meaning":"güçleri yetmez"},{"arabic":"يَسْتَطِيعُونَ","meaning":""}]},{"number":43,"reference":"68:43","arabic":"خَـٰشِعَةً أَبْصَـٰرُهُمْ تَرْهَقُهُمْ ذِلَّةٌ ۖ وَقَدْ كَانُوا۟ يُدْعَوْنَ إِلَى ٱلسُّجُودِ وَهُمْ سَـٰلِمُونَ","meaning":"Gözleri yere yıkılmış, yüzlerini zillet bürümüştür. Oysa onlar, sağ salim iken secdeye çağrılmışlardı.","words":[{"arabic":"خَـٰشِعَةً","meaning":"korkuyla"},{"arabic":"أَبْصَـٰرُهُمْ","meaning":"gözleri"},{"arabic":"تَرْهَقُهُمْ","meaning":"onları kaplar"},{"arabic":"ذِلَّةٌۭ ۖ","meaning":"bir zillet"},{"arabic":"وَقَدْ","meaning":"halbuki"},{"arabic":"كَانُوا۟","meaning":"da'vet edilirlerdi"},{"arabic":"يُدْعَوْنَ","meaning":""},{"arabic":"إِلَى","meaning":"secdeye"},{"arabic":"ٱلسُّجُودِ","meaning":""},{"arabic":"وَهُمْ","meaning":"onlar"},{"arabic":"سَـٰلِمُونَ","meaning":"sağlam iken"}]},{"number":44,"reference":"68:44","arabic":"فَذَرْنِى وَمَن يُكَذِّبُ بِهَـٰذَا ٱلْحَدِيثِ ۖ سَنَسْتَدْرِجُهُم مِّنْ حَيْثُ لَا يَعْلَمُونَ","meaning":"Bu sözü yalan sayanları bana bırak! Onları bilmedikleri bir yerden yavaş yavaş azaba yaklaştıracağız.","words":[{"arabic":"فَذَرْنِى","meaning":"bana bırak"},{"arabic":"وَمَن","meaning":"kimseyi"},{"arabic":"يُكَذِّبُ","meaning":"yalanlayan"},{"arabic":"بِهَـٰذَا","meaning":"bu"},{"arabic":"ٱلْحَدِيثِ ۖ","meaning":"sözü"},{"arabic":"سَنَسْتَدْرِجُهُم","meaning":"onları derece derece yaklaştıracağız"},{"arabic":"مِّنْ","meaning":"yerden"},{"arabic":"حَيْثُ","meaning":""},{"arabic":"لَا","meaning":"bilmedikleri"},{"arabic":"يَعْلَمُونَ","meaning":""}]},{"number":45,"reference":"68:45","arabic":"وَأُمْلِى لَهُمْ ۚ إِنَّ كَيْدِى مَتِينٌ","meaning":"Onlara mühlet veriyorum Çünkü benim tuzağım çok sağlamdır.","words":[{"arabic":"وَأُمْلِى","meaning":"mühlet veriyorum"},{"arabic":"لَهُمْ ۚ","meaning":"onlara"},{"arabic":"إِنَّ","meaning":"doğrusu"},{"arabic":"كَيْدِى","meaning":"benim tuzağım"},{"arabic":"مَتِينٌ","meaning":"sağlamdır"}]},{"number":46,"reference":"68:46","arabic":"أَمْ تَسْـَٔلُهُمْ أَجْرًا فَهُم مِّن مَّغْرَمٍ مُّثْقَلُونَ","meaning":"Yoksa, onlardan bir ücret istiyorsun da ağır bir borç altındalar mı?","words":[{"arabic":"أَمْ","meaning":"yoksa"},{"arabic":"تَسْـَٔلُهُمْ","meaning":"sen istiyorsun (da)"},{"arabic":"أَجْرًۭا","meaning":"bir ücret (mi?)"},{"arabic":"فَهُم","meaning":"onlardan"},{"arabic":"مِّن","meaning":"borçtan (dolayı)"},{"arabic":"مَّغْرَمٍۢ","meaning":""},{"arabic":"مُّثْقَلُونَ","meaning":"ağır bir yük altındadırlar"}]},{"number":47,"reference":"68:47","arabic":"أَمْ عِندَهُمُ ٱلْغَيْبُ فَهُمْ يَكْتُبُونَ","meaning":"Yoksa gayb onların yanında da, onlar mı yazıyorlar?","words":[{"arabic":"أَمْ","meaning":"yoksa"},{"arabic":"عِندَهُمُ","meaning":"yanlarında (mıdır?)"},{"arabic":"ٱلْغَيْبُ","meaning":"gayb"},{"arabic":"فَهُمْ","meaning":"onlar"},{"arabic":"يَكْتُبُونَ","meaning":"yazıyorlar"}]},{"number":48,"reference":"68:48","arabic":"فَٱصْبِرْ لِحُكْمِ رَبِّكَ وَلَا تَكُن كَصَاحِبِ ٱلْحُوتِ إِذْ نَادَىٰ وَهُوَ مَكْظُومٌ","meaning":"Rabbinin hükmünü sabırla bekle Balık sahibi /Yunus gibi olma Hani O, dertli bir sesle Rabbine seslenmişti.","words":[{"arabic":"فَٱصْبِرْ","meaning":"sen sabret"},{"arabic":"لِحُكْمِ","meaning":"hükmüne"},{"arabic":"رَبِّكَ","meaning":"Rabbinin"},{"arabic":"وَلَا","meaning":"ve"},{"arabic":"تَكُن","meaning":"olma"},{"arabic":"كَصَاحِبِ","meaning":"sahibi gibi (Yunus)"},{"arabic":"ٱلْحُوتِ","meaning":"balık"},{"arabic":"إِذْ","meaning":"hani"},{"arabic":"نَادَىٰ","meaning":"seslenmişti"},{"arabic":"وَهُوَ","meaning":"ve o"},{"arabic":"مَكْظُومٌۭ","meaning":"sıkıntıdan yutkunarak"}]},{"number":49,"reference":"68:49","arabic":"لَّوْلَآ أَن تَدَٰرَكَهُۥ نِعْمَةٌ مِّن رَّبِّهِۦ لَنُبِذَ بِٱلْعَرَآءِ وَهُوَ مَذْمُومٌ","meaning":"Rabbinden ona bir nimet erişmiş olmasaydı, kınanmış olarak çıplak bir karaya atılacaktı.","words":[{"arabic":"لَّوْلَآ","meaning":"eğer olmasaydı"},{"arabic":"أَن","meaning":"ona yetişmesi"},{"arabic":"تَدَٰرَكَهُۥ","meaning":""},{"arabic":"نِعْمَةٌۭ","meaning":"bir ni'metin"},{"arabic":"مِّن","meaning":"Rabbinden"},{"arabic":"رَّبِّهِۦ","meaning":""},{"arabic":"لَنُبِذَ","meaning":"elbette atılırdı"},{"arabic":"بِٱلْعَرَآءِ","meaning":"çıplak bir yere"},{"arabic":"وَهُوَ","meaning":"ve o"},{"arabic":"مَذْمُومٌۭ","meaning":"kınananrak"}]},{"number":50,"reference":"68:50","arabic":"فَٱجْتَبَـٰهُ رَبُّهُۥ فَجَعَلَهُۥ مِنَ ٱلصَّـٰلِحِينَ","meaning":"Rabbi O’nu seçti ve salih kimselerden kıldı.","words":[{"arabic":"فَٱجْتَبَـٰهُ","meaning":"onun du'asını kabul etti"},{"arabic":"رَبُّهُۥ","meaning":"Rabbi"},{"arabic":"فَجَعَلَهُۥ","meaning":"ve onu yaptı"},{"arabic":"مِنَ","meaning":"salihlerden"},{"arabic":"ٱلصَّـٰلِحِينَ","meaning":""}]},{"number":51,"reference":"68:51","arabic":"وَإِن يَكَادُ ٱلَّذِينَ كَفَرُوا۟ لَيُزْلِقُونَكَ بِأَبْصَـٰرِهِمْ لَمَّا سَمِعُوا۟ ٱلذِّكْرَ وَيَقُولُونَ إِنَّهُۥ لَمَجْنُونٌ","meaning":"Kâfir olanlar, zikri işittiklerinde seni neredeyse gözleriyle devireceklerdi: O, kesinlikle delidir, diyorlardı.","words":[{"arabic":"وَإِن","meaning":"ve"},{"arabic":"يَكَادُ","meaning":"neredeyse"},{"arabic":"ٱلَّذِينَ","meaning":"kimseler"},{"arabic":"كَفَرُوا۟","meaning":"inkar eden(ler)"},{"arabic":"لَيُزْلِقُونَكَ","meaning":"seni devireceklerdi"},{"arabic":"بِأَبْصَـٰرِهِمْ","meaning":"gözleriyle"},{"arabic":"لَمَّا","meaning":"zaman"},{"arabic":"سَمِعُوا۟","meaning":"işittikleri"},{"arabic":"ٱلذِّكْرَ","meaning":"Zikr(Kur'an)'ı"},{"arabic":"وَيَقُولُونَ","meaning":"ve diyorlardı"},{"arabic":"إِنَّهُۥ","meaning":"şüphesiz O"},{"arabic":"لَمَجْنُونٌۭ","meaning":"mecnundur"}]},{"number":52,"reference":"68:52","arabic":"وَمَا هُوَ إِلَّا ذِكْرٌ لِّلْعَـٰلَمِينَ","meaning":"Oysa o (Kur’an) alemlere bir uyarı/öğütten başka bir şey değildir.","words":[{"arabic":"وَمَا","meaning":"halbuki değildir"},{"arabic":"هُوَ","meaning":"o"},{"arabic":"إِلَّا","meaning":"başka bir şey"},{"arabic":"ذِكْرٌۭ","meaning":"uyarıdan"},{"arabic":"لِّلْعَـٰلَمِينَ","meaning":"alemler için"}]}]}
