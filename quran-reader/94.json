{"number":94,"source":"Kur’an metni ve kelime çözümlemesi: Quran.com · Türkçe meal: Shaban Britch; birleşik dört ayetin ayrımı: Dar Al-Salam Center","verses":[{"number":1,"reference":"94:1","arabic":"أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ","meaning":"Senin göğsünü ferahlatıp, genişletmedik mi?","words":[{"arabic":"أَلَمْ","meaning":"açmadık mı?"},{"arabic":"نَشْرَحْ","meaning":""},{"arabic":"لَكَ","meaning":"senin"},{"arabic":"صَدْرَكَ","meaning":"göğsünü"}]},{"number":2,"reference":"94:2","arabic":"وَوَضَعْنَا عَنكَ وِزْرَكَ","meaning":"Yükünü üzerinden indirmedik mi?","words":[{"arabic":"وَوَضَعْنَا","meaning":"ve atmadık mı?"},{"arabic":"عَنكَ","meaning":"senin üzerinden"},{"arabic":"وِزْرَكَ","meaning":"yükünü"}]},{"number":3,"reference":"94:3","arabic":"ٱلَّذِىٓ أَنقَضَ ظَهْرَكَ","meaning":"Ki o belini bükmüştü.","words":[{"arabic":"ٱلَّذِىٓ","meaning":"(o yük) ki"},{"arabic":"أَنقَضَ","meaning":"çatırdatmıştı"},{"arabic":"ظَهْرَكَ","meaning":"sırtını"}]},{"number":4,"reference":"94:4","arabic":"وَرَفَعْنَا لَكَ ذِكْرَكَ","meaning":"Şanını yükseltmedik mi?","words":[{"arabic":"وَرَفَعْنَا","meaning":"ve yükseltmedik mi?"},{"arabic":"لَكَ","meaning":"senin"},{"arabic":"ذِكْرَكَ","meaning":"şanını"}]},{"number":5,"reference":"94:5","arabic":"فَإِنَّ مَعَ ٱلْعُسْرِ يُسْرًا","meaning":"Şüphesiz her zorlukla, bir kolaylık vardır.","words":[{"arabic":"فَإِنَّ","meaning":"muhakkak (vardır)"},{"arabic":"مَعَ","meaning":"beraber"},{"arabic":"ٱلْعُسْرِ","meaning":"her güçlükle"},{"arabic":"يُسْرًا","meaning":"bir kolaylık"}]},{"number":6,"reference":"94:6","arabic":"إِنَّ مَعَ ٱلْعُسْرِ يُسْرًا","meaning":"Her zorlukla bir kolaylık vardır.","words":[{"arabic":"إِنَّ","meaning":"elbette (vardır)"},{"arabic":"مَعَ","meaning":"beraber"},{"arabic":"ٱلْعُسْرِ","meaning":"her güçlükle"},{"arabic":"يُسْرًۭا","meaning":"bir kolaylık"}]},{"number":7,"reference":"94:7","arabic":"فَإِذَا فَرَغْتَ فَٱنصَبْ","meaning":"Öyleyse boş kaldın mı hemen (ibadetle) yorul.","words":[{"arabic":"فَإِذَا","meaning":"zaman"},{"arabic":"فَرَغْتَ","meaning":"boşaldığın (işin bitince)"},{"arabic":"فَٱنصَبْ","meaning":"(tekrar) başla"}]},{"number":8,"reference":"94:8","arabic":"وَإِلَىٰ رَبِّكَ فَٱرْغَب","meaning":"Yalnız Rabbine rağbet et.","words":[{"arabic":"وَإِلَىٰ","meaning":"ve"},{"arabic":"رَبِّكَ","meaning":"Rabb'ine"},{"arabic":"فَٱرْغَب","meaning":"niyaz et yalvar"}]}]}
