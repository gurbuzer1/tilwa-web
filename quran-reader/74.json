imize karşı inatçı oldu.","words":[{"arabic":"كَلَّآ ۖ","meaning":"hayır"},{"arabic":"إِنَّهُۥ","meaning":"çünkü o"},{"arabic":"كَانَ","meaning":"oldu"},{"arabic":"لِـَٔايَـٰتِنَا","meaning":"bizim ayetlerimize karşı"},{"arabic":"عَنِيدًۭا","meaning":"bir inatçı"}]},{"number":17,"reference":"74:17","arabic":"سَأُرْهِقُهُۥ صَعُودًا","meaning":"Onu sarp bir yokuşa zorlayıp, süreceğim.","words":[{"arabic":"سَأُرْهِقُهُۥ","meaning":"onu sardıracağım"},{"arabic":"صَعُودًا","meaning":"dimdik bir yokuşa"}]},{"number":18,"reference":"74:18","arabic":"إِنَّهُۥ فَكَّرَ وَقَدَّرَ","meaning":"Çünkü o düşündü, ölçtü ve biçti.","words":[{"arabic":"إِنَّهُۥ","meaning":"zira o"},{"arabic":"فَكَّرَ","meaning":"düşündü"},{"arabic":"وَقَدَّرَ","meaning":"ölçtü biçti"}]},{"number":19,"reference":"74:19","arabic":"فَقُتِلَ كَيْفَ قَدَّرَ","meaning":"Kahrolası nasıl da ölçtü biçti!","words":[{"arabic":"فَقُتِلَ","meaning":"kahrolası"},{"arabic":"كَيْفَ","meaning":"nasıl da"},{"arabic":"قَدَّرَ","meaning":"ölçtü biçti"}]},{"number":20,"reference":"74:20","arabic":"ثُمَّ قُتِلَ كَيْفَ قَدَّرَ","meaning":"Sonra (yine o) kahrolası, nasıl (da) ölçtü biçti!","words":[{"arabic":"ثُمَّ","meaning":"sonra"},{"arabic":"قُتِلَ","meaning":"kahrolası"},{"arabic":"كَيْفَ","meaning":"nasıl"},{"arabic":"قَدَّرَ","meaning":"ölçtü biçti"}]},{"number":21,"reference":"74:21","arabic":"ثُمَّ نَظَرَ","meaning":"Sonra baktı.","words":[{"arabic":"ثُمَّ","meaning":"sonra"},{"arabic":"نَظَرَ","meaning":"baktı"}]},{"number":22,"reference":"74:22","arabic":"ثُمَّ عَبَسَ وَبَسَرَ","meaning":"Sonra kaşlarını çatıp, surat astı.","words":[{"arabic":"ثُمَّ","meaning":"sonra"},{"arabic":"عَبَسَ","meaning":"surat astı"},{"arabic":"وَبَسَرَ","meaning":"kaşlarını çattı"}]},{"number":23,"reference":"74:23","arabic":"ثُمَّ أَدْبَرَ وَٱسْتَكْبَرَ","meaning":"Sonra da arkasını dönüp büyüklendi.","words":[{"arabic":"ثُمَّ","meaning":"sonra"},{"arabic":"أَدْبَرَ","meaning":"arkasını döndü"},{"arabic":"وَٱسْتَكْبَرَ","meaning":"ve böbürlendi"}]},{"number":24,"reference":"74:24","arabic":"فَقَالَ إِنْ هَـٰذَآ إِلَّا سِحْرٌ يُؤْثَرُ","meaning":"Ve şöyle dedi: Bu sadece öğretile gelen bir sihirdir.","words":[{"arabic":"فَقَالَ","meaning":"sonra dedi"},{"arabic":"إِنْ","meaning":"değildir"},{"arabic":"هَـٰذَآ","meaning":"bu"},{"arabic":"إِلَّا","meaning":"başka bir şey"},{"arabic":"سِحْرٌۭ","meaning":"bir büyü(den)"},{"arabic":"يُؤْثَرُ","meaning":"rivayet edilip öğretilen"}]},{"number":25,"reference":"74:25","arabic":"إِنْ هَـٰذَآ إِلَّا قَوْلُ ٱلْبَشَرِ","meaning":"Bu insan sözünden başka bir şey değil.","words":[{"arabic":"إِنْ","meaning":"değildir"},{"arabic":"هَـٰذَآ","meaning":"bu"},{"arabic":"إِلَّا","meaning":"başka bir şey"},{"arabic":"قَوْلُ","meaning":"sözü(nden)"},{"arabic":"ٱلْبَشَرِ","meaning":"bir insan"}]},{"number":26,"reference":"74:26","arabic":"سَأُصْلِيهِ سَقَرَ","meaning":"Onu Sekar’a sokacağım.","words":[{"arabic":"سَأُصْلِيهِ","meaning":"onu sokacağım"},{"arabic":"سَقَرَ","meaning":"Sekar'a"}]},{"number":27,"reference":"74:27","arabic":"وَمَآ أَدْرَىٰكَ مَا سَقَرُ","meaning":"Sekar’ın ne olduğunu bilir misin sen?","words":[{"arabic":"وَمَآ","meaning":"ve"},{"arabic":"أَدْرَىٰكَ","meaning":"sen nereden bileceksin?"},{"arabic":"مَا","meaning":"ne olduğunu"},{"arabic":"سَقَرُ","meaning":"Sekar'ın"}]},{"number":28,"reference":"74:28","arabic":"لَا تُبْقِى وَلَا تَذَرُ","meaning":"Geride bir şey koymaz, bırakmaz.","words":[{"arabic":"لَا","meaning":"geriye bir şey komaz"},{"arabic":"تُبْقِى","meaning":""},{"arabic":"وَلَا","meaning":"ve ne de"},{"arabic":"تَذَرُ","meaning":"bırakmaz"}]},{"number":29,"reference":"74:29","arabic":"لَوَّاحَةٌ لِّلْبَشَرِ","meaning":"Derileri yakıp kavurur.","words":[{"arabic":"لَوَّاحَةٌۭ","meaning":"yakar kavurur"},{"arabic":"لِّلْبَشَرِ","meaning":"insanı"}]},{"number":30,"reference":"74:30","arabic":"عَلَيْهَا تِسْعَةَ عَشَرَ","meaning":"Üzerinde on dokuz (melek) vardır.","words":[{"arabic":"عَلَيْهَا","meaning":"üzerinde vardır"},{"arabic":"تِسْعَةَ","meaning":"(on)dokuz"},{"arabic":"عَشَرَ","meaning":"on(dokuz)"}]},{"number":31,"reference":"74:31","arabic":"وَمَا جَعَلْنَآ أَصْحَـٰبَ ٱلنَّارِ إِلَّا مَلَـٰٓئِكَةً ۙ وَمَا جَعَلْنَا عِدَّتَهُمْ إِلَّا فِتْنَةً لِّلَّذِينَ كَفَرُوا۟ لِيَسْتَيْقِنَ ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَـٰبَ وَيَزْدَادَ ٱلَّذِينَ ءَامَنُوٓا۟ إِيمَـٰنًا ۙ وَلَا يَرْتَابَ ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَـٰبَ وَٱلْمُؤْمِنُونَ ۙ وَلِيَقُولَ ٱلَّذِينَ فِى قُلُوبِهِم مَّرَضٌ وَٱلْكَـٰفِرُونَ مَاذَآ أَرَادَ ٱللَّهُ بِهَـٰذَا مَثَلًا ۚ كَذَٰلِكَ يُضِلُّ ٱللَّهُ مَن يَشَآءُ وَيَهْدِى مَن يَشَآءُ ۚ وَمَا يَعْلَمُ جُنُودَ رَبِّكَ إِلَّا هُوَ ۚ وَمَا هِىَ إِلَّا ذِكْرَىٰ لِلْبَشَرِ","meaning":"Biz kendilerine kitap verilenler kesin bir bilgiyle inansın, iman edenlerin imanları artsın, kendilerine kitap verilenler ile iman edenler şüpheye kapılmasın, kalplerinde bir hastalık olanlar ile küfre sapanlar da, “Allah, bu örnekle (on dokuz sayısı ile) neyi anlatmak istedi?” desin diye o ateşin koruyucularını, meleklerden başkasını kılmadık ve onların sayısını da kâfirler için yalnızca bir fitne/imtihan yaptık. Allah, dilediğini işte böyle saptırır, dilediğine de hidayet eder. Rabbinin ordularını kendisinden başkası bilemez. Bu, insanlar için bir öğütten başka bir şey değildir.","words":[{"arabic":"وَمَا","meaning":"ve"},{"arabic":"جَعَلْنَآ","meaning":"biz yapmadık"},{"arabic":"أَصْحَـٰبَ","meaning":"muhafızları"},{"arabic":"ٱلنَّارِ","meaning":"cehennemin"},{"arabic":"إِلَّا","meaning":"başkasını"},{"arabic":"مَلَـٰٓئِكَةًۭ ۙ","meaning":"meleklerden"},{"arabic":"وَمَا","meaning":"ve"},{"arabic":"جَعَلْنَا","meaning":"yapmadık"},{"arabic":"عِدَّتَهُمْ","meaning":"onların sayısını"},{"arabic":"إِلَّا","meaning":"başka bir şey"},{"arabic":"فِتْنَةًۭ","meaning":"bir sınavdan"},{"arabic":"لِّلَّذِينَ","meaning":"için"},{"arabic":"كَفَرُوا۟","meaning":"inkar edenler;"},{"arabic":"لِيَسْتَيْقِنَ","meaning":"iyice inansın diye"},{"arabic":"ٱلَّذِينَ","meaning":"olanlar"},{"arabic":"أُوتُوا۟","meaning":"kendilerine verilmiş"},{"arabic":"ٱلْكِتَـٰبَ","meaning":"Kitap"},{"arabic":"وَيَزْدَادَ","meaning":"ve artsın diye"},{"arabic":"ٱلَّذِينَ","meaning":"inananların"},{"arabic":"ءَامَنُوٓا۟","meaning":""},{"arabic":"إِيمَـٰنًۭا ۙ","meaning":"imanı"},{"arabic":"وَلَا","meaning":"ve"},{"arabic":"يَرْتَابَ","meaning":"kuşkulanmasınlar"},{"arabic":"ٱلَّذِينَ","meaning":"olanlar"},{"arabic":"أُوتُوا۟","meaning":"verilmiş"},{"arabic":"ٱلْكِتَـٰبَ","meaning":"Kitap"},{"arabic":"وَٱلْمُؤْمِنُونَ ۙ","meaning":"ve inananlar"},{"arabic":"وَلِيَقُولَ","meaning":"ve desinler diye"},{"arabic":"ٱلَّذِينَ","meaning":"kimseler"},{"arabic":"فِى","meaning":"bulunan"},{"arabic":"قُلُوبِهِم","meaning":"kalblerinde"},{"arabic":"مَّرَضٌۭ","meaning":"hastalık"},{"arabic":"وَٱلْكَـٰفِرُونَ","meaning":"ve kafirler"},{"arabic":"مَاذَآ","meaning":"ne?"},{"arabic":"أَرَادَ","meaning":"demek istedi"},{"arabic":"ٱللَّهُ","meaning":"Allah"},{"arabic":"بِهَـٰذَا","meaning":"bu"},{"arabic":"مَثَلًۭا ۚ","meaning":"misalle"},{"arabic":"كَذَٰلِكَ","meaning":"böylece"},{"arabic":"يُضِلُّ","meaning":"şaşırtır"},{"arabic":"ٱللَّهُ","meaning":"Allah"},{"arabic":"مَن","meaning":"kimseyi"},{"arabic":"يَشَآءُ","meaning":"dilediği"},{"arabic":"وَيَهْدِى","meaning":"ve doğru yola iletir"},{"arabic":"مَن","meaning":"kimseyi"},{"arabic":"يَشَآءُ ۚ","meaning":"dilediği"},{"arabic":"وَمَا","meaning":"ve"},{"arabic":"يَعْلَمُ","meaning":"bilmez"},{"arabic":"جُنُودَ","meaning":"ordularını"},{"arabic":"رَبِّكَ","meaning":"Rabbinin"},{"arabic":"إِلَّا","meaning":"başkası"},{"arabic":"هُوَ ۚ","meaning":"O'ndan"},{"arabic":"وَمَا","meaning":"ve değildir"},{"arabic":"هِىَ","meaning":"bu"},{"arabic":"إِلَّا","meaning":"başka bir şey"},{"arabic":"ذِكْرَىٰ","meaning":"bir uyarı(dan)"},{"arabic":"لِلْبَشَرِ","meaning":"insanlara"}]},{"number":32,"reference":"74:32","arabic":"كَلَّا وَٱلْقَمَرِ","meaning":"Ay’a yemin olsun ki;","words":[{"arabic":"كَلَّا","meaning":"hayır"},{"arabic":"وَٱلْقَمَرِ","meaning":"andolsun Aya"}]},{"n