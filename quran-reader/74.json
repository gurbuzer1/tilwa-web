{"number":74,"source":"Kur’an metni ve kelime çözümlemesi: Quran.com · Türkçe meal: Shaban Britch; birleşik dört ayetin ayrımı: Dar Al-Salam Center","verses":[{"number":1,"reference":"74:1","arabic":"يَـٰٓأَيُّهَا ٱلْمُدَّثِّرُ","meaning":"Ey (elbisesine) bürünen!","words":[{"arabic":"يَـٰٓأَيُّهَا","meaning":"ey"},{"arabic":"ٱلْمُدَّثِّرُ","meaning":"örtüsüne bürünen"}]},{"number":2,"reference":"74:2","arabic":"قُمْ فَأَنذِرْ","meaning":"Kalk ve uyar!","words":[{"arabic":"قُمْ","meaning":"kalk"},{"arabic":"فَأَنذِرْ","meaning":"ve uyar"}]},{"number":3,"reference":"74:3","arabic":"وَرَبَّكَ فَكَبِّرْ","meaning":"Ve Rabbinin tekbir et!","words":[{"arabic":"وَرَبَّكَ","meaning":"ve Rabbini"},{"arabic":"فَكَبِّرْ","meaning":"tekbir et"}]},{"number":4,"reference":"74:4","arabic":"وَثِيَابَكَ فَطَهِّرْ","meaning":"Elbiseni temizle.","words":[{"arabic":"وَثِيَابَكَ","meaning":"ve elbiseni"},{"arabic":"فَطَهِّرْ","meaning":"temizle"}]},{"number":5,"reference":"74:5","arabic":"وَٱلرُّجْزَ فَٱهْجُرْ","meaning":"Pislikten uzak dur!","words":[{"arabic":"وَٱلرُّجْزَ","meaning":"ve pislikten"},{"arabic":"فَٱهْجُرْ","meaning":"kaçın"}]},{"number":6,"reference":"74:6","arabic":"وَلَا تَمْنُن تَسْتَكْثِرُ","meaning":"Yaptığın iyiliği çok görerek başa kakma.","words":[{"arabic":"وَلَا","meaning":"ve"},{"arabic":"تَمْنُن","meaning":"başa kakma"},{"arabic":"تَسْتَكْثِرُ","meaning":"verdiğini çok bularak"}]},{"number":7,"reference":"74:7","arabic":"وَلِرَبِّكَ فَٱصْبِرْ","meaning":"Rabbin için sabret.","words":[{"arabic":"وَلِرَبِّكَ","meaning":"ve Rabbin için"},{"arabic":"فَٱصْبِرْ","meaning":"sabret"}]},{"number":8,"reference":"74:8","arabic":"فَإِذَا نُقِرَ فِى ٱلنَّاقُورِ","meaning":"Sûr’a üflendiği zaman;","words":[{"arabic":"فَإِذَا","meaning":"zaman"},{"arabic":"نُقِرَ","meaning":"üflendiği"},{"arabic":"فِى","meaning":"Sur'a (boruya)"},{"arabic":"ٱلنَّاقُورِ","meaning":""}]},{"number":9,"reference":"74:9","arabic":"فَذَٰلِكَ يَوْمَئِذٍ يَوْمٌ عَسِيرٌ","meaning":"İşte o gün zor b