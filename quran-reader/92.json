{"number":92,"source":"Kur’an metni ve kelime çözümlemesi: Quran.com · Türkçe meal: Shaban Britch; birleşik dört ayetin ayrımı: Dar Al-Salam Center","verses":[{"number":1,"reference":"92:1","arabic":"وَٱلَّيْلِ إِذَا يَغْشَىٰ","meaning":"Bürüdüğü zaman geceye olsun,","words":[{"arabic":"وَٱلَّيْلِ","meaning":"geceye andolsun"},{"arabic":"إِذَا","meaning":"zaman"},{"arabic":"يَغْشَىٰ","meaning":"örttüğü"}]},{"number":2,"reference":"92:2","arabic":"وَٱلنَّهَارِ إِذَا تَجَلَّىٰ","meaning":"Ortaya çıktığı zaman gündüze,","words":[{"arabic":"وَٱلنَّهَارِ","meaning":"ve gündüze andolsun"},{"arabic":"إِذَا","meaning":"zaman"},{"arabic":"تَجَلَّىٰ","meaning":"göründüğü"}]},{"number":3,"reference":"92:3","arabic":"وَمَا خَلَقَ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ","meaning":"Erkeği ve dişiyi yaratana yemin ederim ki,","words":[{"arabic":"وَمَا","meaning":"ve andolsun"},{"arabic":"خَلَقَ","meaning":"yaratana"},{"arabic":"ٱلذَّكَرَ","meaning":"erkeği"},{"arabic":"وَٱلْأُنثَىٰٓ","meaning":"ve dişiyi"}]},{"number":4,"reference":"92:4","arabic":"إِنَّ سَعْيَكُمْ لَشَتَّىٰ","meaning":"Doğrusu sizin çalışmalarınız çeşit çeşittir.","words":[{"arabic":"إِنَّ","meaning":"şüphesiz"},{"arabic":"سَعْيَكُمْ","meaning":"sizin işiniz"},{"arabic":"لَشَتَّىٰ","meaning":"çeşit çeşittir"}]},{"number":5,"reference":"92:5","arabic":"فَأَمَّا مَنْ أَعْطَىٰ وَٱتَّقَىٰ","meaning":"Kim (malından) verir ve sakınırsa,","words":[{"arabic":"فَأَمَّا","meaning":"ama"},{"arabic":"مَنْ","meaning":"kim"},{"arabic":"أَعْطَىٰ","meaning":"(hayır için) verir"},{"arabic":"وَٱتَّقَىٰ","meaning":"korunursa"}]},{"number":6,"reference":"92:6","arabic":"وَصَدَّقَ بِٱلْحُسْنَىٰ","meaning":"En güzeli tasdik ederse,","words":[{"arabic":"وَصَدَّقَ","meaning":"ve doğrularsa"},{"arabic":"بِٱلْحُسْنَىٰ","meaning":"en güzel(söz)ü"}]},{"number":7,"reference":"92:7","arabic":"فَسَنُيَسِّرُهُۥ لِلْيُسْرَىٰ","meaning":"Biz de ona kolay olanı kolaylaştırırız.","words":[{"arabic":"فَسَنُيَسِّرُهُۥ","meaning":"ona kolaylaştırırız"},{"arabic":"لِلْيُسْرَىٰ","meaning":"en kolayı"}]},{"number":8,"reference":"92:8","arabic":"وَأَمَّا مَنۢ بَخِلَ وَٱسْتَغْنَىٰ","meaning":"Kim de cimrilik eder ve kendini ihtiyaçsız görürse,","words":[{"arabic":"وَأَمَّا","meaning":"ama"},{"arabic":"مَنۢ","meaning":"kim"},{"arabic":"بَخِلَ","meaning":"cimrilik ederse"},{"arabic":"وَٱسْتَغْنَىٰ","meaning":"ve kendini zengin görürse"}]},{"number":9,"reference":"92:9","arabic":"وَكَذَّبَ بِٱلْحُسْنَىٰ","meaning":"En güzeli yalanlarsa,","words":[{"arabic":"وَكَذَّبَ","meaning":"ve yalanlarsa"},{"arabic":"بِٱلْحُسْنَىٰ","meaning":"en güzel(söz)ü"}]},{"number":10,"reference":"92:10","arabic":"فَسَنُيَسِّرُهُۥ لِلْعُسْرَىٰ","meaning":"Biz de ona zor olanı kolaylaştırırız.","words":[{"arabic":"فَسَنُيَسِّرُهُۥ","meaning":"ona da kolaylaştırırız"},{"arabic":"لِلْعُسْرَىٰ","meaning":"en güç(yolda gitmey)i"}]},{"number":11,"reference":"92:11","arabic":"وَمَا يُغْنِى عَنْهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ","meaning":"(Ateşe) düştüğü zaman malı ona bir yarar sağlamaz.","words":[{"arabic":"وَمَا","meaning":"ve yoktur"},{"arabic":"يُغْنِى","meaning":"faydası"},{"arabic":"عَنْهُ","meaning":"ona"},{"arabic":"مَالُهُۥٓ","meaning":"malının"},{"arabic":"إِذَا","meaning":"zaman"},{"arabic":"تَرَدَّىٰٓ","meaning":"çukura düştüğü"}]},{"number":12,"reference":"92:12","arabic":"إِنَّ عَلَيْنَا لَلْهُدَىٰ","meaning":"Şüphesiz bize ait olan, yol göstermektir.","words":[{"arabic":"إِنَّ","meaning":"şüphesiz"},{"arabic":"عَلَيْنَا","meaning":"bize aittir"},{"arabic":"لَلْهُدَىٰ","meaning":"doğru yola iletmek"}]},{"number":13,"reference":"92:13","arabic":"وَإِنَّ لَنَا لَلْـَٔاخِرَةَ وَٱلْأُولَىٰ","meaning":"Şüphesiz ahiret de dünya da bizimdir.","words":[{"arabic":"وَإِنَّ","meaning":"ve şüphesiz"},{"arabic":"لَنَا","meaning":"bizimdir"},{"arabic":"لَلْـَٔاخِرَةَ","meaning":"son da"},{"arabic":"وَٱلْأُولَىٰ","meaning":"ilk de"}]},{"number":14,"reference":"92:14","arabic":"فَأَنذَرْتُكُمْ نَارًا تَلَظَّىٰ","meaning":"Sizi, alev alev yanan ateşe karşı uyardım.","words":[{"arabic":"فَأَنذَرْتُكُمْ","meaning":"ben sizi uyardım"},{"arabic":"نَارًۭا","meaning":"bir ateşe karşı"},{"arabic":"تَلَظَّىٰ","meaning":"alev saçan"}]},{"number":15,"reference":"92:15","arabic":"لَا يَصْلَىٰهَآ إِلَّا ٱلْأَشْقَى","meaning":"Ona ancak en azgın olan girecektir.","words":[{"arabic":"لَا","meaning":"ona girmez"},{"arabic":"يَصْلَىٰهَآ","meaning":""},{"arabic":"إِلَّا","meaning":"başkası"},{"arabic":"ٱلْأَشْقَى","meaning":"haydut olandan"}]},{"number":16,"reference":"92:16","arabic":"ٱلَّذِى كَذَّبَ وَتَوَلَّىٰ","meaning":"Yalanlayan, yüz çeviren,","words":[{"arabic":"ٱلَّذِى","meaning":"o ki"},{"arabic":"كَذَّبَ","meaning":"yalanlandı"},{"arabic":"وَتَوَلَّىٰ","meaning":"ve sırtını döndü"}]},{"number":17,"reference":"92:17","arabic":"وَسَيُجَنَّبُهَا ٱلْأَتْقَى","meaning":"Takva sahibi ondan uzak tutulacaktır.","words":[{"arabic":"وَسَيُجَنَّبُهَا","meaning":"ve ondan uzak tutulur"},{"arabic":"ٱلْأَتْقَى","meaning":"en muttaki olan"}]},{"number":18,"reference":"92:18","arabic":"ٱلَّذِى يُؤْتِى مَالَهُۥ يَتَزَكَّىٰ","meaning":"Malını veren ve arınan…","words":[{"arabic":"ٱلَّذِى","meaning":"o ki"},{"arabic":"يُؤْتِى","meaning":"(hayra) vererek"},{"arabic":"مَالَهُۥ","meaning":"malını"},{"arabic":"يَتَزَكَّىٰ","meaning":"arınır yücelir"}]},{"number":19,"reference":"92:19","arabic":"وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةٍ تُجْزَىٰٓ","meaning":"Hiç kimseden bir karşılık, nimet beklemez.","words":[{"arabic":"وَمَا","meaning":"ve yoktur"},{"arabic":"لِأَحَدٍ","meaning":"hiç kimsenin"},{"arabic":"عِندَهُۥ","meaning":"onun yanında"},{"arabic":"مِن","meaning":"hiçbir"},{"arabic":"نِّعْمَةٍۢ","meaning":"ni'meti"},{"arabic":"تُجْزَىٰٓ","meaning":"karşılık verilecek"}]},{"number":20,"reference":"92:20","arabic":"إِلَّا ٱبْتِغَآءَ وَجْهِ رَبِّهِ ٱلْأَعْلَىٰ","meaning":"Sadece yüce Rabbinin yüzünü/rızasını arzular.","words":[{"arabic":"إِلَّا","meaning":"yalnız"},{"arabic":"ٱبْتِغَآءَ","meaning":"ulaşmak için"},{"arabic":"وَجْهِ","meaning":"rızasına"},{"arabic":"رَبِّهِ","meaning":"Rabbinin"},{"arabic":"ٱلْأَعْلَىٰ","meaning":"yüce"}]},{"number":21,"reference":"92:21","arabic":"وَلَسَوْفَ يَرْضَىٰ","meaning":"Elbette o da hoşnut olacaktır.","words":[{"arabic":"وَلَسَوْفَ","meaning":"yakında"},{"arabic":"يَرْضَىٰ","meaning":"razı olacaktır"}]}]}
