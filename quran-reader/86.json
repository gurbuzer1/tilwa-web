{"number":86,"source":"Kur’an metni ve kelime çözümlemesi: Quran.com · Türkçe meal: Shaban Britch; birleşik dört ayetin ayrımı: Dar Al-Salam Center","verses":[{"number":1,"reference":"86:1","arabic":"وَٱلسَّمَآءِ وَٱلطَّارِقِ","meaning":"Göğe ve Tarık’a andolsun ki.","words":[{"arabic":"وَٱلسَّمَآءِ","meaning":"göğe andolsun"},{"arabic":"وَٱلطَّارِقِ","meaning":"ve tarık'a"}]},{"number":2,"reference":"86:2","arabic":"وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ","meaning":"Tarık’ı sana bildiren nedir?","words":[{"arabic":"وَمَآ","meaning":"ve nedir?"},{"arabic":"أَدْرَىٰكَ","meaning":"sana bildiren"},{"arabic":"مَا","meaning":"nedir"},{"arabic":"ٱلطَّارِقُ","meaning":"tarık"}]},{"number":3,"reference":"86:3","arabic":"ٱلنَّجْمُ ٱلثَّاقِبُ","meaning":"(Karanlığı) Delen yıldızdır.","words":[{"arabic":"ٱلنَّجْمُ","meaning":"yıldızdır"},{"arabic":"ٱلثَّاقِبُ","meaning":"parlayan"}]},{"number":4,"reference":"86:4","arabic":"إِن كُلُّ نَفْسٍ لَّمَّا عَلَيْهَا حَافِظٌ","meaning":"Üzerinde gözetici bulunmayan hiç kimse yoktur.","words":[{"arabic":"إِن","meaning":"yoktur ki"},{"arabic":"كُلُّ","meaning":"hiçbir"},{"arabic":"نَفْسٍۢ","meaning":"can"},{"arabic":"لَّمَّا","meaning":"olmasın"},{"arabic":"عَلَيْهَا","meaning":"başında"},{"arabic":"حَافِظٌۭ","meaning":"bir koruyucu"}]},{"number":5,"reference":"86:5","arabic":"فَلْيَنظُرِ ٱلْإِنسَـٰنُ مِمَّ خُلِقَ","meaning":"Öyleyse, insan neden yaratıldığına bir baksın.","words":[{"arabic":"فَلْيَنظُرِ","meaning":"bir baksın"},{"arabic":"ٱلْإِنسَـٰنُ","meaning":"insan"},{"arabic":"مِمَّ","meaning":"neden"},{"arabic":"خُلِقَ","meaning":"yaratıldığına"}]},{"number":6,"reference":"86:6","arabic":"خُلِقَ مِن مَّآءٍ دَافِقٍ","meaning":"Atılan bir sudan yaratılmıştır.","words":[{"arabic":"خُلِقَ","meaning":"yaratıldı"},{"arabic":"مِن","meaning":"bir sudan"},{"arabic":"مَّآءٍۢ","meaning":""},{"arabic":"دَافِقٍۢ","meaning":"atılan"}]},{"number":7,"reference":"86:7","arabic":"يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ","meaning":"O, bel ile göğüs kemikleri arasından çıkan…","words":[{"arabic":"يَخْرُجُ","meaning":"çıkan"},{"arabic":"مِنۢ","meaning":"arasından"},{"arabic":"بَيْنِ","meaning":""},{"arabic":"ٱلصُّلْبِ","meaning":"bel"},{"arabic":"وَٱلتَّرَآئِبِ","meaning":"ve kaburga kemikleri"}]},{"number":8,"reference":"86:8","arabic":"إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٌ","meaning":"Allah, onu yeniden yaratmaya elbette kadirdir.","words":[{"arabic":"إِنَّهُۥ","meaning":"şüphesiz O"},{"arabic":"عَلَىٰ","meaning":"onu tekrar döndürmeye"},{"arabic":"رَجْعِهِۦ","meaning":""},{"arabic":"لَقَادِرٌۭ","meaning":"elbette kadirdir"}]},{"number":9,"reference":"86:9","arabic":"يَوْمَ تُبْلَى ٱلسَّرَآئِرُ","meaning":"Sırların açığa çıktığı gün.","words":[{"arabic":"يَوْمَ","meaning":"gün"},{"arabic":"تُبْلَى","meaning":"yoklanacağı"},{"arabic":"ٱلسَّرَآئِرُ","meaning":"sırların"}]},{"number":10,"reference":"86:10","arabic":"فَمَا لَهُۥ مِن قُوَّةٍ وَلَا نَاصِرٍ","meaning":"İnsanın bir gücü ve bir yardımcısı yoktur.","words":[{"arabic":"فَمَا","meaning":"yoktur"},{"arabic":"لَهُۥ","meaning":"onun"},{"arabic":"مِن","meaning":"hiçbir"},{"arabic":"قُوَّةٍۢ","meaning":"gücü"},{"arabic":"وَلَا","meaning":"ve ne de"},{"arabic":"نَاصِرٍۢ","meaning":"bir yardımcısı"}]},{"number":11,"reference":"86:11","arabic":"وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ","meaning":"Yağmur yağdıran göğe,","words":[{"arabic":"وَٱلسَّمَآءِ","meaning":"göğe andolsun"},{"arabic":"ذَاتِ","meaning":"dönüşlü"},{"arabic":"ٱلرَّجْعِ","meaning":""}]},{"number":12,"reference":"86:12","arabic":"وَٱلْأَرْضِ ذَاتِ ٱلصَّدْعِ","meaning":"Çatlayan toprağa andolsun ki,","words":[{"arabic":"وَٱلْأَرْضِ","meaning":"ve yere andolsun"},{"arabic":"ذَاتِ","meaning":"çatlayan"},{"arabic":"ٱلصَّدْعِ","meaning":""}]},{"number":13,"reference":"86:13","arabic":"إِنَّهُۥ لَقَوْلٌ فَصْلٌ","meaning":"Kesinlikle o ayırdedici bir sözdür.","words":[{"arabic":"إِنَّهُۥ","meaning":"elbette O"},{"arabic":"لَقَوْلٌۭ","meaning":"muhakkak bir sözdür"},{"arabic":"فَصْلٌۭ","meaning":"ayırdedici"}]},{"number":14,"reference":"86:14","arabic":"وَمَا هُوَ بِٱلْهَزْلِ","meaning":"O, şaka değildir.","words":[{"arabic":"وَمَا","meaning":"ve değildir"},{"arabic":"هُوَ","meaning":"O"},{"arabic":"بِٱلْهَزْلِ","meaning":"şaka"}]},{"number":15,"reference":"86:15","arabic":"إِنَّهُمْ يَكِيدُونَ كَيْدًا","meaning":"Onlar ise tuzak kurup duruyorlar.","words":[{"arabic":"إِنَّهُمْ","meaning":"elbette onlar"},{"arabic":"يَكِيدُونَ","meaning":"kuruyorlar"},{"arabic":"كَيْدًۭا","meaning":"bir tuzak"}]},{"number":16,"reference":"86:16","arabic":"وَأَكِيدُ كَيْدًا","meaning":"Ben de bir tuzak kuruyorum.","words":[{"arabic":"وَأَكِيدُ","meaning":"ben de kuruyorum"},{"arabic":"كَيْدًۭا","meaning":"bir tuzak"}]},{"number":17,"reference":"86:17","arabic":"فَمَهِّلِ ٱلْكَـٰفِرِينَ أَمْهِلْهُمْ رُوَيْدًۢا","meaning":"Kâfirlere mühlet ver, onlara biraz süre tanı!","words":[{"arabic":"فَمَهِّلِ","meaning":"o halde mühlet ver"},{"arabic":"ٱلْكَـٰفِرِينَ","meaning":"kafirlere"},{"arabic":"أَمْهِلْهُمْ","meaning":"kendi hallerine bırak"},{"arabic":"رُوَيْدًۢا","meaning":"birazcık"}]}]}
