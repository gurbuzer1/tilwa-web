se)"},{"arabic":"مَّعْلُومٌۭ","meaning":"belli"}]},{"number":25,"reference":"70:25","arabic":"لِّلسَّآئِلِ وَٱلْمَحْرُومِ","meaning":"İsteyene ve (istemekten utanıp) mahrum kalana.","words":[{"arabic":"لِّلسَّآئِلِ","meaning":"isteyenler için"},{"arabic":"وَٱلْمَحْرُومِ","meaning":"ve mahrumlar için"}]},{"number":26,"reference":"70:26","arabic":"وَٱلَّذِينَ يُصَدِّقُونَ بِيَوْمِ ٱلدِّينِ","meaning":"Onlar hesap gününü tasdik ederler.","words":[{"arabic":"وَٱلَّذِينَ","meaning":"ve"},{"arabic":"يُصَدِّقُونَ","meaning":"tasdik ederler"},{"arabic":"بِيَوْمِ","meaning":"gününü"},{"arabic":"ٱلدِّينِ","meaning":"ceza"}]},{"number":27,"reference":"70:27","arabic":"وَٱلَّذِينَ هُم مِّنْ عَذَابِ رَبِّهِم مُّشْفِقُونَ","meaning":"Rablerinin azabından korkarlar.","words":[{"arabic":"وَٱلَّذِينَ","meaning":"ve"},{"arabic":"هُم","meaning":"onlar"},{"arabic":"مِّنْ","meaning":"azabından"},{"arabic":"عَذَابِ","meaning":""},{"arabic":"رَبِّهِم","meaning":"Rablerinin"},{"arabic":"مُّشْفِقُونَ","meaning":"korkarlar"}]},{"number":28,"reference":"70:28","arabic":"إِنَّ عَذَابَ رَبِّهِمْ غَيْرُ مَأْمُونٍ","meaning":"Gerçekten Rablerinin azabından güvende olunamaz.","words":[{"arabic":"إِنَّ","meaning":"çünkü"},{"arabic":"عَذَابَ","meaning":"azabına"},{"arabic":"رَبِّهِمْ","meaning":"Rablerinin"},{"arabic":"غَيْرُ","meaning":"olmaz"},{"arabic":"مَأْمُونٍۢ","meaning":"güven"}]},{"number":29,"reference":"70:29","arabic":"وَٱلَّذِينَ هُمْ لِفُرُوجِهِمْ حَـٰفِظُونَ","meaning":"Onlar, mahrem yerlerini koruyan kimselerdir.","words":[{"arabic":"وَٱلَّذِينَ","meaning":"ve"},{"arabic":"هُمْ","meaning":"onlar"},{"arabic":"لِفُرُوجِهِمْ","meaning":"ırzlarını"},{"arabic":"حَـٰفِظُونَ","meaning":"korurlar"}]},{"number":30,"reference":"70:30","arabic":"إِلَّا عَلَىٰٓ أَزْوَٰجِهِمْ أَوْ مَا مَلَكَتْ أَيْمَـٰنُهُمْ فَإِنَّهُمْ غَيْرُ مَلُومِينَ","meaning":"Ancak eşlerine ve sahip oldukları cariyelerine karşı müstesna. Çünkü onlar kınanmaz.","words":[{"arabic":"إِلَّا","meaning":"dışındadır"},{"arabic":"عَلَىٰٓ","meaning":"eşleri"},{"arabic":"أَزْوَٰجِهِمْ","meaning":""},{"arabic":"أَوْ","meaning":"ya da"},{"arabic":"مَا","meaning":"altında bulunanlar"},{"arabic":"مَلَكَتْ","meaning":""},{"arabic":"أَيْمَـٰنُهُمْ","meaning":"ellerinin"},{"arabic":"فَإِنَّهُمْ","meaning":"şüphesiz onlar"},{"arabic":"غَيْرُ","meaning":"kınanmazlar"},{"arabic":"مَلُومِينَ","meaning":""}]},{"number":31,"reference":"70:31","arabic":"فَمَنِ ٱبْتَغَىٰ وَرَآءَ ذَٰلِكَ فَأُو۟لَـٰٓئِكَ هُمُ ٱلْعَادُونَ","meaning":"Bundan ötesini arayanlar, işte onlar haddi aşmış olanlardır.","words":[{"arabic":"فَمَنِ","meaning":"ama kim"},{"arabic":"ٱبْتَغَىٰ","meaning":"ararsa"},{"arabic":"وَرَآءَ","meaning":"ötesini"},{"arabic":"ذَٰلِكَ","meaning":"bundan"},{"arabic":"فَأُو۟لَـٰٓئِكَ","meaning":"işte"},{"arabic":"هُمُ","meaning":"onlar"},{"arabic":"ٱلْعَادُونَ","meaning":"(sınırı) aşanlardır"}]},{"number":32,"reference":"70:32","arabic":"وَٱلَّذِينَ هُمْ لِأَمَـٰنَـٰتِهِمْ وَعَهْدِهِمْ رَٰعُونَ","meaning":"Onlar, emanetlerine ve sözlerine riayet ederler","words":[{"arabic":"وَٱلَّذِينَ","meaning":"ve"},{"arabic":"هُمْ","meaning":"onlar"},{"arabic":"لِأَمَـٰنَـٰتِهِمْ","meaning":"emanetlerini"},{"arabic":"وَعَهْدِهِمْ","meaning":"ve ahidlerini"},{"arabic":"رَٰعُونَ","meaning":"gözetirler"}]},{"number":33,"reference":"70:33","arabic":"وَٱلَّذِينَ هُم بِشَهَـٰدَٰتِهِمْ قَآئِمُونَ","meaning":"Onlar, şahitliklerini doğru olarak yerine getirirler.","words":[{"arabic":"وَٱلَّذِينَ","meaning":"ve"},{"arabic":"هُم","meaning":"onlar"},{"arabic":"بِشَهَـٰدَٰتِهِمْ","meaning":"şahidliklerini"},{"arabic":"قَآئِمُونَ","meaning":"yaparlar"}]},{"number":34,"reference":"70:34","arabic":"وَٱلَّذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ يُحَافِظُونَ","meaning":"Onlar, namazlarını muhafaza ederler.","words":[{"arabic":"وَٱلَّذِينَ","meaning":"ve"},{"arabic":"هُمْ","meaning":"onlar"},{"arabic":"عَلَىٰ","meaning":"namazlarını"},{"arabic":"صَلَاتِهِمْ","meaning":""},{"arabic":"يُحَافِظُونَ","meaning":"korurlar"}]},{"number":35,"reference":"70:35","arabic":"أُو۟لَـٰٓئِكَ فِى جَنَّـٰتٍ مُّكْرَمُونَ","meaning":"Onlar, Cennetlerde ikram olunurlar.","words":[{"arabic":"أُو۟لَـٰٓئِكَ","meaning":"işte onlar"},{"arabic":"فِى","meaning":"cennetlerde"},{"arabic":"جَنَّـٰتٍۢ","meaning":""},{"arabic":"مُّكْرَمُونَ","meaning":"ağırlanırlar"}]},{"number":36,"reference":"70:36","arabic":"فَمَالِ ٱلَّذِينَ كَفَرُوا۟ قِبَلَكَ مُهْطِعِينَ","meaning":"(Ey Rasûl!) O kâfirlere ne oluyor ki, sana doğru koşuyorlar?","words":[{"arabic":"فَمَالِ","meaning":"ne oluyor?"},{"arabic":"ٱلَّذِينَ","meaning":"kimselere"},{"arabic":"كَفَرُوا۟","meaning":"inkar eden(lere)"},{"arabic":"قِبَلَكَ","meaning":"sana doğru"},{"arabic":"مُهْطِعِينَ","meaning":"koşuyorlar"}]},{"number":37,"reference":"70:37","arabic":"عَنِ ٱلْيَمِينِ وَعَنِ ٱلشِّمَالِ عِزِينَ","meaning":"Sağdan soldan, bölük bölük gruplar halinde (oturup, seninle konuşuyorlar).","words":[{"arabic":"عَنِ","meaning":"sağdan"},{"arabic":"ٱلْيَمِينِ","meaning":""},{"arabic":"وَعَنِ","meaning":"ve"},{"arabic":"ٱلشِّمَالِ","meaning":"soldan"},{"arabic":"عِزِينَ","meaning":"ayrı ayrı gruplar halinde"}]},{"number":38,"reference":"70:38","arabic":"أَيَطْمَعُ كُلُّ ٱمْرِئٍ مِّنْهُمْ أَن يُدْخَلَ جَنَّةَ نَعِيمٍ","meaning":"Yoksa onların her biri nimet Cennetlerine mi girdirileceğini ümit ediyor?","words":[{"arabic":"أَيَطْمَعُ","meaning":"umuyor mu?"},{"arabic":"كُلُّ","meaning":"her"},{"arabic":"ٱمْرِئٍۢ","meaning":"biri"},{"arabic":"مِّنْهُمْ","meaning":"onlardan"},{"arabic":"أَن","meaning":"sokulacağını"},{"arabic":"يُدْخَلَ","meaning":""},{"arabic":"جَنَّةَ","meaning":"cennetine"},{"arabic":"نَعِيمٍۢ","meaning":"ni'met"}]},{"number":39,"reference":"70:39","arabic":"كَلَّآ ۖ إِنَّا خَلَقْنَـٰهُم مِّمَّا يَعْلَمُونَ","meaning":"Asla! Biz onları bildikleri şeyden yarattık.","words":[{"arabic":"كَلَّآ ۖ","meaning":"hayır"},{"arabic":"إِنَّا","meaning":"elbette biz"},{"arabic":"خَلَقْنَـٰهُم","meaning":"onları yarattık"},{"arabic":"مِّمَّا","meaning":"şeyden"},{"arabic":"يَعْلَمُونَ","meaning":"bildikleri"}]},{"number":40,"reference":"70:40","arabic":"فَلَآ أُقْسِمُ بِرَبِّ ٱلْمَشَـٰرِقِ وَٱلْمَغَـٰرِبِ إِنَّا لَقَـٰدِرُونَ","meaning":"Doğuların ve batıların Rabbine yemin ederim ki gücümüz yeter.","words":[{"arabic":"فَلَآ","meaning":"hayır"},{"arabic":"أُقْسِمُ","meaning":"yemin ederim ki"},{"arabic":"بِرَبِّ","meaning":"Rabbine"},{"arabic":"ٱلْمَشَـٰرِقِ","meaning":"doğuların"},{"arabic":"وَٱلْمَغَـٰرِبِ","meaning":"ve batıların"},{"arabic":"إِنَّا","meaning":"elbette bizim"},{"arabic":"لَقَـٰدِرُونَ","meaning":"gücümüz yeter"}]},{"number":41,"reference":"70:41","arabic":"عَلَىٰٓ أَن نُّبَدِّلَ خَيْرًا مِّنْهُمْ وَمَا نَحْنُ بِمَسْبُوقِينَ","meaning":"Şüphesiz bizim onların yerine daha iyilerini getirmeye... Bizim önümüze de geçilemez.","words":[{"arabic":"عَلَىٰٓ","meaning":"onları değiştirmeğe"},{"arabic":"أَن","meaning":""},{"arabic":"نُّبَدِّلَ","meaning":""},{"arabic":"خَيْرًۭا","meaning":"daha hayırlısıyla"},{"arabic":"مِّنْهُمْ","meaning":"kendilerinden"},{"arabic":"وَمَا","meaning":"ve değil(iz)"},{"arabic":"نَحْنُ","meaning":"biz"},{"arabic":"بِمَسْبُوقِينَ","meaning":"önüne geçilecek"}]},{"number":42,"reference":"70:42","arabic":"فَذَرْهُمْ يَخُوضُوا۟ وَيَلْعَبُوا۟ حَتَّىٰ يُلَـٰقُوا۟ يَوْمَهُمُ ٱلَّذِى يُوعَدُونَ","meaning":"Bırak onları, kendilerine söz verilen gün gelinceye kadar dalıp, oynasınlar!","words":[{"arabic":"فَذَرْهُمْ","meaning":"bırak onları"},{"arabic":"يَخُوضُوا۟","meaning":"dalsınlar"},{"arabic":"وَيَلْعَبُوا۟","meaning":"ve oynasınlar"},{"arabic":"حَتَّىٰ","meaning":"kadar"},{"arabic":"يُلَـٰقُوا۟","meaning":"kavuşuncaya"},{"arabic":"يَوْمَهُمُ","meaning":"günlerine"},{"arabic":"ٱلَّذِى","meaning":"kendilerine va'dedilen"},{"arabic":"يُوعَدُونَ","meaning":""}]},{"number":43,"reference":"70:43","arabic":"يَوْمَ يَخْرُجُونَ مِنَ ٱلْأَجْدَاثِ سِرَاعًا كَأَنَّهُمْ إِلَىٰ نُصُبٍ يُوفِضُونَ","meaning":"O gün onlar, (dünyada) ilahlara/putlara koştukları gibi kabirlerinden koşarak çıkarlar.","words":[{"arabic":"يَوْمَ","meaning":"o gün"},{"arabic":"يَخْرُجُونَ","meaning":"çıkarlar"},{"arabic":"مِنَ","meaning":"kabirlerden"},{"arabic":"ٱلْأَجْدَاثِ","meaning":""},{"arabic":"سِرَاعًۭا","meaning":"hızlı hızlı"},{"arabic":"كَأَنَّهُمْ","meaning":"onlar gibidirler"},{"arabic":"إِلَىٰ","meaning":"doğru"},{"arabic":"نُصُبٍۢ","meaning":"dikilenlere (putlara)"},{"arabic":"يُوفِضُونَ","meaning":"koşuyorlar"}]},{"number":44,"reference":"70:44","arabic":"خَـٰشِعَةً أَبْصَـٰرُهُمْ تَرْهَقُهُمْ ذِلَّةٌ ۚ ذَٰلِكَ ٱلْيَوْمُ ٱلَّذِى كَانُوا۟ يُوعَدُونَ","meaning":"Gözleri yere yıkılmış, (yüzlerini) zillet bürümüş İşte bu, onlara söz verilen gündür!","words":[{"arabic":"خَـٰشِعَةً","meaning":"korkulu"},{"arabic":"أَبْصَـٰرُهُمْ","meaning":"gözleri"},{"arabic":"تَرْهَقُهُمْ","meaning":"onları bürümüş"},{"arabic":"ذِلَّةٌۭ ۚ","meaning":"alçaklık"},{"arabic":"ذَٰلِكَ","meaning":"işte budur"},{"arabic":"ٱلْيَوْمُ","meaning":"gün"},{"arabic":"ٱلَّذِى","meaning":"olan"},{"arabic":"كَانُوا۟","meaning":""},{"arabic":"يُوعَدُونَ","meaning":"onlara va'dedilmiş"}]}]}
