{"number":104,"source":"Kur’an metni ve kelime çözümlemesi: Quran.com · Türkçe meal: Shaban Britch; birleşik dört ayetin ayrımı: Dar Al-Salam Center","verses":[{"number":1,"reference":"104:1","arabic":"وَيْلٌ لِّكُلِّ هُمَزَةٍ لُّمَزَةٍ","meaning":"Arkadan çekiştirip duran, kaş göz hareketleriyle alay eden her kişinin vay haline!","words":[{"arabic":"وَيْلٌۭ","meaning":"vay haline"},{"arabic":"لِّكُلِّ","meaning":"herkesin"},{"arabic":"هُمَزَةٍۢ","meaning":"diliyle çekiştiren"},{"arabic":"لُّمَزَةٍ","meaning":"kaş göz işaretleriyle alay eden"}]},{"number":2,"reference":"104:2","arabic":"ٱلَّذِى جَمَعَ مَالًا وَعَدَّدَهُۥ","meaning":"Mal toplayıp, onu tekrar tekrar sayan,","words":[{"arabic":"ٱلَّذِى","meaning":"o ki"},{"arabic":"جَمَعَ","meaning":"yığdı"},{"arabic":"مَالًۭا","meaning":"mal"},{"arabic":"وَعَدَّدَهُۥ","meaning":"ve onu saydı durdu"}]},{"number":3,"reference":"104:3","arabic":"يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ","meaning":"Zannediyor ki malı kendisini kalıcı kılacak.","words":[{"arabic":"يَحْسَبُ","meaning":"sanıyor"},{"arabic":"أَنَّ","meaning":"muhakkak"},{"arabic":"مَالَهُۥٓ","meaning":"malının"},{"arabic":"أَخْلَدَهُۥ","meaning":"onu ebedi yaşatacağını"}]},{"number":4,"reference":"104:4","arabic":"كَلَّا ۖ لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ","meaning":"Hayır! Kesinlikle o Hutame'ye atılacak.","words":[{"arabic":"كَلَّا ۖ","meaning":"hayır"},{"arabic":"لَيُنۢبَذَنَّ","meaning":"andolsun o atılacaktır"},{"arabic":"فِى","meaning":"Hutame'ye"},{"arabic":"ٱلْحُطَمَةِ","meaning":""}]},{"number":5,"reference":"104:5","arabic":"وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ","meaning":"Hutame nedir?","words":[{"arabic":"وَمَآ","meaning":"nedir?"},{"arabic":"أَدْرَىٰكَ","meaning":"bilir misin?"},{"arabic":"مَا","meaning":"nedir"},{"arabic":"ٱلْحُطَمَةُ","meaning":"Hutame"}]},{"number":6,"reference":"104:6","arabic":"نَارُ ٱللَّهِ ٱلْمُوقَدَةُ","meaning":"Allah’ın tutuşturulmuş ateşidir.","words":[{"arabic":"نَارُ","meaning":"ateşidir"},{"arabic":"ٱللَّهِ","meaning":"Allah'ın"},{"arabic":"ٱلْمُوقَدَةُ","meaning":"tutuşturulmuş"}]},{"number":7,"reference":"104:7","arabic":"ٱلَّتِى تَطَّلِعُ عَلَى ٱلْأَفْـِٔدَةِ","meaning":"Kalplere işleyen,","words":[{"arabic":"ٱلَّتِى","meaning":"ki"},{"arabic":"تَطَّلِعُ","meaning":"işler"},{"arabic":"عَلَى","meaning":"gönüllere"},{"arabic":"ٱلْأَفْـِٔدَةِ","meaning":""}]},{"number":8,"reference":"104:8","arabic":"إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌ","meaning":"O üzerlerine kapatılacak,","words":[{"arabic":"إِنَّهَا","meaning":"şüphesiz o"},{"arabic":"عَلَيْهِم","meaning":"onların üzerine"},{"arabic":"مُّؤْصَدَةٌۭ","meaning":"kapatılıp kilitlenecektir"}]},{"number":9,"reference":"104:9","arabic":"فِى عَمَدٍ مُّمَدَّدَةٍۭ","meaning":"Uzatılmış sütunlar arasında","words":[{"arabic":"فِى","meaning":"arasında"},{"arabic":"عَمَدٍۢ","meaning":"direkler"},{"arabic":"مُّمَدَّدَةٍۭ","meaning":"uzatılmış"}]}]}
