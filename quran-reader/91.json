{"number":91,"source":"Kur’an metni ve kelime çözümlemesi: Quran.com · Türkçe meal: Shaban Britch; birleşik dört ayetin ayrımı: Dar Al-Salam Center","verses":[{"number":1,"reference":"91:1","arabic":"وَٱلشَّمْسِ وَضُحَىٰهَا","meaning":"Andolsun Güneş’e ve aydınlığına,","words":[{"arabic":"وَٱلشَّمْسِ","meaning":"güneşe andolsun"},{"arabic":"وَضُحَىٰهَا","meaning":"ve onun aydın sabahına"}]},{"number":2,"reference":"91:2","arabic":"وَٱلْقَمَرِ إِذَا تَلَىٰهَا","meaning":"Onu takip eden Ay’a,","words":[{"arabic":"وَٱلْقَمَرِ","meaning":"ve aya andolsun"},{"arabic":"إِذَا","meaning":"onu izleyen"},{"arabic":"تَلَىٰهَا","meaning":""}]},{"number":3,"reference":"91:3","arabic":"وَٱلنَّهَارِ إِذَا جَلَّىٰهَا","meaning":"(Yeryüzünü) (ışığıyla) ortaya çıkaran gündüze,","words":[{"arabic":"وَٱلنَّهَارِ","meaning":"ve gündüze andolsun"},{"arabic":"إِذَا","meaning":"onu (güneşi) ortaya çıkaran"},{"arabic":"جَلَّىٰهَا","meaning":""}]},{"number":4,"reference":"91:4","arabic":"وَٱلَّيْلِ إِذَا يَغْشَىٰهَا","meaning":"(Yeryüzünü) örten geceye,","words":[{"arabic":"وَٱلَّيْلِ","meaning":"ve geceye andolsun"},{"arabic":"إِذَا","meaning":"onu örten"},{"arabic":"يَغْشَىٰهَا","meaning":""}]},{"number":5,"reference":"91:5","arabic":"وَٱلسَّمَآءِ وَمَا بَنَىٰهَا","meaning":"Göğe ve onu bina edene,","words":[{"arabic":"وَٱلسَّمَآءِ","meaning":"ve göğe andolsun"},{"arabic":"وَمَا","meaning":"ve"},{"arabic":"بَنَىٰهَا","meaning":"onu yapana"}]},{"number":6,"reference":"91:6","arabic":"وَٱلْأَرْضِ وَمَا طَحَىٰهَا","meaning":"Yere ve onu yayana,","words":[{"arabic":"وَٱلْأَرْضِ","meaning":"ve yere andolsun"},{"arabic":"وَمَا","meaning":"ve"},{"arabic":"طَحَىٰهَا","meaning":"onu yuvarlayıp döşeyene"}]},{"number":7,"reference":"91:7","arabic":"وَنَفْسٍ وَمَا سَوَّىٰهَا","meaning":"Ve nefse ve ona bir düzen içinde biçim verene.","words":[{"arabic":"وَنَفْسٍۢ","meaning":"ve nefse andolsun"},{"arabic":"وَمَا","meaning":"ve"},{"arabic":"سَوَّىٰهَا","meaning":"onu biçimlendirene"}]},{"number":8,"reference":"91:8","arabic":"فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَىٰهَا","meaning":"Sonra da ona kötülüğü ve korunmayı ilham edene.","words":[{"arabic":"فَأَلْهَمَهَا","meaning":"ona ilham edene andolsun"},{"arabic":"فُجُورَهَا","meaning":"bozukluğunu"},{"arabic":"وَتَقْوَىٰهَا","meaning":"ve korunmasını"}]},{"number":9,"reference":"91:9","arabic":"قَدْ أَفْلَحَ مَن زَكَّىٰهَا","meaning":"Ki onu arındıran kurtuluşa ermiştir.","words":[{"arabic":"قَدْ","meaning":"elbette"},{"arabic":"أَفْلَحَ","meaning":"kazanmıştır"},{"arabic":"مَن","meaning":"kimse"},{"arabic":"زَكَّىٰهَا","meaning":"nefsini yücelten"}]},{"number":10,"reference":"91:10","arabic":"وَقَدْ خَابَ مَن دَسَّىٰهَا","meaning":"Onu kötülüğe gömen ise mahvolmuştur.","words":[{"arabic":"وَقَدْ","meaning":"ve elbette"},{"arabic":"خَابَ","meaning":"ziyana uğramıştır"},{"arabic":"مَن","meaning":"kimse"},{"arabic":"دَسَّىٰهَا","meaning":"onu alçaltan"}]},{"number":11,"reference":"91:11","arabic":"كَذَّبَتْ ثَمُودُ بِطَغْوَىٰهَآ","meaning":"Semud azgınlığı sebebiyle yalanladı.","words":[{"arabic":"كَذَّبَتْ","meaning":"yalanladı"},{"arabic":"ثَمُودُ","meaning":"Semud"},{"arabic":"بِطَغْوَىٰهَآ","meaning":"azgınlığı yüzünden"}]},{"number":12,"reference":"91:12","arabic":"إِذِ ٱنۢبَعَثَ أَشْقَىٰهَا","meaning":"En azgınları ileri atılmıştı.","words":[{"arabic":"إِذِ","meaning":"zaman"},{"arabic":"ٱنۢبَعَثَ","meaning":"ayaklandığı"},{"arabic":"أَشْقَىٰهَا","meaning":"en haydutları"}]},{"number":13,"reference":"91:13","arabic":"فَقَالَ لَهُمْ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقْيَـٰهَا","meaning":"Allah'ın Rasûlü onlara: \"Allah'ın devesine ve onun su hakkına dokunmayın!\" dedi.","words":[{"arabic":"فَقَالَ","meaning":"demişti"},{"arabic":"لَهُمْ","meaning":"onlara"},{"arabic":"رَسُولُ","meaning":"elçisi"},{"arabic":"ٱللَّهِ","meaning":"Allah'ın"},{"arabic":"نَاقَةَ","meaning":"devesine"},{"arabic":"ٱللَّهِ","meaning":"Allah'ın"},{"arabic":"وَسُقْيَـٰهَا","meaning":"ve onun su içmesini"}]},{"number":14,"reference":"91:14","arabic":"فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُم بِذَنۢبِهِمْ فَسَوَّىٰهَا","meaning":"O’nu yalanladılar ve deveyi kestiler de Rableri suçları sebebiyle azabı üzerilerine eşit olarak indirdi (kimse kurtulamadı).","words":[{"arabic":"فَكَذَّبُوهُ","meaning":"onu yalanladılar"},{"arabic":"فَعَقَرُوهَا","meaning":"ve onu kestiler"},{"arabic":"فَدَمْدَمَ","meaning":"başlarına geçirdi"},{"arabic":"عَلَيْهِمْ","meaning":"onların"},{"arabic":"رَبُّهُم","meaning":"Rableri"},{"arabic":"بِذَنۢبِهِمْ","meaning":"günahları yüzünden"},{"arabic":"فَسَوَّىٰهَا","meaning":"ve orayı dümdüz etti"}]},{"number":15,"reference":"91:15","arabic":"وَلَا يَخَافُ عُقْبَـٰهَا","meaning":"Bunun sonucundan da korkmaz.","words":[{"arabic":"وَلَا","meaning":"ve"},{"arabic":"يَخَافُ","meaning":"(Rab) korkmaz"},{"arabic":"عُقْبَـٰهَا","meaning":"bu işin sonundan"}]}]}
