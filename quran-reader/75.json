{"number":75,"source":"Kur’an metni ve kelime çözümlemesi: Quran.com · Türkçe meal: Shaban Britch; birleşik dört ayetin ayrımı: Dar Al-Salam Center","verses":[{"number":1,"reference":"75:1","arabic":"لَآ أُقْسِمُ بِيَوْمِ ٱلْقِيَـٰمَةِ","meaning":"Yemin olsun kıyamet gününe.","words":[{"arabic":"لَآ","meaning":"hayır"},{"arabic":"أُقْسِمُ","meaning":"and içerim"},{"arabic":"بِيَوْمِ","meaning":"gününe"},{"arabic":"ٱلْقِيَـٰمَةِ","meaning":"kıyamet"}]},{"number":2,"reference":"75:2","arabic":"وَلَآ أُقْسِمُ بِٱلنَّفْسِ ٱللَّوَّامَةِ","meaning":"Yemin olsun kendini kınayan nefse.","words":[{"arabic":"وَلَآ","meaning":"yine hayır"},{"arabic":"أُقْسِمُ","meaning":"and içerim"},{"arabic":"بِٱلنَّفْسِ","meaning":"nefse"},{"arabic":"ٱللَّوَّامَةِ","meaning":"daima kendini kınayan"}]},{"number":3,"reference":"75:3","arabic":"أَيَحْسَبُ ٱلْإِنسَـٰنُ أَلَّن نَّجْمَعَ عِظَامَهُۥ","meaning":"İnsan, kemiklerini bir araya getiremeyeceğimizi mi sanıyor?","words":[{"arabic":"أَيَحْسَبُ","meaning":"-mı sanıyor?"},{"arabic":"ٱلْإِنسَـٰنُ","meaning":"insan"},{"arabic":"أَلَّن","meaning":"bir araya toplamayacağımızı"},{"arabic":"نَّجْمَعَ","meaning":""},{"arabic":"عِظَامَهُۥ","meaning":"kendisinin kemiklerini"}]},{"number":4,"reference":"75:4","arabic":"بَلَىٰ قَـٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّىَ بَنَانَهُۥ","meaning":"Evet, onun parmak uçlarını bile yaratıp, düzenlemeye gücümüz yeter.","words":[{"arabic":"بَلَىٰ","meaning":"evet"},{"arabic":"قَـٰدِرِينَ","meaning":"gücümüz yeter"},{"arabic":"عَلَىٰٓ","meaning":"düzenlemeğe"},{"arabic":"أَن","meaning":""},{"arabic":"نُّسَوِّىَ","meaning":""},{"arabic":"بَنَانَهُۥ","meaning":"onun parmak uçlarnı"}]},{"number":5,"reference":"75:5","arabic":"بَلْ يُرِيدُ ٱلْإِنسَـٰنُ لِيَفْجُرَ أَمَامَهُۥ","meaning":"Oysa, insan önündekini yalanlamak ister de.","words":[{"arabic":"بَلْ","meaning":"fakat"},{"arabic":"يُرِيدُ","meaning":"ister"},{"arabic":"ٱلْإِنسَـٰنُ","meaning":"insan"},{"arabic":"لِيَفْجُرَ","meaning":"yalanlamak"},{"arabic":"أَمَامَهُۥ","meaning":"ilerisini (kıyameti)"}]},{"number":6,"reference":"75:6","arabic":"يَسْـَٔلُ أَيَّانَ يَوْمُ ٱلْقِيَـٰمَةِ","meaning":"Kıyamet günü ne zaman? diye sorar.","words":[{"arabic":"يَسْـَٔلُ","meaning":"sorup durur"},{"arabic":"أَيَّانَ","meaning":"nerede?"},{"arabic":"يَوْمُ","meaning":"günü"},{"arabic":"ٱلْقِيَـٰمَةِ","meaning":"kıyamet"}]},{"number":7,"reference":"75:7","arabic":"فَإِذَا بَرِقَ ٱلْبَصَرُ","meaning":"Göz dehşetlekamaştığı zaman","words":[{"arabic":"فَإِذَا","meaning":"zaman"},{"arabic":"بَرِقَ","meaning":"kamaştığı"},{"arabic":"ٱلْبَصَرُ","meaning":"göz"}]},{"number":8,"reference":"75:8","arabic":"وَخَسَفَ ٱلْقَمَرُ","meaning":"Ay tutulduğu;","words":[{"arabic":"وَخَسَفَ","meaning":"ve tutulduğu"},{"arabic":"ٱلْقَمَرُ","meaning":"ay"}]},{"number":9,"reference":"75:9","arabic":"وَجُمِعَ ٱلشَّمْسُ وَٱلْقَمَرُ","meaning":"Güneş ve Ay bir araya getirildiği zaman;","words":[{"arabic":"وَجُمِعَ","meaning":"ve bir araya toplandığı"},{"arabic":"ٱلشَّمْسُ","meaning":"güneş"},{"arabic":"وَٱلْقَمَرُ","meaning":"ve ay"}]},{"number":10,"reference":"75:10","arabic":"يَقُولُ ٱلْإِنسَـٰنُ يَوْمَئِذٍ أَيْنَ ٱلْمَفَرُّ","meaning":"(O gün) insan: Bugün kaçacak yer nerede? der.","words":[{"arabic":"يَقُولُ","meaning":"der"},{"arabic":"ٱلْإِنسَـٰنُ","meaning":"insan"},{"arabic":"يَوْمَئِذٍ","meaning":"o gün"},{"arabic":"أَيْنَ","meaning":"neresidir?"},{"arabic":"ٱلْمَفَرُّ","meaning":"kaçacak yer"}]},{"number":11,"reference":"75:11","arabic":"كَلَّا لَا وَزَرَ","meaning":"Hayır! Asla kaçacak bir yer yoktur.","words":[{"arabic":"كَلَّا","meaning":"hayır"},{"arabic":"لَا","meaning":"yoktur"},{"arabic":"وَزَرَ","meaning":"sığınacak yer"}]},{"number":12,"reference":"75:12","arabic":"إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمُسْتَقَرُّ","meaning":"O gün varıp durulacak yer, sadece Rabbinin katıdır.","words":[{"arabic":"إِلَىٰ","meaning":"Rabbinin"},{"arabic":"رَبِّكَ","meaning":"o gün"},{"arabic":"يَوْمَئِذٍ","meaning":""},{"arabic":"ٱلْمُسْتَقَرُّ","meaning":"varıp durulacak yer"}]},{"number":13,"reference":"75:13","arabic":"يُنَبَّؤُا۟ ٱلْإِنسَـٰنُ يَوْمَئِذٍۭ بِمَا قَدَّمَ وَأَخَّرَ","meaning":"O gün insana, ileri götürdüğü ve geri bıraktığı ne varsa bildirilir.","words":[{"arabic":"يُنَبَّؤُا۟","meaning":"haber verilir"},{"arabic":"ٱلْإِنسَـٰنُ","meaning":"insanın"},{"arabic":"يَوْمَئِذٍۭ","meaning":"o gün"},{"arabic":"بِمَا","meaning":"şeyler"},{"arabic":"قَدَّمَ","meaning":"yapıp öne sürdüğü"},{"arabic":"وَأَخَّرَ","meaning":"ve geri bıraktığı"}]},{"number":14,"reference":"75:14","arabic":"بَلِ ٱلْإِنسَـٰنُ عَلَىٰ نَفْسِهِۦ بَصِيرَةٌ","meaning":"Doğrusu insan kendi şahsı aleyhine bir hüccettir.","words":[{"arabic":"بَلِ","meaning":"doğrusu"},{"arabic":"ٱلْإِنسَـٰنُ","meaning":"insan"},{"arabic":"عَلَىٰ","meaning":"kendi nefsini"},{"arabic":"نَفْسِهِۦ","meaning":""},{"arabic":"بَصِيرَةٌۭ","meaning":"görür"}]},{"number":15,"reference":"75:15","arabic":"وَلَوْ أَلْقَىٰ مَعَاذِيرَهُۥ","meaning":"İsterse özür beyan etsin.","words":[{"arabic":"وَلَوْ","meaning":"ve şayet"},{"arabic":"أَلْقَىٰ","meaning":"ortaya atsa (da)"},{"arabic":"مَعَاذِيرَهُۥ","meaning":"özürler"}]},{"number":16,"reference":"75:16","arabic":"لَا تُحَرِّكْ بِهِۦ لِسَانَكَ لِتَعْجَلَ بِهِۦٓ","meaning":"Onu (vahyi) çarçabuk almak için dilini kımıldatma.","words":[{"arabic":"لَا","meaning":"depretme"},{"arabic":"تُحَرِّكْ","meaning":""},{"arabic":"بِهِۦ","meaning":"onu"},{"arabic":"لِسَانَكَ","meaning":"diline"},{"arabic":"لِتَعْجَلَ","meaning":"okumak için"},{"arabic":"بِهِۦٓ","meaning":"onu"}]},{"number":17,"reference":"75:17","arabic":"إِنَّ عَلَيْنَا جَمْعَهُۥ وَقُرْءَانَهُۥ","meaning":"Hiç şüphesiz onu (kalbinde) toplamak ve onu (diline salarak) okumak bize aittir.","words":[{"arabic":"إِنَّ","meaning":"şüphesiz"},{"arabic":"عَلَيْنَا","meaning":"bize düşer"},{"arabic":"جَمْعَهُۥ","meaning":"onu toplamak"},{"arabic":"وَقُرْءَانَهُۥ","meaning":"ve okumak"}]},{"number":18,"reference":"75:18","arabic":"فَإِذَا قَرَأْنَـٰهُ فَٱتَّبِعْ قُرْءَانَهُۥ","meaning":"Onu okuduğumuz zaman onun okunuşuna tabi ol.","words":[{"arabic":"فَإِذَا","meaning":"zaman"},{"arabic":"قَرَأْنَـٰهُ","meaning":"O'nu okuduğumuz"},{"arabic":"فَٱتَّبِعْ","meaning":"izle"},{"arabic":"قُرْءَانَهُۥ","meaning":"onun okunuşunu"}]},{"number":19,"reference":"75:19","arabic":"ثُمَّ إِنَّ عَلَيْنَا بَيَانَهُۥ","meaning":"Sonra onu açıklamak yine bize aittir.","words":[{"arabic":"ثُمَّ","meaning":"sonra"},{"arabic":"إِنَّ","meaning":"şüphesiz"},{"arabic":"عَلَيْنَا","meaning":"bize düşer"},{"arabic":"بَيَانَهُۥ","meaning":"onu açıklamak"}]},{"number":20,"reference":"75:20","arabic":"كَلَّا بَلْ تُحِبُّونَ ٱلْعَاجِلَةَ","meaning":"Hayır! Siz, acil olanı/dünyayı seviyorsunuz.","words":[{"arabic":"كَلَّا","meaning":"hayır"},{"arabic":"بَلْ","meaning":"bilakis"},{"arabic":"تُحِبُّونَ","meaning":"siz seviyorsunuz"},{"arabic":"ٱلْعَاجِلَةَ","meaning":"çarçabuk geçeni"}]},{"number":21,"reference":"75:21","arabic":"وَتَذَرُونَ ٱلْـَٔاخِرَةَ","meaning":"Ahireti bırakıyorsunuz.","words":[{"arabic":"وَتَذَرُونَ","meaning":"ve bırakıyorsunuz"},{"arabic":"ٱلْـَٔاخِرَةَ","meaning":"ahireti"}]},{"number":22,"reference":"75:22","arabic":"وُجُوهٌ يَوْمَئِذٍ نَّاضِرَةٌ","meaning":"O gün, parıldayan yüzler vardır.","words":[{"arabic":"وُجُوهٌۭ","meaning":"yüzler vardır"},{"arabic":"يَوْمَئِذٍۢ","meaning":"o gün"},{"arabic":"نَّاضِرَةٌ","meaning":"ışıl ışıl parlar"}]},{"number":23,"reference":"75:23","arabic":"إِلَىٰ رَبِّهَا نَاظِرَةٌ","meaning":"Rabbine bakar.","words":[{"arabic":"إِلَىٰ","meaning":"Rabbine"},{"arabic":"رَبِّهَا","meaning":""},{"arabic":"نَاظِرَةٌۭ","meaning":"bakar"}]},{"number":24,"reference":"75:24","arabic":"وَوُجُوهٌ يَوْمَئِذٍۭ بَاسِرَةٌ","meaning":"O gün asık yüzler de vardır.","words":[{"arabic":"وَوُجُوهٌۭ","meaning":"ve yüzler vardır"},{"arabic":"يَوْمَئِذٍۭ","meaning":"o gün"},{"arabic":"بَاسِرَةٌۭ","meaning":"asıktır"}]},{"number":25,"reference":"75:25","arabic":"تَظُنُّ أَن يُفْعَلَ بِهَا فَاقِرَةٌ","meaning":"Bellerini bükecek bir felakete uğrayacağını anlayacak.","words":[{"arabic":"تَظُنُّ","meaning":"anlar"},{"arabic":"أَن","meaning":"yapılacağını"},{"arabic":"يُفْعَلَ","meaning":""},{"arabic":"بِهَا","meaning":"kendisine"},{"arabic":"فَاقِرَةٌۭ","meaning":"belini kıran(bela)nın"}]},{"number":26,"reference":"75:26","arabic":"كَلَّآ إِذَا بَلَغَتِ ٱلتَّرَاقِىَ","meaning":"Hayır! Ruh köprücük kemiğine dayanmış.","words":[{"arabic":"كَلَّآ","meaning":"hayır"},{"arabic":"إِذَا","meaning":"ne zaman ki"},{"arabic":"بَلَغَتِ","meaning":"(can) dayanır"},{"arabic":"ٱلتَّرَاقِىَ","meaning":"köprücük kemiklerine"}]},{"number":27,"reference":"75:27","arabic":"وَقِيلَ مَنْ ۜ رَاقٍ","meaning":"Yok mu okuyup (şifa isteyen)? denmiş.","words":[{"arabic":"وَقِيلَ","meaning":"ve denir"},{"arabic":"مَنْ ۜ","meaning":"kim?"},{"arabic":"رَاقٍۢ","meaning":"efsun yapar"}]},{"number":28,"reference":"75:28","arabic":"وَظَنَّ أَنَّهُ ٱلْفِرَاقُ","meaning":"Anlar ki, bu bir ayrılış.","words":[{"arabic":"وَظَنَّ","meaning":"ve anlar"},{"arabic":"أَنَّهُ","meaning":"bunun"},{"arabic":"ٱلْفِرَاقُ","meaning":"ayrılık zamanı olduğunu"}]},{"number":29,"reference":"75:29","arabic":"وَٱلْتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ","meaning":"Bacakları birbirine dolaşmıştır.","words":[{"arabic":"وَٱلْتَفَّتِ","meaning":"ve dolaşır"},{"arabic":"ٱلسَّاقُ","meaning":"bacak"},{"arabic":"بِٱلسَّاقِ","meaning":"bacağa"}]},{"number":30,"reference":"75:30","arabic":"إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمَسَاقُ","meaning":"O gün sevk, Rabbinedir.","words":[{"arabic":"إِلَىٰ","meaning":"Rabbinedir"},{"arabic":"رَبِّكَ","meaning":""},{"arabic":"يَوْمَئِذٍ","meaning":"o gün"},{"arabic":"ٱلْمَسَاقُ","meaning":"sevk"}]},{"number":31,"reference":"75:31","arabic":"فَلَا صَدَّقَ وَلَا صَلَّىٰ","meaning":"Tasdik etmemiş, namaz kılmamış.","words":[{"arabic":"فَلَا","meaning":"sadaka vermedi"},{"arabic":"صَدَّقَ","meaning":""},{"arabic":"وَلَا","meaning":"ve"},{"arabic":"صَلَّىٰ","meaning":"namaz da kılmadı"}]},{"number":32,"reference":"75:32","arabic":"وَلَـٰكِن كَذَّبَ وَتَوَلَّىٰ","meaning":"Fakat yalanlamış, yüz çevirmiş.","words":[{"arabic":"وَلَـٰكِن","meaning":"fakat"},{"arabic":"كَذَّبَ","meaning":"yalanladı"},{"arabic":"وَتَوَلَّىٰ","meaning":"ve döndü"}]},{"number":33,"reference":"75:33","arabic":"ثُمَّ ذَهَبَ إِلَىٰٓ أَهْلِهِۦ يَتَمَطَّىٰٓ","meaning":"Sonra da çalım satarak ailesine gitmişti,","words":[{"arabic":"ثُمَّ","meaning":"sonra"},{"arabic":"ذَهَبَ","meaning":"gitti"},{"arabic":"إِلَىٰٓ","meaning":"ailesine"},{"arabic":"أَهْلِهِۦ","meaning":""},{"arabic":"يَتَمَطَّىٰٓ","meaning":"çalım satarak"}]},{"number":34,"reference":"75:34","arabic":"أَوْلَىٰ لَكَ فَأَوْلَىٰ","meaning":"Helak olsun sana helak.","words":[{"arabic":"أَوْلَىٰ","meaning":"yazık"},{"arabic":"لَكَ","meaning":"sana"},{"arabic":"فَأَوْلَىٰ","meaning":"yazık"}]},{"number":35,"reference":"75:35","arabic":"ثُمَّ أَوْلَىٰ لَكَ فَأَوْلَىٰٓ","meaning":"Sonra sen buna layıksın!","words":[{"arabic":"ثُمَّ","meaning":"yine"},{"arabic":"أَوْلَىٰ","meaning":"yazık"},{"arabic":"لَكَ","meaning":"sana"},{"arabic":"فَأَوْلَىٰٓ","meaning":"yazık"}]},{"number":36,"reference":"75:36","arabic":"أَيَحْسَبُ ٱلْإِنسَـٰنُ أَن يُتْرَكَ سُدًى","meaning":"İnsan kendisini başı boş bırakılacağını mı sanar?","words":[{"arabic":"أَيَحْسَبُ","meaning":"sanıyor mu?"},{"arabic":"ٱلْإِنسَـٰنُ","meaning":"insan"},{"arabic":"أَن","meaning":"bırakılacağını"},{"arabic":"يُتْرَكَ","meaning":""},{"arabic":"سُدًى","meaning":"başı boş"}]},{"number":37,"reference":"75:37","arabic":"أَلَمْ يَكُ نُطْفَةً مِّن مَّنِىٍّ يُمْنَىٰ","meaning":"O, akıtılan bir meni damlası değil miydi?","words":[{"arabic":"أَلَمْ","meaning":"değil miydi?"},{"arabic":"يَكُ","meaning":"kendisi"},{"arabic":"نُطْفَةًۭ","meaning":"bir nutfe (sperm)"},{"arabic":"مِّن","meaning":"meniden"},{"arabic":"مَّنِىٍّۢ","meaning":""},{"arabic":"يُمْنَىٰ","meaning":"dökülen"}]},{"number":38,"reference":"75:38","arabic":"ثُمَّ كَانَ عَلَقَةً فَخَلَقَ فَسَوَّىٰ","meaning":"Sonra “alaka” olmuş, Allah, onu yaratmış ve düzenlemişti.","words":[{"arabic":"ثُمَّ","meaning":"sonra"},{"arabic":"كَانَ","meaning":"oldu"},{"arabic":"عَلَقَةًۭ","meaning":"alaka (embriyo)"},{"arabic":"فَخَلَقَ","meaning":"ve yarattı"},{"arabic":"فَسَوَّىٰ","meaning":"ve düzenledi"}]},{"number":39,"reference":"75:39","arabic":"فَجَعَلَ مِنْهُ ٱلزَّوْجَيْنِ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ","meaning":"Ondan da iki eşi, erkek ve dişiyi var etmişti.","words":[{"arabic":"فَجَعَلَ","meaning":"ve var etti"},{"arabic":"مِنْهُ","meaning":"ondan"},{"arabic":"ٱلزَّوْجَيْنِ","meaning":"iki çifti"},{"arabic":"ٱلذَّكَرَ","meaning":"erkeği"},{"arabic":"وَٱلْأُنثَىٰٓ","meaning":"ve dişiyi"}]},{"number":40,"reference":"75:40","arabic":"أَلَيْسَ ذَٰلِكَ بِقَـٰدِرٍ عَلَىٰٓ أَن يُحْـِۧىَ ٱلْمَوْتَىٰ","meaning":"Bunu yapanın ölüleri diriltmeye gücü yetmez mi?","words":[{"arabic":"أَلَيْسَ","meaning":"değil mi?"},{"arabic":"ذَٰلِكَ","meaning":"buna"},{"arabic":"بِقَـٰدِرٍ","meaning":"gücü yetecek"},{"arabic":"عَلَىٰٓ","meaning":"diriltmeğe"},{"arabic":"أَن","meaning":""},{"arabic":"يُحْـِۧىَ","meaning":""},{"arabic":"ٱلْمَوْتَىٰ","meaning":"ölüleri"}]}]}
