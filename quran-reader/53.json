meaning":"ve 'Uzza'yı"}]},{"number":20,"reference":"53:20","arabic":"وَمَنَوٰةَ ٱلثَّالِثَةَ ٱلْأُخْرَىٰٓ","meaning":"Diğer bir üçüncüsü Menat’ı?","words":[{"arabic":"وَمَنَوٰةَ","meaning":"ve Menat'ı?"},{"arabic":"ٱلثَّالِثَةَ","meaning":"üçüncüsünü"},{"arabic":"ٱلْأُخْرَىٰٓ","meaning":"öteki"}]},{"number":21,"reference":"53:21","arabic":"أَلَكُمُ ٱلذَّكَرُ وَلَهُ ٱلْأُنثَىٰ","meaning":"Erkekler sizin, dişiler O’nun mu?","words":[{"arabic":"أَلَكُمُ","meaning":"size midir?"},{"arabic":"ٱلذَّكَرُ","meaning":"erkek"},{"arabic":"وَلَهُ","meaning":"ve O'na"},{"arabic":"ٱلْأُنثَىٰ","meaning":"kadın"}]},{"number":22,"reference":"53:22","arabic":"تِلْكَ إِذًا قِسْمَةٌ ضِيزَىٰٓ","meaning":"Öyleyse bu haksız bir taksim.","words":[{"arabic":"تِلْكَ","meaning":"bu"},{"arabic":"إِذًۭا","meaning":"o halde"},{"arabic":"قِسْمَةٌۭ","meaning":"bir taksimdir"},{"arabic":"ضِيزَىٰٓ","meaning":"insafsızca"}]},{"number":23,"reference":"53:23","arabic":"إِنْ هِىَ إِلَّآ أَسْمَآءٌ سَمَّيْتُمُوهَآ أَنتُمْ وَءَابَآؤُكُم مَّآ أَنزَلَ ٱللَّهُ بِهَا مِن سُلْطَـٰنٍ ۚ إِن يَتَّبِعُونَ إِلَّا ٱلظَّنَّ وَمَا تَهْوَى ٱلْأَنفُسُ ۖ وَلَقَدْ جَآءَهُم مِّن رَّبِّهِمُ ٱلْهُدَىٰٓ","meaning":"Onlar, sizin ve atalarınızın adlandırılmasından başka bir şey değildir. Allah, onlar hakkında bir delil indirmemiştir. Onlar ancak zanna ve nefislerinin arzusuna uyuyorlar. Oysa, onlara Rablerinden hidayet gelmiştir.","words":[{"arabic":"إِنْ","meaning":"değildir"},{"arabic":"هِىَ","meaning":"onlar"},{"arabic":"إِلَّآ","meaning":"başka bir şey"},{"arabic":"أَسْمَآءٌۭ","meaning":"isimler(den)"},{"arabic":"سَمَّيْتُمُوهَآ","meaning":"isimlendirdiğiniz"},{"arabic":"أَنتُمْ","meaning":"sizin"},{"arabic":"وَءَابَآؤُكُم","meaning":"ve babalarınızın"},{"arabic":"مَّآ","meaning":"indirmemiştir"},{"arabic":"أَنزَلَ","meaning":""},{"arabic":"ٱللَّهُ","meaning":"Allah"},{"arabic":"بِهَا","meaning":"onlara"},{"arabic":"مِن","meaning":"hiçbir"},{"arabic":"سُلْطَـٰنٍ ۚ","meaning":"güç"},{"arabic":"إِن","meaning":"hayır"},{"arabic":"يَتَّبِعُونَ","meaning":"onlar uyuyorlar"},{"arabic":"إِلَّا","meaning":"ancak"},{"arabic":"ٱلظَّنَّ","meaning":"zanna"},{"arabic":"وَمَا","meaning":"ve"},{"arabic":"تَهْوَى","meaning":"hevesine"},{"arabic":"ٱلْأَنفُسُ ۖ","meaning":"nefislerin"},{"arabic":"وَلَقَدْ","meaning":"oysa"},{"arabic":"جَآءَهُم","meaning":"kendilerine gelmiştir"},{"arabic":"مِّن","meaning":"tarafından"},{"arabic":"رَّبِّهِمُ","meaning":"Rableri"},{"arabic":"ٱلْهُدَىٰٓ","meaning":"yol gösterici"}]},{"number":24,"reference":"53:24","arabic":"أَمْ لِلْإِنسَـٰنِ مَا تَمَنَّىٰ","meaning":"Yoksa insana her arzu edip istediği şey mi var?","words":[{"arabic":"أَمْ","meaning":"yoksa"},{"arabic":"لِلْإِنسَـٰنِ","meaning":"insan için midir?"},{"arabic":"مَا","meaning":"her"},{"arabic":"تَمَنَّىٰ","meaning":"arzu ettiği"}]},{"number":25,"reference":"53:25","arabic":"فَلِلَّهِ ٱلْـَٔاخِرَةُ وَٱلْأُولَىٰ","meaning":"Ahiret de dünya da Allah’ındır.","words":[{"arabic":"فَلِلَّهِ","meaning":"Allah'ındır"},{"arabic":"ٱلْـَٔاخِرَةُ","meaning":"son (ahiret)"},{"arabic":"وَٱلْأُولَىٰ","meaning":"ve ilk (dünya)"}]},{"number":26,"reference":"53:26","arabic":"۞ وَكَم مِّن مَّلَكٍ فِى ٱلسَّمَـٰوَٰتِ لَا تُغْنِى شَفَـٰعَتُهُمْ شَيْـًٔا إِلَّا مِنۢ بَعْدِ أَن يَأْذَنَ ٱللَّهُ لِمَن يَشَآءُ وَيَرْضَىٰٓ","meaning":"Göklerde nice melekler var ki, Allah dilediği ve razı olduğu kimseler için izin vermedikçe, onların şefaatı hiçbir fayda vermez","words":[{"arabic":"۞ وَكَم","meaning":"nicesi var ki"},{"arabic":"مِّن","meaning":"melek(ler)den"},{"arabic":"مَّلَكٍۢ","meaning":""},{"arabic":"فِى","meaning":"göklerde"},{"arabic":"ٱلسَّمَـٰوَٰتِ","meaning":""},{"arabic":"لَا","meaning":"işe yaramaz"},{"arabic":"تُغْنِى","meaning":""},{"arabic":"شَفَـٰعَتُهُمْ","meaning":"onların şefa'ati"},{"arabic":"شَيْـًٔا","meaning":"hiçbir"},{"arabic":"إِلَّا","meaning":"dışında"},{"arabic":"مِنۢ","meaning":"sonrası"},{"arabic":"بَعْدِ","meaning":""},{"arabic":"أَن","meaning":"izin vermesinden"},{"arabic":"يَأْذَنَ","meaning":""},{"arabic":"ٱللَّهُ","meaning":"Allah'ın"},{"arabic":"لِمَن","meaning":"kimseye"},{"arabic":"يَشَآءُ","meaning":"dilediği"},{"arabic":"وَيَرْضَىٰٓ","meaning":"ve razı olduğu"}]},{"number":27,"reference":"53:27","arabic":"إِنَّ ٱلَّذِينَ لَا يُؤْمِنُونَ بِٱلْـَٔاخِرَةِ لَيُسَمُّونَ ٱلْمَلَـٰٓئِكَةَ تَسْمِيَةَ ٱلْأُنثَىٰ","meaning":"Doğrusu ahirete iman etmeyenler melekleri dişi olarak isimlendiriyorlar.","words":[{"arabic":"إِنَّ","meaning":"şüphesiz"},{"arabic":"ٱلَّذِينَ","meaning":"kimseler"},{"arabic":"لَا","meaning":"inanmayan(lar)"},{"arabic":"يُؤْمِنُونَ","meaning":""},{"arabic":"بِٱلْـَٔاخِرَةِ","meaning":"ahirete"},{"arabic":"لَيُسَمُّونَ","meaning":"adlandırıyorlar"},{"arabic":"ٱلْمَلَـٰٓئِكَةَ","meaning":"meleklere"},{"arabic":"تَسْمِيَةَ","meaning":"adlarını"},{"arabic":"ٱلْأُنثَىٰ","meaning":"dişilerin"}]},{"number":28,"reference":"53:28","arabic":"وَمَا لَهُم بِهِۦ مِنْ عِلْمٍ ۖ إِن يَتَّبِعُونَ إِلَّا ٱلظَّنَّ ۖ وَإِنَّ ٱلظَّنَّ لَا يُغْنِى مِنَ ٱلْحَقِّ شَيْـًٔا","meaning":"Oysa, bu konuda bir bilgileri yoktur. Sadece zanna tâbi oluyorlar. Zan ise hiç şüphesiz hakikat bakımından bir şey ifade etmez.","words":[{"arabic":"وَمَا","meaning":"ve yoktur"},{"arabic":"لَهُم","meaning":"onların"},{"arabic":"بِهِۦ","meaning":"bu hususta"},{"arabic":"مِنْ","meaning":"hiçbir"},{"arabic":"عِلْمٍ ۖ","meaning":"bilgileri"},{"arabic":"إِن","meaning":"hayır"},{"arabic":"يَتَّبِعُونَ","meaning":"onlar uyuyorlar"},{"arabic":"إِلَّا","meaning":"sadece"},{"arabic":"ٱلظَّنَّ ۖ","meaning":"zanna"},{"arabic":"وَإِنَّ","meaning":"ve elbette"},{"arabic":"ٱلظَّنَّ","meaning":"zan"},{"arabic":"لَا","meaning":"kazandırmaz"},{"arabic":"يُغْنِى","meaning":""},{"arabic":"مِنَ","meaning":"yana"},{"arabic":"ٱلْحَقِّ","meaning":"hak(tan)"},{"arabic":"شَيْـًۭٔا","meaning":"hiçbir şey"}]},{"number":29,"reference":"53:29","arabic":"فَأَعْرِضْ عَن مَّن تَوَلَّىٰ عَن ذِكْرِنَا وَلَمْ يُرِدْ إِلَّا ٱلْحَيَوٰةَ ٱلدُّنْيَا","meaning":"Bu sebeple sen, zikrimizden/Kur'an'dan yüz çevirenden ve dünya hayatından başka bir şey istemeyenden uzak dur.","words":[{"arabic":"فَأَعْرِضْ","meaning":"o halde yüz çevir"},{"arabic":"عَن","meaning":"kimseden"},{"arabic":"مَّن","meaning":""},{"arabic":"تَوَلَّىٰ","meaning":"yüz çeviren"},{"arabic":"عَن","meaning":"bizi anmaktan"},{"arabic":"ذِكْرِنَا","meaning":""},{"arabic":"وَلَمْ","meaning":"ve"},{"arabic":"يُرِدْ","meaning":"istemeyen"},{"arabic":"إِلَّا","meaning":"başka bir şey"},{"arabic":"ٱلْحَيَوٰةَ","meaning":"hayatından"},{"arabic":"ٱلدُّنْيَا","meaning":"dünya"}]},{"number":30,"reference":"53:30","arabic":"ذَٰلِكَ مَبْلَغُهُم مِّنَ ٱلْعِلْمِ ۚ إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِمَن ضَلَّ عَن سَبِيلِهِۦ وَهُوَ أَعْلَمُ بِمَنِ ٱهْتَدَىٰ","meaning":"İşte onların erişebilecekleri ilim budur. Şüphesiz Rabbin, kimin yolundan saptığını en iyi bilendir. Kimin hidayet üzere olduğunu da en iyi bilen O’dur.","words":[{"arabic":"ذَٰلِكَ","meaning":"işte budur"},{"arabic":"مَبْلَغُهُم","meaning":"onların erişebilecekleri"},{"arabic":"مِّنَ","meaning":"bilgiden"},{"arabic":"ٱلْعِلْمِ ۚ","meaning":""},{"arabic":"إِنَّ","meaning":"şüphesiz"},{"arabic":"رَبَّكَ","meaning":"Rabbin"},{"arabic":"هُوَ","meaning":"O"},{"arabic":"أَعْلَمُ","meaning":"iyi bilir"},{"arabic":"بِمَن","meaning":"kimseyi"},{"arabic":"ضَلَّ","meaning":"sapan"},{"arabic":"عَن","meaning":"yolundan"},{"arabic":"سَبِيلِهِۦ","meaning":""},{"arabic":"وَهُوَ","meaning":"ve O"},{"arabic":"أَعْلَمُ","meaning":"iyi bilir"},{"arabic":"بِمَنِ","meaning":"kimseyi"},{"arabic":"ٱهْتَدَىٰ","meaning":"yola gelen"}]},{"number":31,"reference":"53:31","arabic":"وَلِلَّهِ مَا فِى ٱلسَّمَـٰوَٰتِ وَمَا فِى ٱلْأَرْضِ لِيَجْزِىَ ٱلَّذِينَ أَسَـٰٓـُٔوا۟ بِمَا عَمِلُوا۟ وَيَجْزِىَ ٱلَّذِينَ أَحْسَنُوا۟ بِٱلْحُسْنَى","meaning":"Göklerde olan da yerde olan da Allah’ındır. Kötülük işleyenleri yaptıkları sebebiyle cezalandıracak, iyilik edenleri de en iyisi ile ödüllendirecektir.","words":[{"arabic":"وَلِلَّهِ","meaning":"Allah'ındır"},{"arabic":"مَا","meaning":"herşey"},{"arabic":"فِى","meaning":"bulunan"},{"arabic":"ٱلسَّمَـٰوَٰتِ","meaning":"göklerde"},{"arabic":"وَمَا","meaning":"ve ne varsa"},{"arabic":"فِى","meaning":"bulunan"},{"arabic":"ٱلْأَرْضِ","meaning":"yerde"},{"arabic":"لِيَجْزِىَ","meaning":"cezalandırsın diye"},{"arabic":"ٱلَّذِينَ","meaning":"kimseleri"},{"arabic":"أَسَـٰٓـُٔوا۟","meaning":"kötülük eden(leri)"},{"arabic":"بِمَا","meaning":"yaptıklarıyle"},{"arabic":"عَمِلُوا۟","meaning":""},{"arabic":"وَيَجْزِىَ","meaning":"ve mükafatlandırsın diye"},{"arabic":"ٱلَّذِينَ","meaning":"kimseleri"},{"arabic":"أَحْسَنُوا۟","meaning":"güzel davranan(ları)"},{"arabic":"بِٱلْحُسْنَى","meaning":"güzellikle"}]},{"number":32,"reference":"53:32","arabic":"ٱلَّذِينَ يَجْتَنِبُونَ كَبَـٰٓئِرَ ٱلْإِثْمِ وَٱلْفَوَٰحِشَ إِلَّا ٱللَّمَمَ ۚ إِنَّ رَبَّكَ وَٰسِعُ ٱلْمَغْفِرَةِ ۚ هُوَ أَعْلَمُ بِكُمْ إِذْ أَنشَأَكُم مِّنَ ٱلْأَرْضِ وَإِذْ أَنتُمْ أَجِنَّةٌ فِى بُطُونِ أُمَّهَـٰتِكُمْ ۖ فَلَا تُزَكُّوٓا۟ أَنفُسَكُمْ ۖ هُوَ أَعْلَمُ بِمَنِ ٱتَّقَىٰٓ","meaning":"Onlar, ufak tefek kusurları dışında, büyük günahlardan ve çirkin işlerden uzak duran kimselerdir. Şüphesiz Rabbin mağfireti çok geniş olandır. Sizi topraktan meydana getirdiği zaman da ve siz, annelerinizin karnında cenin halinde iken de sizi en iyi O bilir. Öyleyse kendi kendinizi temize çıkarmayın. Kimin takvalı olduğunu en iyi O bilir.","words":[{"arabic":"ٱلَّذِينَ","meaning":"ki onlar"},{"arabic":"يَجْتَنِبُونَ","meaning":"kaçınırlar"},{"arabic":"كَبَـٰٓئِرَ","meaning":"büyüklerinden"},{"arabic":"ٱلْإِثْمِ","meaning":"günahın"},{"arabic":"وَٱلْفَوَٰحِشَ","meaning":"ve çirkin işlerden"},{"arabic":"إِلَّا","meaning":"dışında"},{"arabic":"ٱللَّمَمَ ۚ","meaning":"küçük hatalar"},{"arabic":"إِنَّ","meaning":"şüphesiz"},{"arabic":"رَبَّكَ","meaning":"Rabbinin"},{"arabic":"وَٰسِعُ","meaning":"geniştir"},{"arabic":"ٱلْمَغْفِرَةِ ۚ","meaning":"affı"},{"arabic":"هُوَ","meaning":"O"},{"arabic":"أَعْلَمُ","meaning":"daha iyi bilir"},{"arabic":"بِكُمْ","meaning":"sizi"},{"arabic":"إِذْ","meaning":"zaman"},{"arabic":"أَنشَأَكُم","meaning":"sizi inşa ettiği"},{"arabic":"مِّنَ","meaning":"topraktan"},{"arabic":"ٱلْأَرْضِ","meaning":""},{"arabic":"وَإِذْ","meaning":"ve zaman"},{"arabic":"أَنتُمْ","meaning":"siz"},{"arabic":"أَجِنَّةٌۭ","meaning":"cenin halinde iken"},{"arabic":"فِى","meaning":"karınlarında"},{"arabic":"بُطُونِ","meaning":""},{"arabic":"أُمَّهَـٰتِكُمْ ۖ","meaning":"annelerinizin"},{"arabic":"فَلَا","meaning":"artık"},{"arabic":"تُزَكُّوٓا۟","meaning":"övüp yüceltmeyin"},{"arabic":"أَنفُسَكُمْ ۖ","meaning":"kendinizi"},{"arabic":"هُوَ","meaning":"O"},{"arabic":"أَعْلَمُ","meaning":"daha iyi bilir"},{"arabic":"بِمَنِ","meaning":"kimseyi"},{"arabic":"ٱتَّقَىٰٓ","meaning":"korunan"}]},{"number":33,"reference":"53:33","arabic":"أَفَرَءَيْتَ ٱلَّذِى تَوَلَّىٰ","meaning":"Yüz çeviren kimseyi gördün mü?","words":[{"arabic":"أَفَرَءَيْتَ","meaning":"gördün mü?"},{"arabic":"ٱلَّذِى","meaning":"kimseyi"},{"arabic":"تَوَلَّىٰ","meaning":"arkasını dönen"}]},{"number":34,"reference":"53:34","arabic":"وَأَعْطَىٰ قَلِيلًا وَأَكْدَىٰٓ","meaning":"Azıcık verip sonra vermemekte direneni?","words":[{"arabic":"وَأَعْطَىٰ","meaning":"ve vereni"},{"arabic":"قَلِيلًۭا","meaning":"azıcık"},{"arabic":"وَأَكْدَىٰٓ","meaning":"ve gerisini elinde tutanı"}]},{"number":35,"reference":"53:35","arabic":"أَعِندَهُۥ عِلْمُ ٱلْغَيْبِ فَهُوَ يَرَىٰٓ","meaning":"Gaybın ilmi onun yanında da, o mu görüyor?","words":[{"arabic":"أَعِندَهُۥ","meaning":"kendi yanında mı?"},{"arabic":"عِلْمُ","meaning":"bilgisi"},{"arabic":"ٱلْغَيْبِ","meaning":"gayb'ın"},{"arabic":"فَهُوَ","meaning":"ve o (mu?)"},{"arabic":"يَرَىٰٓ","meaning":"görüyor"}]},{"number":36,"reference":"53:36","arabic":"أَمْ لَمْ يُنَبَّأْ بِمَا فِى صُحُفِ مُوسَىٰ","meaning":"Yoksa kendisine haber verilmedi mi? Musa'nın sahifelerinde bulunan…","words":[{"arabic":"أَمْ","meaning":"yoksa"},{"arabic":"لَمْ","meaning":"haber verilmedi mi?"},{"arabic":"يُنَبَّأْ","meaning":""},{"arabic":"بِمَا","meaning":"bulunan"},{"arabic":"فِى","meaning":"sahifelerinde"},{"arabic":"صُحُفِ","meaning":""},{"arabic":"مُوسَىٰ","meaning":"Musa'nın"}]},{"number":37,"reference":"53:37","arabic":"وَإِبْرَٰهِيمَ ٱلَّذِى وَفَّىٰٓ","meaning":"Ve ahdine vefa gösteren İbrahim'in (sahifelerinde bulunan şu hükümler):","words":[{"arabic":"وَإِبْرَٰهِيمَ","meaning":"ve İbrahim'in"},{"arabic":"ٱلَّذِى","meaning":"ki"},{"arabic":"وَفَّىٰٓ","meaning":"çok vefalıdır"}]},{"number":38,"reference":"53:38","arabic":"أَلَّا تَزِرُ وَازِرَةٌ وِزْرَ أُخْرَىٰ","meaning":"Hiç bir günahkâr başkasının günahını yüklenemez.","words":[{"arabic":"أَلَّا","meaning":"yüklenmez"},{"arabic":"تَزِرُ","meaning":""},{"arabic":"وَازِرَةٌۭ","meaning":"hiçbir günahkar"},{"arabic":"وِزْرَ","meaning":"(günah) yükünü"},{"arabic":"أُخْرَىٰ","meaning":"başkasının"}]},{"number":39,"reference":"53:39","arabic":"وَأَن لَّيْسَ لِلْإِنسَـٰنِ إِلَّا مَا سَعَىٰ","meaning":"İnsan için çalıştığından başkası yoktur.","words":[{"arabic":"وَأَن","meaning":"ve"},{"arabic":"لَّيْسَ","meaning":"yoktur"},{"arabic":"لِلْإِنسَـٰنِ","meaning":"insana"},{"arabic":"إِلَّا","meaning":"başka bir şey"},{"arabic":"مَا","meaning":"çalışmasından"},{"arabic":"سَعَىٰ","meaning":""}]},{"number":40,"reference":"53:40","arabic":"وَأَنَّ سَعْيَهُۥ سَوْفَ يُرَىٰ","meaning":"Çalışması da mutlaka gösterilecektir.","words":[{"arabic":"وَأَنَّ","meaning":"ve muhakkak"},{"arabic":"سَعْيَهُۥ","meaning":"onun çalışması"},{"arabic":"سَوْفَ","meaning":"yakında"},{"arabic":"يُرَىٰ","meaning":"görülecektir"}]},{"number":41,"reference":"53:41","arabic":"ثُمَّ يُجْزَىٰهُ ٱلْجَزَآءَ ٱلْأَوْفَىٰ","meaning":"Sonra da karşılığı eksiksiz tam olarak ödenecektir.","words":[{"arabic":"ثُمَّ","meaning":"sonra"},{"arabic":"يُجْزَىٰهُ","meaning":"ona verilecektir"},{"arabic":"ٱلْجَزَآءَ","meaning":"karşılığı"},{"arabic":"ٱلْأَوْفَىٰ","meaning":"tastamam"}]},{"number":42,"reference":"53:42","arabic":"وَأَنَّ إِلَىٰ رَبِّكَ ٱلْمُنتَهَىٰ","meaning":"Kuşkusuz en son varış Rabbinedir.","words":[{"arabic":"وَأَنَّ","meani