ic":"وَنَمَارِقُ مَصْفُوفَةٌ","meaning":"Sıra sıra yastıklar.","words":[{"arabic":"وَنَمَارِقُ","meaning":"ve yastıklar"},{"arabic":"مَصْفُوفَةٌۭ","meaning":"dizilmiş"}]},{"number":16,"reference":"88:16","arabic":"وَزَرَابِىُّ مَبْثُوثَةٌ","meaning":"Serilmiş halılar vardır.","words":[{"arabic":"وَزَرَابِىُّ","meaning":"ve halılar"},{"arabic":"مَبْثُوثَةٌ","meaning":"serilmiş"}]},{"number":17,"reference":"88:17","arabic":"أَفَلَا يَنظُرُونَ إِلَى ٱلْإِبِلِ كَيْفَ خُلِقَتْ","meaning":"Bakmazlar mı deveye? Nasıl yaratıldı?","words":[{"arabic":"أَفَلَا","meaning":"bakmıyorlar mı?"},{"arabic":"يَنظُرُونَ","meaning":""},{"arabic":"إِلَى","meaning":"develere"},{"arabic":"ٱلْإِبِلِ","meaning":""},{"arabic":"كَيْفَ","meaning":"nasıl"},{"arabic":"خُلِقَتْ","meaning":"yaratılmış"}]},{"number":18,"reference":"88:18","arabic":"وَإِلَى ٱلسَّمَآءِ كَيْفَ رُفِعَتْ","meaning":"Ve göğe, nasıl yükseltildi?","words":[{"arabic":"وَإِلَى","meaning":"ve"},{"arabic":"ٱلسَّمَآءِ","meaning":"göğe"},{"arabic":"كَيْفَ","meaning":"nasıl?"},{"arabic":"رُفِعَتْ","meaning":"yükseltilmiş"}]},{"number":19,"reference":"88:19","arabic":"وَإِلَى ٱلْجِبَالِ كَيْفَ نُصِبَتْ","meaning":"Ve dağlara, nasıl dikildi?","words":[{"arabic":"وَإِلَى","meaning":"ve"},{"arabic":"ٱلْجِبَالِ","meaning":"dağlara"},{"arabic":"كَيْفَ","meaning":"nasıl?"},{"arabic":"نُصِبَتْ","meaning":"dikilmiş"}]},{"number":20,"reference":"88:20","arabic":"وَإِلَى ٱلْأَرْضِ كَيْفَ سُطِحَتْ","meaning":"Ve yere, nasıl yayıldı?","words":[{"arabic":"وَإِلَى","meaning":"ve"},{"arabic":"ٱلْأَرْضِ","meaning":"yere"},{"arabic":"كَيْفَ","meaning":"nasıl?"},{"arabic":"سُطِحَتْ","meaning":"yayılıp döşenmiş"}]},{"number":21,"reference":"88:21","arabic":"فَذَكِّرْ إِنَّمَآ أَنتَ مُذَكِّرٌ","meaning":"Hatırlat! Sen ancak uyarıcısın.","words":[{"arabic":"فَذَكِّرْ","meaning":"öğüt ver"},{"arabic":"إِنَّمَآ","meaning":"çünkü ancak"},{"arabic":"أَنتَ","meaning":"sen"},{"arabic":"مُذَكِّرٌۭ","meaning":"öğüt verensin"}]},{"number":22,"reference":"88:22","arabic":"لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍ","meaning":"Onlar üzerinde bir zorba değilsin.","words":[{"arabic":"لَّسْتَ","meaning":"değilsin"},{"arabic":"عَلَيْهِم","meaning":"onların üzerinde"},{"arabic":"بِمُصَيْطِرٍ","meaning":"zorlayıcı"}]},{"number":23,"reference":"88:23","arabic":"إِلَّا مَن تَوَلَّىٰ وَكَفَرَ","meaning":"Ancak, kim yüz çevirir ve kâfir olursa,","words":[{"arabic":"إِلَّا","meaning":"ancak"},{"arabic":"مَن","meaning":"kim"},{"arabic":"تَوَلَّىٰ","meaning":"yüz çevirirse"},{"arabic":"وَكَفَرَ","meaning":"ve inanmazsa"}]},{"number":24,"reference":"88:24","arabic":"فَيُعَذِّبُهُ ٱللَّهُ ٱلْعَذَابَ ٱلْأَكْبَرَ","meaning":"Allah, onu en büyük azap ile azap eder.","words":[{"arabic":"فَيُعَذِّبُهُ","meaning":"ona azab eder"},{"arabic":"ٱللَّهُ","meaning":"Allah"},{"arabic":"ٱلْعَذَابَ","meaning":"azabla"},{"arabic":"ٱلْأَكْبَرَ","meaning":"en büyük"}]},{"number":25,"reference":"88:25","arabic":"إِنَّ إِلَيْنَآ إِيَابَهُمْ","meaning":"Şüphesiz onların dönüşü bizedir.","words":[{"arabic":"إِنَّ","meaning":"şüphesiz"},{"arabic":"إِلَيْنَآ","meaning":"bizedir"},{"arabic":"إِيَابَهُمْ","meaning":"dönüşleri"}]},{"number":26,"reference":"88:26","arabic":"ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُم","meaning":"Sonra da onların hesabını görmek bizedir.","words":[{"arabic":"ثُمَّ","meaning":"sonra"},{"arabic":"إِنَّ","meaning":"şüphesiz"},{"arabic":"عَلَيْنَا","meaning":"bize düşer"},{"arabic":"حِسَابَهُم","meaning":"onların hesabı"}]}]}
