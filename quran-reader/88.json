{"number":88,"source":"Kur’an metni ve kelime çözümlemesi: Quran.com · Türkçe meal: Shaban Britch; birleşik dört ayetin ayrımı: Dar Al-Salam Center","verses":[{"number":1,"reference":"88:1","arabic":"هَلْ أَتَىٰكَ حَدِيثُ ٱلْغَـٰشِيَةِ","meaning":"Bürüyen günün haberi sana geldi mi?","words":[{"arabic":"هَلْ","meaning":"sana geldimi?"},{"arabic":"أَتَىٰكَ","meaning":""},{"arabic":"حَدِيثُ","meaning":"haberi"},{"arabic":"ٱلْغَـٰشِيَةِ","meaning":"sarıp kaplayacak olanın"}]},{"number":2,"reference":"88:2","arabic":"وُجُوهٌ يَوْمَئِذٍ خَـٰشِعَةٌ","meaning":"O gün, yüzler vardır yere yıkılmış,","words":[{"arabic":"وُجُوهٌۭ","meaning":"yüzler var ki"},{"arabic":"يَوْمَئِذٍ","meaning":"o gün"},{"arabic":"خَـٰشِعَةٌ","meaning":"öne düşüktür"}]},{"number":3,"reference":"88:3","arabic":"عَامِلَةٌ نَّاصِبَةٌ","meaning":"Çalışmış, boşa yorulmuş,","words":[{"arabic":"عَامِلَةٌۭ","meaning":"çalışır"},{"arabic":"نَّاصِبَةٌۭ","meaning":"yorulur"}]},{"number":4,"reference":"88:4","arabic":"تَصْلَىٰ نَارًا حَامِيَةً","meaning":"Kızgın ateşe yaslanan,","words":[{"arabic":"تَصْلَىٰ","meaning":"girerler"},{"arabic":"نَارًا","meaning":"ateşe"},{"arabic":"حَامِيَةًۭ","meaning":"kızgın"}]},{"number":5,"reference":"88:5","arabic":"تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍ","meaning":"Kızgın bir kaynaktan içen,","words":[{"arabic":"تُسْقَىٰ","meaning":"kendilerine içirilir"},{"arabic":"مِنْ","meaning":"bir gözeden"},{"arabic":"عَيْنٍ","meaning":""},{"arabic":"ءَانِيَةٍۢ","meaning":"kaynamış"}]},{"number":6,"reference":"88:6","arabic":"لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍ","meaning":"Onlara kuru dikenden başka yiyecek yoktur.","words":[{"arabic":"لَّيْسَ","meaning":"yoktur"},{"arabic":"لَهُمْ","meaning":"onlar için"},{"arabic":"طَعَامٌ","meaning":"yiyecek"},{"arabic":"إِلَّا","meaning":"başka"},{"arabic":"مِن","meaning":"kuru dikenden"},{"arabic":"ضَرِيعٍۢ","meaning":""}]},{"number":7,"reference":"88:7","arabic":"لَّا يُسْمِنُ وَلَا يُغْنِى مِن جُوعٍ","meaning":"Ne semirtir ne açlığı giderir.","wo