{"number":101,"source":"Kur’an metni ve kelime çözümlemesi: Quran.com · Türkçe meal: Shaban Britch; birleşik dört ayetin ayrımı: Dar Al-Salam Center","verses":[{"number":1,"reference":"101:1","arabic":"ٱلْقَارِعَةُ","meaning":"Şiddetle çalan,","words":[{"arabic":"ٱلْقَارِعَةُ","meaning":"çarpan olay"}]},{"number":2,"reference":"101:2","arabic":"مَا ٱلْقَارِعَةُ","meaning":"Nedir şiddetle çalıp gelen?","words":[{"arabic":"مَا","meaning":"nedir?"},{"arabic":"ٱلْقَارِعَةُ","meaning":"çarpan olay"}]},{"number":3,"reference":"101:3","arabic":"وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ","meaning":"Şiddetle çalıp gelenin ne olduğunu nereden bileceksin?","words":[{"arabic":"وَمَآ","meaning":"nedir"},{"arabic":"أَدْرَىٰكَ","meaning":"sana bildiren"},{"arabic":"مَا","meaning":"ne olduğunu"},{"arabic":"ٱلْقَارِعَةُ","meaning":"çarpan olayın"}]},{"number":4,"reference":"101:4","arabic":"يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ","meaning":"O gün insanlar dağılmış çekirgeler gibi olur.","words":[{"arabic":"يَوْمَ","meaning":"o gün"},{"arabic":"يَكُونُ","meaning":"olur(lar)"},{"arabic":"ٱلنَّاسُ","meaning":"insanlar"},{"arabic":"كَٱلْفَرَاشِ","meaning":"pervaneler gibi"},{"arabic":"ٱلْمَبْثُوثِ","meaning":"yayılmış"}]},{"number":5,"reference":"101:5","arabic":"وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ","meaning":"Dağlar ise saçılmış yün gibi olur.","words":[{"arabic":"وَتَكُونُ","meaning":"ve olurlar"},{"arabic":"ٱلْجِبَالُ","meaning":"dağlar"},{"arabic":"كَٱلْعِهْنِ","meaning":"renkli yün gibi"},{"arabic":"ٱلْمَنفُوشِ","meaning":"atılmış"}]},{"number":6,"reference":"101:6","arabic":"فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ","meaning":"Kimin tartıları ağır gelirse,","words":[{"arabic":"فَأَمَّا","meaning":"ama"},{"arabic":"مَن","meaning":"kimin"},{"arabic":"ثَقُلَتْ","meaning":"ağır gelirse"},{"arabic":"مَوَٰزِينُهُۥ","meaning":"tartıları"}]},{"number":7,"reference":"101:7","arabic":"فَهُوَ فِى عِيشَةٍ رَّاضِيَةٍ","meaning":"O, hoşnut olacağı bir hayat içindedir.","words":[{"arabic":"فَهُوَ","meaning":"o"},{"arabic":"فِى","meaning":"içindedir"},{"arabic":"عِيشَةٍۢ","meaning":"bir hayat"},{"arabic":"رَّاضِيَةٍۢ","meaning":"memmun edici"}]},{"number":8,"reference":"101:8","arabic":"وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ","meaning":"Kimin de tartıları hafif gelirse,","words":[{"arabic":"وَأَمَّا","meaning":"ve fakat"},{"arabic":"مَنْ","meaning":"kimin"},{"arabic":"خَفَّتْ","meaning":"hafif gelirse"},{"arabic":"مَوَٰزِينُهُۥ","meaning":"tartıları"}]},{"number":9,"reference":"101:9","arabic":"فَأُمُّهُۥ هَاوِيَةٌ","meaning":"Onun da sığınacağı yer Haviye'dir.","words":[{"arabic":"فَأُمُّهُۥ","meaning":"onun anası"},{"arabic":"هَاوِيَةٌۭ","meaning":"haviye(uçurum)dur"}]},{"number":10,"reference":"101:10","arabic":"وَمَآ أَدْرَىٰكَ مَا هِيَهْ","meaning":"Onun ne olduğunu sana bildiren ne?","words":[{"arabic":"وَمَآ","meaning":"nedir?"},{"arabic":"أَدْرَىٰكَ","meaning":"sana bildiren"},{"arabic":"مَا","meaning":"ne olduğunu"},{"arabic":"هِيَهْ","meaning":"onun"}]},{"number":11,"reference":"101:11","arabic":"نَارٌ حَامِيَةٌۢ","meaning":"O, kızgın bir ateştir.","words":[{"arabic":"نَارٌ","meaning":"bir ateştir"},{"arabic":"حَامِيَةٌۢ","meaning":"kızgın"}]}]}
