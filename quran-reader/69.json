{"number":69,"source":"Kur’an metni ve kelime çözümlemesi: Quran.com · Türkçe meal: Shaban Britch; birleşik dört ayetin ayrımı: Dar Al-Salam Center","verses":[{"number":1,"reference":"69:1","arabic":"ٱلْحَآقَّةُ","meaning":"Gerçekleşecek olan.","words":[{"arabic":"ٱلْحَآقَّةُ","meaning":"gerçekleşen"}]},{"number":2,"reference":"69:2","arabic":"مَا ٱلْحَآقَّةُ","meaning":"Nedir gerçekleşecek olan?","words":[{"arabic":"مَا","meaning":"nedir?"},{"arabic":"ٱلْحَآقَّةُ","meaning":"gerçekleşen"}]},{"number":3,"reference":"69:3","arabic":"وَمَآ أَدْرَىٰكَ مَا ٱلْحَآقَّةُ","meaning":"Gerçekleşecek olanın ne olduğunu sana bildiren nedir?","words":[{"arabic":"وَمَآ","meaning":"nerden?"},{"arabic":"أَدْرَىٰكَ","meaning":"bileceksin"},{"arabic":"مَا","meaning":"ne olduğunu"},{"arabic":"ٱلْحَآقَّةُ","meaning":"gerçekleşenin"}]},{"number":4,"reference":"69:4","arabic":"كَذَّبَتْ ثَمُودُ وَعَادٌۢ بِٱلْقَارِعَةِ","meaning":"Semud ve Âd halkı (tepelerine) ansızın inecek olanı yalanlamışlardı.","words":[{"arabic":"كَذَّبَتْ","meaning":"yalanladılar"},{"arabic":"ثَمُودُ","meaning":"Semud"},{"arabic":"وَعَادٌۢ","meaning":"ve 'Ad"},{"arabic":"بِٱلْقَارِعَةِ","meaning":"başa çarpan olayı"}]},{"number":5,"reference":"69:5","arabic":"فَأَمَّا ثَمُودُ فَأُهْلِكُوا۟ بِٱلطَّاغِيَةِ","meaning":"Ama Semud, şiddetli bir çığlık/ses ile helak edilmişti.","words":[{"arabic":"فَأَمَّا","meaning":"bu yüzden"},{"arabic":"ثَمُودُ","meaning":"Semud"},{"arabic":"فَأُهْلِكُوا۟","meaning":"helak edildiler"},{"arabic":"بِٱلطَّاغِيَةِ","meaning":"azgın bir vak'a ile"}]},{"number":6,"reference":"69:6","arabic":"وَأَمَّا عَادٌ فَأُهْلِكُوا۟ بِرِيحٍ صَرْصَرٍ عَاتِيَةٍ","meaning":"Âd ise kasıp kavuran uğultulu bir rüzgar ile helak edilmişti.","words":[{"arabic":"وَأَمَّا","meaning":"ve"},{"arabic":"عَادٌۭ","meaning":"Ad (kavmi ise)"},{"arabic":"فَأُهْلِكُوا۟","meaning":"helak edildiler"},{"arabic":"بِرِيحٍۢ","meaning":"bir kasırga ile"},{"arabic":"صَرْصَرٍ","meaning":"uğultulu"},{"arabic":"عَاتِيَةٍۢ","meaning":"azgın"}]},{"number":7,"reference":"69:7","arabic":"سَخَّرَهَا عَلَيْهِمْ سَبْعَ لَيَالٍ وَثَمَـٰنِيَةَ أَيَّامٍ حُسُومًا فَتَرَى ٱلْقَوْمَ فِيهَا صَرْعَىٰ كَأَنَّهُمْ أَعْجَازُ نَخْلٍ خَاوِيَةٍ","meaning":"Allah, onu yedi gece sekiz gün kesintisiz onların üzerine musallat etmişti. Böylece o kavmin, orada sanki içi kof hurma kütükleriymiş gibi çarpılıp yere yıkıldığını görürdün.","words":[{"arabic":"سَخَّرَهَا","meaning":"onu saldı"},{"arabic":"عَلَيْهِمْ","meaning":"onların üzerine"},{"arabic":"سَبْعَ","meaning":"yedi"},{"arabic":"لَيَالٍۢ","meaning":"gece"},{"arabic":"وَثَمَـٰنِيَةَ","meaning":"ve sekiz"},{"arabic":"أَيَّامٍ","meaning":"gün"},{"arabic":"حُسُومًۭا","meaning":"ardı ardına"},{"arabic":"فَتَرَى","meaning":"görürsün"},{"arabic":"ٱلْقَوْمَ","meaning":"o kavmi"},{"arabic":"فِيهَا","meaning":"orada"},{"arabic":"صَرْعَىٰ","meaning":"serilmiş"},{"arabic":"كَأَنَّهُمْ","meaning":"sanki onlar"},{"arabic":"أَعْجَازُ","meaning":"kütükleridir"},{"arabic":"نَخْلٍ","meaning":"hurma"},{"arabic":"خَاوِيَةٍۢ","meaning":"içi boş"}]},{"number":8,"reference":"69:8","arabic":"فَهَلْ تَرَىٰ لَهُم مِّنۢ بَاقِيَةٍ","meaning":"Onlardan arta kalan bir şey görüyor musun?","words":[{"arabic":"فَهَلْ","meaning":"görüyormusun?"},{"arabic":"تَرَىٰ","meaning":""},{"arabic":"لَهُم","meaning":"onlardan"},{"arabic":"مِّنۢ","meaning":"hiç"},{"arabic":"بَاقِيَةٍۢ","meaning":"geri kalan"}]},{"number":9,"reference":"69:9","arabic":"وَجَآءَ فِرْعَوْنُ وَمَن قَبْلَهُۥ وَٱلْمُؤْتَفِكَـٰتُ بِٱلْخَاطِئَةِ","meaning":"Firavun (kavmi), ondan öncekiler ve yerle bir olan Lut şehirleri (halkı da hep) o hata ile geldiler.","words":[{"arabic":"وَجَآءَ","meaning":"ve geldiler"},{"arabic":"فِرْعَوْنُ","meaning":"Fir'avn"},{"arabic":"وَمَن","meaning":"ve kimseler"},{"arabic":"قَبْلَهُۥ","meaning":"ondan önceki"},{"arabic":"وَٱلْمُؤْتَفِكَـٰتُ","meaning":"ve altüst olmuş kentler"},{"arabic":"بِٱلْخَاطِئَةِ","meaning":"hatalı iş ile"}]},{"number":10,"reference":"69:10","arabic":"فَعَصَوْا۟ رَسُولَ رَبِّهِمْ فَأَخَذَهُمْ أَخْذَةً رَّابِيَةً","meaning":"Rablerinin elçisine isyan ettikleri için onları şiddetli bir yakalayışla yakaladı.","words":[{"arabic":"فَعَصَوْا۟","meaning":"karşı geldiler"},{"arabic":"رَسُولَ","meaning":"elçisine"},{"arabic":"رَبِّهِمْ","meaning":"Rablerinin"},{"arabic":"فَأَخَذَهُمْ","meaning":"O da onları yakaladı"},{"arabic":"أَخْذَةًۭ","meaning":"bir yakalayışla"},{"arabic":"رَّابِيَةً","meaning":"şiddeti gittikçe artan"}]},{"number":11,"reference":"69:11","arabic":"إِنَّا لَمَّا طَغَا ٱلْمَآءُ حَمَلْنَـٰكُمْ فِى ٱلْجَارِيَةِ","meaning":"Sular taştığı zaman sizi gemide biz taşıdık.","words":[{"arabic":"إِنَّا","meaning":"elbette biz"},{"arabic":"لَمَّا","meaning":"kabarınca"},{"arabic":"طَغَا","meaning":""},{"arabic":"ٱلْمَآءُ","meaning":"su(lar)"},{"arabic":"حَمَلْنَـٰكُمْ","meaning":"sizi taşıdık"},{"arabic":"فِى","meaning":"akıp gidende (gemi)"},{"arabic":"ٱلْجَارِيَةِ","meaning":""}]},{"number":12,"reference":"69:12","arabic":"لِنَجْعَلَهَا لَكُمْ تَذْكِرَةً وَتَعِيَهَآ أُذُنٌ وَٰعِيَةٌ","meaning":"Bunu sizin için bir öğüt kılalım ve anlayışlı kulaklar duysun diye.","words":[{"arabic":"لِنَجْعَلَهَا","meaning":"onu yapalım diye"},{"arabic":"لَكُمْ","meaning":"size"},{"arabic":"تَذْكِرَةًۭ","meaning":"bir ibret"},{"arabic":"وَتَعِيَهَآ","meaning":"ve onu bellesin"},{"arabic":"أُذُنٌۭ","meaning":"kulak(lar)"},{"arabic":"وَٰعِيَةٌۭ","meaning":"belleyen"}]},{"number":13,"reference":"69:13","arabic":"فَإِذَا نُفِخَ فِى ٱلصُّورِ نَفْخَةٌ وَٰحِدَةٌ","meaning":"Sûr’a tek bir üfürüşle üfürüldüğü zaman.","words":[{"arabic":"فَإِذَا","meaning":"zaman"},{"arabic":"نُفِخَ","meaning":"üflendiği"},{"arabic":"فِى","meaning":"Sur'a"},{"arabic":"ٱلصُّورِ","meaning":""},{"arabic":"نَفْخَةٌۭ","meaning":"üfleme"},{"arabic":"وَٰحِدَةٌۭ","meaning":"bir tek"}]},{"number":14,"reference":"69:14","arabic":"وَحُمِلَتِ ٱلْأَرْضُ وَٱلْجِبَالُ فَدُكَّتَا دَكَّةً وَٰحِدَةً","meaning":"Yeryüzü ve dağlar kaldırılıp tek çarpışla çarpılıp darmadağın edildiği zaman.","words":[{"arabic":"وَحُمِلَتِ","meaning":"yerlerinden kaldırıldığı"},{"arabic":"ٱلْأَرْضُ","meaning":"arz"},{"arabic":"وَٱلْجِبَالُ","meaning":"ve dağlar"},{"arabic":"فَدُكَّتَا","meaning":"çarpıştırıldığı"},{"arabic":"دَكَّةًۭ","meaning":"çarpma ile"},{"arabic":"وَٰحِدَةًۭ","meaning":"bir tek"}]},{"number":15,"reference":"69:15","arabic":"فَيَوْمَئِذٍ وَقَعَتِ ٱلْوَاقِعَةُ","meaning":"O gün olacak olur.","words":[{"arabic":"فَيَوْمَئِذٍۢ","meaning":"işte o gün"},{"arabic":"وَقَعَتِ","meaning":"vuku bulur"},{"arabic":"ٱلْوَاقِعَةُ","meaning":"olacak olan"}]},{"number":16,"reference":"69:16","arabic":"وَٱنشَقَّتِ ٱلسَّمَآءُ فَهِىَ يَوْمَئِذٍ وَاهِيَةٌ","meaning":"Gök paramparça olur, çünkü o gün zayıf ve güçsüz düşer.","words":[{"arabic":"وَٱنشَقَّتِ","meaning":"yarılmıştır"},{"arabic":"ٱلسَّمَآءُ","meaning":"gök"},{"arabic":"فَهِىَ","meaning":"o"},{"arabic":"يَوْمَئِذٍۢ","meaning":"o gün"},{"arabic":"وَاهِيَةٌۭ","meaning":"zayıftır"}]},{"number":17,"reference":"69:17","arabic":"وَٱلْمَلَكُ عَلَىٰٓ أَرْجَآئِهَا ۚ وَيَحْمِلُ عَرْشَ رَبِّكَ فَوْقَهُمْ يَوْمَئِذٍ ثَمَـٰنِيَةٌ","meaning":"Melekler ise onun çevresindedirler. Rabbinin Arş’ını ise o gün, onların da üzerinde olan sekizi taşır","words":[{"arabic":"وَٱلْمَلَكُ","meaning":"vre melekler de"},{"arabic":"عَلَىٰٓ","meaning":"onun kenarlarındadır"},{"arabic":"أَرْجَآئِهَا ۚ","meaning":""},{"arabic":"وَيَحْمِلُ","meaning":"ve taşır"},{"arabic":"عَرْشَ","meaning":"tahtını"},{"arabic":"رَبِّكَ","meaning":"Rabbinin"},{"arabic":"فَوْقَهُمْ","meaning":"üstlerinde"},{"arabic":"يَوْمَئِذٍۢ","meaning":"o gün"},{"arabic":"ثَمَـٰنِيَةٌۭ","meaning":"sekiz (melek)"}]},{"number":18,"reference":"69:18","arabic":"يَوْمَئِذٍ تُعْرَضُونَ لَا تَخْفَىٰ مِنكُمْ خَافِيَةٌ","meaning":"Siz o gün (hesap için) sunulursunuz; hiç bir sırrınız gizli kalmaz.","words":[{"arabic":"يَوْمَئِذٍۢ","meaning":"o gün"},{"arabic":"تُعْرَضُونَ","meaning":"arz olunursunuz"},{"arabic":"لَا","meaning":"gizli kalmaz"},{"arabic":"تَخْفَىٰ","meaning":""},{"arabic":"مِنكُمْ","meaning":"sizden"},{"arabic":"خَافِيَةٌۭ","meaning":"hiçbir giz"}]},{"number":19,"reference":"69:19","arabic":"فَأَمَّا مَنْ أُوتِىَ كِتَـٰبَهُۥ بِيَمِينِهِۦ فَيَقُولُ هَآؤُمُ ٱقْرَءُوا۟ كِتَـٰبِيَهْ","meaning":"Kimin kitabı sağından verilirse, alın kitabımı okuyun,","words":[{"arabic":"فَأَمَّا","meaning":"o zaman"},{"arabic":"مَنْ","meaning":"kimse"},{"arabic":"أُوتِىَ","meaning":"verilen"},{"arabic":"كِتَـٰبَهُۥ","meaning":"Kitabı"},{"arabic":"بِيَمِينِهِۦ","meaning":"sağından"},{"arabic":"فَيَقُولُ","meaning":"der ki"},{"arabic":"هَآؤُمُ","meaning":"alın"},{"arabic":"ٱقْرَءُوا۟","meaning":"okuyun"},{"arabic":"كِتَـٰبِيَهْ","meaning":"Kitabımı"}]},{"number":20,"reference":"69:20","arabic":"إِنِّى ظَنَنتُ أَنِّى مُلَـٰقٍ حِسَابِيَهْ","meaning":"Ben zaten bu hesabıma ulaşacağımı biliyordum, der.","words":[{"arabic":"إِنِّى","meaning":"süphesiz ben"},{"arabic":"ظَنَنتُ","meaning":"sezmiştim"},{"arabic":"أَنِّى","meaning":"elbette benim"},{"arabic":"مُلَـٰقٍ","meaning":"karşılaşacağımı"},{"arabic":"حِسَابِيَهْ","meaning":"hesabımla"}]},{"number":21,"reference":"69:21","arabic":"فَهُوَ فِى عِيشَةٍ رَّاضِيَةٍ","meaning":"Artık o, hoşnut edici bir hayat içinde.","words":[{"arabic":"فَهُوَ","meaning":"artık o"},{"arabic":"فِى","meaning":"içindedir"},{"arabic":"عِيشَةٍۢ","meaning":"bir yaşam"},{"arabic":"رَّاضِيَةٍۢ","meaning":"memmun eden"}]},{"number":22,"reference":"69:22","arabic":"فِى جَنَّةٍ عَالِيَةٍ","meaning":"Yüksek bir cennette.","words":[{"arabic":"فِى","meaning":"bir bahçede"},{"arabic":"جَنَّةٍ","meaning":""},{"arabic":"عَالِيَةٍۢ","meaning":"yüksek"}]},{"number":23,"reference":"69:23","arabic":"قُطُوفُهَا دَانِيَةٌ","meaning":"Meyveleri ise (çok) yakın.","words":[{"arabic":"قُطُوفُهَا","meaning":"meyveleri"},{"arabic":"دَانِيَةٌۭ","meaning":"aşağıya sarkmış"}]},{"number":24,"reference":"69:24","arabic":"كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَآ أَسْلَفْتُمْ فِى ٱلْأَيَّامِ ٱلْخَالِيَةِ","meaning":"Yiyin, için afiyet olsun. Bu, geçmiş günlerde yaptıklarınızın sebebiyle (size bahşedilmiştir).","words":[{"arabic":"كُلُوا۟","meaning":"yeyin"},{"arabic":"وَٱشْرَبُوا۟","meaning":"ve için"},{"arabic":"هَنِيٓـًٔۢا","meaning":"afiyetle"},{"arabic":"بِمَآ","meaning":"ötürü"},{"arabic":"أَسْلَفْتُمْ","meaning":"yaptığınız işlerden"},{"arabic":"فِى","meaning":"günlerde"},{"arabic":"ٱلْأَيَّامِ","meaning":""},{"arabic":"ٱلْخَالِيَةِ","meaning":"geçmiş"}]},{"number":25,"reference":"69:25","arabic":"وَأَمَّا مَنْ أُوتِىَ كِتَـٰبَهُۥ بِشِمَالِهِۦ فَيَقُولُ يَـٰلَيْتَنِى لَمْ أُوتَ كِتَـٰبِيَهْ","meaning":"Kitabı solundan verilen ise şöyle der: Eyvah, keşke kitabım verilmeseydi.","words":[{"arabic":"وَأَمَّا","meaning":"o zaman"},{"arabic":"مَنْ","meaning":"kimse"},{"arabic":"أُوتِىَ","meaning":"verilen"},{"arabic":"كِتَـٰبَهُۥ","meaning":"Kitabı"},{"arabic":"بِشِمَالِهِۦ","meaning":"sol tarafından"},{"arabic":"فَيَقُولُ","meaning":"der ki"},{"arabic":"يَـٰلَيْتَنِى","meaning":"ey keşke bana"},{"arabic":"لَمْ","meaning":"verilmeseydi"},{"arabic":"أُوتَ","meaning":""},{"arabic":"كِتَـٰبِيَهْ","meaning":"Kitabım"}]},{"number":26,"reference":"69:26","arabic":"وَلَمْ أَدْرِ مَا حِسَابِيَهْ","meaning":"Hesabımı hiç bilmeseydim.","words":[{"arabic":"وَلَمْ","meaning":"ve hiç"},{"arabic":"أَدْرِ","meaning":"bilmeseydim"},{"arabic":"مَا","meaning":"nedir"},{"arabic":"حِسَابِيَهْ","meaning":"hesabım"}]},{"number":27,"reference":"69:27","arabic":"يَـٰلَيْتَهَا كَانَتِ ٱلْقَاضِيَةَ","meaning":"Keşke (ölüm işimi) bitirmiş olsaydı!","words":[{"arabic":"يَـٰلَيْتَهَا","meaning":"ey keşke"},{"arabic":"كَانَتِ","meaning":"olsaydı"},{"arabic":"ٱلْقَاضِيَةَ","meaning":"işimi bitirmiş"}]},{"number":28,"reference":"69:28","arabic":"مَآ أَغْنَىٰ عَنِّى مَالِيَهْ ۜ","meaning":"Malım bana fayda vermedi.","words":[{"arabic":"مَآ","meaning":"hiçbir"},{"arabic":"أَغْنَىٰ","meaning":"yarar sağlamadı"},{"arabic":"عَنِّى","meaning":"bana"},{"arabic":"مَالِيَهْ ۜ","meaning":"malım"}]},{"number":29,"reference":"69:29","arabic":"هَلَكَ عَنِّى سُلْطَـٰنِيَهْ","meaning":"Gücüm, hüccetim yok olup gitti.","words":[{"arabic":"هَلَكَ","meaning":"yok olup gitti"},{"arabic":"عَنِّى","meaning":"benden"},{"arabic":"سُلْطَـٰنِيَهْ","meaning":"gücüm (saltanatım)"}]},{"number":30,"reference":"69:30","arabic":"خُذُوهُ فَغُلُّوهُ","meaning":"Tutun onu, (ellerini boynuna) bağlayın!","words":[{"arabic":"خُذُوهُ","meaning":"tutun onu"},{"arabic":"فَغُلُّوهُ","meaning":"bağlayın onu"}]},{"number":31,"reference":"69:31","arabic":"ثُمَّ ٱلْجَحِيمَ صَلُّوهُ","meaning":"Sonra atın onu ateşe!","words":[{"arabic":"ثُمَّ","meaning":"sonra"},{"arabic":"ٱلْجَحِيمَ","meaning":"cehenneme"},{"arabic":"صَلُّوهُ","meaning":"sallayın onu"}]},{"number":32,"reference":"69:32","arabic":"ثُمَّ فِى سِلْسِلَةٍ ذَرْعُهَا سَبْعُونَ ذِرَاعًا فَٱسْلُكُوهُ","meaning":"Sonra da onu yetmiş arşın boyundaki zincire vurun ve sürün.","words":[{"arabic":"ثُمَّ","meaning":"sonra"},{"arabic":"فِى","meaning":"zincire"},{"arabic":"سِلْسِلَةٍۢ","meaning":""},{"arabic":"ذَرْعُهَا","meaning":"uzunluğu"},{"arabic":"سَبْعُونَ","meaning":"yetmiş"},{"arabic":"ذِرَاعًۭا","meaning":"arşın"},{"arabic":"فَٱسْلُكُوهُ","meaning":"vurun onu"}]},{"number":33,"reference":"69:33","arabic":"إِنَّهُۥ كَانَ لَا يُؤْمِنُ بِٱللَّهِ ٱلْعَظِيمِ","meaning":"Çünkü o, yüce Allah’a iman etmiyordu.","words":[{"arabic":"إِنَّهُۥ","meaning":"çünkü o"},{"arabic":"كَانَ","meaning":"idi"},{"arabic":"لَا","meaning":"inanmıyor"},{"arabic":"يُؤْمِنُ","meaning":""},{"arabic":"بِٱللَّهِ","meaning":"Allah'a"},{"arabic":"ٱلْعَظِيمِ","meaning":"büyük"}]},{"number":34,"reference":"69:34","arabic":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ","meaning":"Yoksulu yedirmeye teşvik etmiyordu.","words":[{"arabic":"وَلَا","meaning":"ve"},{"arabic":"يَحُضُّ","meaning":"ön ayak olmuyurdu"},{"arabic":"عَلَىٰ","meaning":"doyurmaya"},{"arabic":"طَعَامِ","meaning":""},{"arabic":"ٱلْمِسْكِينِ","meaning":"yoksulu"}]},{"number":35,"reference":"69:35","arabic":"فَلَيْسَ لَهُ ٱلْيَوْمَ هَـٰهُنَا حَمِيمٌ","meaning":"Bugün onun için hiçbir yakın yoktur.","words":[{"arabic":"فَلَيْسَ","meaning":"yoktur"},{"arabic":"لَهُ","meaning":"onun için"},{"arabic":"ٱلْيَوْمَ","meaning":"bugün"},{"arabic":"هَـٰهُنَا","meaning":"burada"},{"arabic":"حَمِيمٌۭ","meaning":"candan bir dost"}]},{"number":36,"reference":"69:36","arabic":"وَلَا طَعَامٌ إِلَّا مِنْ غِسْلِينٍ","meaning":"İrinden başka yiyecek de yoktur.","words":[{"arabic":"وَلَا","meaning":"ve yoktur"},{"arabic":"طَعَامٌ","meaning":"yiyecek"},{"arabic":"إِلَّا","meaning":"başka"},{"arabic":"مِنْ","meaning":"irinden"},{"arabic":"غِسْلِينٍۢ","meaning":""}]},{"number":37,"reference":"69:37","arabic":"لَّا يَأْكُلُهُۥٓ إِلَّا ٱلْخَـٰطِـُٔونَ","meaning":"Onu günahkârdan başkası yemez.","words":[{"arabic":"لَّا","meaning":"onu yemez"},{"arabic":"يَأْكُلُهُۥٓ","meaning":""},{"arabic":"إِلَّا","meaning":"başkası"},{"arabic":"ٱلْخَـٰطِـُٔونَ","meaning":"hata işleyenlerden"}]},{"number":38,"reference":"69:38","arabic":"فَلَآ أُقْسِمُ بِمَا تُبْصِرُونَ","meaning":"Görebildikleriniz üzerine yemin ederim.","words":[{"arabic":"فَلَآ","meaning":"hayır"},{"arabic":"أُقْسِمُ","meaning":"yemin ederim"},{"arabic":"بِمَا","meaning":"şeylere"},{"arabic":"تُبْصِرُونَ","meaning":"gördükleriniz"}]},{"number":39,"reference":"69:39","arabic":"وَمَا لَا تُبْصِرُونَ","meaning":"Göremediklerinize de…","words":[{"arabic":"وَمَا","meaning":"ve şeylere"},{"arabic":"لَا","meaning":"görmedikleriniz"},{"arabic":"تُبْصِرُونَ","meaning":""}]},{"number":40,"reference":"69:40","arabic":"إِنَّهُۥ لَقَوْلُ رَسُولٍ كَرِيمٍ","meaning":"Şüphesiz o, şerefli bir elçinin sözüdür.","words":[{"arabic":"إِنَّهُۥ","meaning":"şüphesiz o"},{"arabic":"لَقَوْلُ","meaning":"elbette sözüdür"},{"arabic":"رَسُولٍۢ","meaning":"bir elçinin"},{"arabic":"كَرِيمٍۢ","meaning":"değerli"}]},{"number":41,"reference":"69:41","arabic":"وَمَا هُوَ بِقَوْلِ شَاعِرٍ ۚ قَلِيلًا مَّا تُؤْمِنُونَ","meaning":"O, bir şair sözü değildir. Ne de az iman ediyorsunuz!","words":[{"arabic":"وَمَا","meaning":"ve değildir"},{"arabic":"هُوَ","meaning":"O"},{"arabic":"بِقَوْلِ","meaning":"sözü"},{"arabic":"شَاعِرٍۢ ۚ","meaning":"bir şa'irin"},{"arabic":"قَلِيلًۭا","meaning":"az"},{"arabic":"مَّا","meaning":"ne de"},{"arabic":"تُؤْمِنُونَ","meaning":"inanıyorsunuz"}]},{"number":42,"reference":"69:42","arabic":"وَلَا بِقَوْلِ كَاهِنٍ ۚ قَلِيلًا مَّا تَذَكَّرُونَ","meaning":"O, kâhin sözü de değildir. Ne de az düşünüyorsunuz!","words":[{"arabic":"وَلَا","meaning":"ve değildir"},{"arabic":"بِقَوْلِ","meaning":"sözü"},{"arabic":"كَاهِنٍۢ ۚ","meaning":"bir kahinin"},{"arabic":"قَلِيلًۭا","meaning":"az"},{"arabic":"مَّا","meaning":"ne de"},{"arabic":"تَذَكَّرُونَ","meaning":"düşünüyorsunuz"}]},{"number":43,"reference":"69:43","arabic":"تَنزِيلٌ مِّن رَّبِّ ٱلْعَـٰلَمِينَ","meaning":"Alemlerin Rabbi tarafından indirilmiştir.","words":[{"arabic":"تَنزِيلٌۭ","meaning":"indirilmiştir"},{"arabic":"مِّن","meaning":"tarafından"},{"arabic":"رَّبِّ","meaning":"Rabbi"},{"arabic":"ٱلْعَـٰلَمِينَ","meaning":"alemlerin"}]},{"number":44,"reference":"69:44","arabic":"وَلَوْ تَقَوَّلَ عَلَيْنَا بَعْضَ ٱلْأَقَاوِيلِ","meaning":"Eğer (Peygamber) bize atfen bazı sözler uydurmuş olsaydı;","words":[{"arabic":"وَلَوْ","meaning":"ve eğer"},{"arabic":"تَقَوَّلَ","meaning":"iftira etseydi"},{"arabic":"عَلَيْنَا","meaning":"bize"},{"arabic":"بَعْضَ","meaning":"bazı"},{"arabic":"ٱلْأَقَاوِيلِ","meaning":"laflar uydurup"}]},{"number":45,"reference":"69:45","arabic":"لَأَخَذْنَا مِنْهُ بِٱلْيَمِينِ","meaning":"Elbette onu (boynunun) sağ tarafından kıskıvrak yakalardık.","words":[{"arabic":"لَأَخَذْنَا","meaning":"elbette alırdık"},{"arabic":"مِنْهُ","meaning":"onun"},{"arabic":"بِٱلْيَمِينِ","meaning":"sağını"}]},{"number":46,"reference":"69:46","arabic":"ثُمَّ لَقَطَعْنَا مِنْهُ ٱلْوَتِينَ","meaning":"Sonra onun şah damarını elbette keserdik.","words":[{"arabic":"ثُمَّ","meaning":"sonra"},{"arabic":"لَقَطَعْنَا","meaning":"keserdik"},{"arabic":"مِنْهُ","meaning":"onun"},{"arabic":"ٱلْوَتِينَ","meaning":"can damarını"}]},{"number":47,"reference":"69:47","arabic":"فَمَا مِنكُم مِّنْ أَحَدٍ عَنْهُ حَـٰجِزِينَ","meaning":"Sizden hiç kimse de buna engel olamazdı.","words":[{"arabic":"فَمَا","meaning":"olamazdı"},{"arabic":"مِنكُم","meaning":"sizden"},{"arabic":"مِّنْ","meaning":"hiçbir"},{"arabic":"أَحَدٍ","meaning":"kimse"},{"arabic":"عَنْهُ","meaning":"ondan"},{"arabic":"حَـٰجِزِينَ","meaning":"engel"}]},{"number":48,"reference":"69:48","arabic":"وَإِنَّهُۥ لَتَذْكِرَةٌ لِّلْمُتَّقِينَ","meaning":"Şüphesiz o, sakınanlar için bir öğüttür.","words":[{"arabic":"وَإِنَّهُۥ","meaning":"şüphesiz O"},{"arabic":"لَتَذْكِرَةٌۭ","meaning":"bir öğüttür"},{"arabic":"لِّلْمُتَّقِينَ","meaning":"muttakiler için"}]},{"number":49,"reference":"69:49","arabic":"وَإِنَّا لَنَعْلَمُ أَنَّ مِنكُم مُّكَذِّبِينَ","meaning":"Elbette biz, biliyoruz ki içinizden yalanlayanlar vardır.","words":[{"arabic":"وَإِنَّا","meaning":"ve elbette biz"},{"arabic":"لَنَعْلَمُ","meaning":"elbette biliyoruz"},{"arabic":"أَنَّ","meaning":"muhakkak"},{"arabic":"مِنكُم","meaning":"içinizdeki"},{"arabic":"مُّكَذِّبِينَ","meaning":"yalanlayıcıları"}]},{"number":50,"reference":"69:50","arabic":"وَإِنَّهُۥ لَحَسْرَةٌ عَلَى ٱلْكَـٰفِرِينَ","meaning":"O kâfirler için bir hasret/pişmanlıktır.","words":[{"arabic":"وَإِنَّهُۥ","meaning":"doğrusu o"},{"arabic":"لَحَسْرَةٌ","meaning":"elbette hasrettir"},{"arabic":"عَلَى","meaning":"için"},{"arabic":"ٱلْكَـٰفِرِينَ","meaning":"kafirler"}]},{"number":51,"reference":"69:51","arabic":"وَإِنَّهُۥ لَحَقُّ ٱلْيَقِينِ","meaning":"O, kesin bir gerçektir.","words":[{"arabic":"وَإِنَّهُۥ","meaning":"ve şüphesiz O"},{"arabic":"لَحَقُّ","meaning":"muhakkak gerçektir"},{"arabic":"ٱلْيَقِينِ","meaning":"kesin"}]},{"number":52,"reference":"69:52","arabic":"فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ","meaning":"O halde sen, yüce Rabbinin adı ile tesbih et!","words":[{"arabic":"فَسَبِّحْ","meaning":"öyleyse tesbih et"},{"arabic":"بِٱسْمِ","meaning":"adını"},{"arabic":"رَبِّكَ","meaning":"Rabbinin"},{"arabic":"ٱلْعَظِيمِ","meaning":"ulu"}]}]}
