{"number":79,"source":"Kur’an metni ve kelime çözümlemesi: Quran.com · Türkçe meal: Shaban Britch; birleşik dört ayetin ayrımı: Dar Al-Salam Center","verses":[{"number":1,"reference":"79:1","arabic":"وَٱلنَّـٰزِعَـٰتِ غَرْقًا","meaning":"Yemin olsun şiddetle söküp alanlara…","words":[{"arabic":"وَٱلنَّـٰزِعَـٰتِ","meaning":"andolsun söküp çıkaranlara"},{"arabic":"غَرْقًۭا","meaning":"şiddetle"}]},{"number":2,"reference":"79:2","arabic":"وَٱلنَّـٰشِطَـٰتِ نَشْطًا","meaning":"Kolayca çekip çıkaranlara…","words":[{"arabic":"وَٱلنَّـٰشِطَـٰتِ","meaning":"ve çekip alanlara"},{"arabic":"نَشْطًۭا","meaning":"usulca"}]},{"number":3,"reference":"79:3","arabic":"وَٱلسَّـٰبِحَـٰتِ سَبْحًا","meaning":"(Gökyüzünde) Yüzdükçe yüzenlere…","words":[{"arabic":"وَٱلسَّـٰبِحَـٰتِ","meaning":"yüzüp gidenlere"},{"arabic":"سَبْحًۭا","meaning":"yüzerek"}]},{"number":4,"reference":"79:4","arabic":"فَٱلسَّـٰبِقَـٰتِ سَبْقًا","meaning":"Yarıştıkça yarışanlara…","words":[{"arabic":"فَٱلسَّـٰبِقَـٰتِ","meaning":"yarışıp geçenlere"},{"arabic":"سَبْقًۭا","meaning":"yarışarak"}]},{"number":5,"reference":"79:5","arabic":"فَٱلْمُدَبِّرَٰتِ أَمْرًا","meaning":"Ve işleri düzene sokanlara...","words":[{"arabic":"فَٱلْمُدَبِّرَٰتِ","meaning":"derken düzenleyenlere"},{"arabic":"أَمْرًۭا","meaning":"işi"}]},{"number":6,"reference":"79:6","arabic":"يَوْمَ تَرْجُفُ ٱلرَّاجِفَةُ","meaning":"O gün (birinci üflemeyle) sarsılacak olan sarsılır.","words":[{"arabic":"يَوْمَ","meaning":"o gün"},{"arabic":"تَرْجُفُ","meaning":"sarsar"},{"arabic":"ٱلرَّاجِفَةُ","meaning":"o sarsıntı"}]},{"number":7,"reference":"79:7","arabic":"تَتْبَعُهَا ٱلرَّادِفَةُ","meaning":"Bir diğeri onu izler.","words":[{"arabic":"تَتْبَعُهَا","meaning":"takip eder"},{"arabic":"ٱلرَّادِفَةُ","meaning":"ardından (başka gürültü)"}]},{"number":8,"reference":"79:8","arabic":"قُلُوبٌ يَوْمَئِذٍ وَاجِفَةٌ","meaning":"O gün kalpler korkudan çarpar.","words":[{"arabic":"قُلُوبٌۭ","meaning":"yürekler"},{"arabic":"يَوْمَئِذٍۢ","meaning":"o gün"},{"arabic":"وَاجِفَةٌ","meaning":"çarpar"}]},{"number":9,"reference":"79:9","arabic":"أَبْصَـٰرُهَا خَـٰشِعَةٌ","meaning":"Gözleri korku ile yere eğilmiştir.","words":[{"arabic":"أَبْصَـٰرُهَا","meaning":"gözleri"},{"arabic":"خَـٰشِعَةٌۭ","meaning":"(korkudan) aşağı kayar"}]},{"number":10,"reference":"79:10","arabic":"يَقُولُونَ أَءِنَّا لَمَرْدُودُونَ فِى ٱلْحَافِرَةِ","meaning":"Derler ki: \"Biz eski halimize mi döndürüleceğiz?\" derler.","words":[{"arabic":"يَقُولُونَ","meaning":"diyorlar ki"},{"arabic":"أَءِنَّا","meaning":"biz yine"},{"arabic":"لَمَرْدُودُونَ","meaning":"döndürülecek (miyiz?)"},{"arabic":"فِى","meaning":"eski halimize"},{"arabic":"ٱلْحَافِرَةِ","meaning":""}]},{"number":11,"reference":"79:11","arabic":"أَءِذَا كُنَّا عِظَـٰمًا نَّخِرَةً","meaning":"Çürüyüp ufalanmış kemikler haline geldiğimiz zaman mı?","words":[{"arabic":"أَءِذَا","meaning":"sonra ha?"},{"arabic":"كُنَّا","meaning":"biz olduktan"},{"arabic":"عِظَـٰمًۭا","meaning":"kemikler"},{"arabic":"نَّخِرَةًۭ","meaning":"çürümüş"}]},{"number":12,"reference":"79:12","arabic":"قَالُوا۟ تِلْكَ إِذًا كَرَّةٌ خَاسِرَةٌ","meaning":"Öyleyse bu dönüş hüsrandır, derler.","words":[{"arabic":"قَالُوا۟","meaning":"dediler"},{"arabic":"تِلْكَ","meaning":"bu"},{"arabic":"إِذًۭا","meaning":"öyle ise"},{"arabic":"كَرَّةٌ","meaning":"bir dönüştür"},{"arabic":"خَاسِرَةٌۭ","meaning":"ziyanlı"}]},{"number":13,"reference":"79:13","arabic":"فَإِنَّمَا هِىَ زَجْرَةٌ وَٰحِدَةٌ","meaning":"O, ancak tek bir çığlıktır.","words":[{"arabic":"فَإِنَّمَا","meaning":"halbuki"},{"arabic":"هِىَ","meaning":"O"},{"arabic":"زَجْرَةٌۭ","meaning":"haykırıştır"},{"arabic":"وَٰحِدَةٌۭ","meaning":"bir tek"}]},{"number":14,"reference":"79:14","arabic":"فَإِذَا هُم بِٱلسَّاهِرَةِ","meaning":"İşte o zaman onlar, hemen (kendilerini mahşerde) buluverirler.","words":[{"arabic":"فَإِذَا","meaning":"hemen"},{"arabic":"هُم","meaning":"onlar"},{"arabic":"بِٱلسَّاهِرَةِ","meaning":"uyanıklık alanındadırlar"}]},{"number":15,"reference":"79:15","arabic":"هَلْ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ","meaning":"Musa’nın haberi sana geldi mi?","words":[{"arabic":"هَلْ","meaning":"sana geldimi?"},{"arabic":"أَتَىٰكَ","meaning":""},{"arabic":"حَدِيثُ","meaning":"haberi"},{"arabic":"مُوسَىٰٓ","meaning":"Musa'nın"}]},{"number":16,"reference":"79:16","arabic":"إِذْ نَادَىٰهُ رَبُّهُۥ بِٱلْوَادِ ٱلْمُقَدَّسِ طُوًى","meaning":"Hani, Rabbi ona, mukaddes Tuva’da seslenmişti.","words":[{"arabic":"إِذْ","meaning":"hani"},{"arabic":"نَادَىٰهُ","meaning":"ona seslenmişti"},{"arabic":"رَبُّهُۥ","meaning":"Rabbi"},{"arabic":"بِٱلْوَادِ","meaning":"vadi'de"},{"arabic":"ٱلْمُقَدَّسِ","meaning":"kutsal"},{"arabic":"طُوًى","meaning":"Tuva'da"}]},{"number":17,"reference":"79:17","arabic":"ٱذْهَبْ إِلَىٰ فِرْعَوْنَ إِنَّهُۥ طَغَىٰ","meaning":"Firavun’a git, çünkü o azdı.","words":[{"arabic":"ٱذْهَبْ","meaning":"git"},{"arabic":"إِلَىٰ","meaning":"Fir'avn'a"},{"arabic":"فِرْعَوْنَ","meaning":""},{"arabic":"إِنَّهُۥ","meaning":"çünkü o"},{"arabic":"طَغَىٰ","meaning":"azdı"}]},{"number":18,"reference":"79:18","arabic":"فَقُلْ هَل لَّكَ إِلَىٰٓ أَن تَزَكَّىٰ","meaning":"Ve de ki: Arınmaya istekli misin?","words":[{"arabic":"فَقُلْ","meaning":"de ki"},{"arabic":"هَل","meaning":"istermisin?"},{"arabic":"لَّكَ","meaning":""},{"arabic":"إِلَىٰٓ","meaning":"arınmayı"},{"arabic":"أَن","meaning":""},{"arabic":"تَزَكَّىٰ","meaning":""}]},{"number":19,"reference":"79:19","arabic":"وَأَهْدِيَكَ إِلَىٰ رَبِّكَ فَتَخْشَىٰ","meaning":"Seni Rabbine ileteyim de O’na karşı derinden korkasın!","words":[{"arabic":"وَأَهْدِيَكَ","meaning":"ve seni ileteyim"},{"arabic":"إِلَىٰ","meaning":"Rabbine"},{"arabic":"رَبِّكَ","meaning":""},{"arabic":"فَتَخْشَىٰ","meaning":"O'ndan korkasın"}]},{"number":20,"reference":"79:20","arabic":"فَأَرَىٰهُ ٱلْـَٔايَةَ ٱلْكُبْرَىٰ","meaning":"Ona en büyük ayeti gösterdi.","words":[{"arabic":"فَأَرَىٰهُ","meaning":"sonra ona gösterdi"},{"arabic":"ٱلْـَٔايَةَ","meaning":"mu'cizeyi"},{"arabic":"ٱلْكُبْرَىٰ","meaning":"büyük"}]},{"number":21,"reference":"79:21","arabic":"فَكَذَّبَ وَعَصَىٰ","meaning":"Fakat o yalanladı ve isyan etti.","words":[{"arabic":"فَكَذَّبَ","meaning":"fakat o yalanladı"},{"arabic":"وَعَصَىٰ","meaning":"ve karşı geldi"}]},{"number":22,"reference":"79:22","arabic":"ثُمَّ أَدْبَرَ يَسْعَىٰ","meaning":"Sonra arkasını dönüp, koşmaya başladı.","words":[{"arabic":"ثُمَّ","meaning":"sonra"},{"arabic":"أَدْبَرَ","meaning":"sırtını döndü"},{"arabic":"يَسْعَىٰ","meaning":"çalışmağa koyuldu"}]},{"number":23,"reference":"79:23","arabic":"فَحَشَرَ فَنَادَىٰ","meaning":"Toplayıp şöyle seslendi:","words":[{"arabic":"فَحَشَرَ","meaning":"topladı"},{"arabic":"فَنَادَىٰ","meaning":"ve bağırdı"}]},{"number":24,"reference":"79:24","arabic":"فَقَالَ أَنَا۠ رَبُّكُمُ ٱلْأَعْلَىٰ","meaning":"Sizin en yüce rabbiniz benim, dedi.","words":[{"arabic":"فَقَالَ","meaning":"ve dedi"},{"arabic":"أَنَا۠","meaning":"ben"},{"arabic":"رَبُّكُمُ","meaning":"sizi Rabbinizim"},{"arabic":"ٱلْأَعْلَىٰ","meaning":"en yüce"}]},{"number":25,"reference":"79:25","arabic":"فَأَخَذَهُ ٱللَّهُ نَكَالَ ٱلْـَٔاخِرَةِ وَٱلْأُولَىٰٓ","meaning":"Allah da onu dünya ve ahiret azabıyla yakaladı.","words":[{"arabic":"فَأَخَذَهُ","meaning":"onu cezalandırdı"},{"arabic":"ٱللَّهُ","meaning":"Allah"},{"arabic":"نَكَالَ","meaning":"azabıyle"},{"arabic":"ٱلْـَٔاخِرَةِ","meaning":"sonun"},{"arabic":"وَٱلْأُولَىٰٓ","meaning":"ve ilkin"}]},{"number":26,"reference":"79:26","arabic":"إِنَّ فِى ذَٰلِكَ لَعِبْرَةً لِّمَن يَخْشَىٰٓ","meaning":"İşte bunda gerçekten korkan kimse için bir ibret vardır.","words":[{"arabic":"إِنَّ","meaning":"şüphesiz"},{"arabic":"فِى","meaning":"vardır"},{"arabic":"ذَٰلِكَ","meaning":"bunda"},{"arabic":"لَعِبْرَةًۭ","meaning":"elbette ibret(ler)"},{"arabic":"لِّمَن","meaning":"kimseler için"},{"arabic":"يَخْشَىٰٓ","meaning":"korkacak"}]},{"number":27,"reference":"79:27","arabic":"ءَأَنتُمْ أَشَدُّ خَلْقًا أَمِ ٱلسَّمَآءُ ۚ بَنَىٰهَا","meaning":"(Ölümden sonra) Sizi mi (yeniden) yaratmak daha güçtür, yoksa göğü mü? Onu bina etti.","words":[{"arabic":"ءَأَنتُمْ","meaning":"siz mi?"},{"arabic":"أَشَدُّ","meaning":"daha çetinsiniz"},{"arabic":"خَلْقًا","meaning":"yaratılışça"},{"arabic":"أَمِ","meaning":"yoksa"},{"arabic":"ٱلسَّمَآءُ ۚ","meaning":"gök (mü?)"},{"arabic":"بَنَىٰهَا","meaning":"(Allah) onu yaptı"}]},{"number":28,"reference":"79:28","arabic":"رَفَعَ سَمْكَهَا فَسَوَّىٰهَا","meaning":"Onun tavanını yükseltti ve düzenledi.","words":[{"arabic":"رَفَعَ","meaning":"yükseltti"},{"arabic":"سَمْكَهَا","meaning":"kalınlığını"},{"arabic":"فَسَوَّىٰهَا","meaning":"onu düzenledi"}]},{"number":29,"reference":"79:29","arabic":"وَأَغْطَشَ لَيْلَهَا وَأَخْرَجَ ضُحَىٰهَا","meaning":"Gecesini karanlık yaptı, gündüzünü aydınlığa çıkardı.","words":[{"arabic":"وَأَغْطَشَ","meaning":"örtüp kararttı"},{"arabic":"لَيْلَهَا","meaning":"gecesini"},{"arabic":"وَأَخْرَجَ","meaning":"ve açığa çıkardı"},{"arabic":"ضُحَىٰهَا","meaning":"kuşluğunu"}]},{"number":30,"reference":"79:30","arabic":"وَٱلْأَرْضَ بَعْدَ ذَٰلِكَ دَحَىٰهَآ","meaning":"Ve yeri bundan sonra yaydı.","words":[{"arabic":"وَٱلْأَرْضَ","meaning":"ve yeri"},{"arabic":"بَعْدَ","meaning":"sonra da"},{"arabic":"ذَٰلِكَ","meaning":"bundan"},{"arabic":"دَحَىٰهَآ","meaning":"yayıp yuvarlattı"}]},{"number":31,"reference":"79:31","arabic":"أَخْرَجَ مِنْهَا مَآءَهَا وَمَرْعَىٰهَا","meaning":"Ondan suyunu ve otlağını çıkardı.","words":[{"arabic":"أَخْرَجَ","meaning":"çıkardı"},{"arabic":"مِنْهَا","meaning":"ondan"},{"arabic":"مَآءَهَا","meaning":"suyunu"},{"arabic":"وَمَرْعَىٰهَا","meaning":"ve otlağını"}]},{"number":32,"reference":"79:32","arabic":"وَٱلْجِبَالَ أَرْسَىٰهَا","meaning":"Dağları da yerleştirdi.","words":[{"arabic":"وَٱلْجِبَالَ","meaning":"ve dağları"},{"arabic":"أَرْسَىٰهَا","meaning":"oturttu"}]},{"number":33,"reference":"79:33","arabic":"مَتَـٰعًا لَّكُمْ وَلِأَنْعَـٰمِكُمْ","meaning":"Sizin ve hayvanlarınızın yararlanması için…","words":[{"arabic":"مَتَـٰعًۭا","meaning":"(bunlar) geçimidir"},{"arabic":"لَّكُمْ","meaning":"sizin için"},{"arabic":"وَلِأَنْعَـٰمِكُمْ","meaning":"ve hayvanlarınız için"}]},{"number":34,"reference":"79:34","arabic":"فَإِذَا جَآءَتِ ٱلطَّآمَّةُ ٱلْكُبْرَىٰ","meaning":"En büyük kıyamet (ikinci üfleniş) geldiği zaman,","words":[{"arabic":"فَإِذَا","meaning":"zaman"},{"arabic":"جَآءَتِ","meaning":"geldiği"},{"arabic":"ٱلطَّآمَّةُ","meaning":"herşeyi bastıran o felaket"},{"arabic":"ٱلْكُبْرَىٰ","meaning":"büyük"}]},{"number":35,"reference":"79:35","arabic":"يَوْمَ يَتَذَكَّرُ ٱلْإِنسَـٰنُ مَا سَعَىٰ","meaning":"İnsanın yapıp ettiklerini hatırlayacağı gün,","words":[{"arabic":"يَوْمَ","meaning":"o gün"},{"arabic":"يَتَذَكَّرُ","meaning":"hatırlar"},{"arabic":"ٱلْإِنسَـٰنُ","meaning":"insan"},{"arabic":"مَا","meaning":"neye"},{"arabic":"سَعَىٰ","meaning":"çalıştığını"}]},{"number":36,"reference":"79:36","arabic":"وَبُرِّزَتِ ٱلْجَحِيمُ لِمَن يَرَىٰ","meaning":"Cehennem, görenler için apaçık bir şekilde gösterilir.","words":[{"arabic":"وَبُرِّزَتِ","meaning":"ve ortaya çıkarılmıştır"},{"arabic":"ٱلْجَحِيمُ","meaning":"cehennem"},{"arabic":"لِمَن","meaning":"kimseler için"},{"arabic":"يَرَىٰ","meaning":"gören"}]},{"number":37,"reference":"79:37","arabic":"فَأَمَّا مَن طَغَىٰ","meaning":"Kim azdıysa,","words":[{"arabic":"فَأَمَّا","meaning":"artık"},{"arabic":"مَن","meaning":"kim"},{"arabic":"طَغَىٰ","meaning":"azmışsa"}]},{"number":38,"reference":"79:38","arabic":"وَءَاثَرَ ٱلْحَيَوٰةَ ٱلدُّنْيَا","meaning":"Dünya hayatını tercih ettiyse,","words":[{"arabic":"وَءَاثَرَ","meaning":"ve yeğlemişse"},{"arabic":"ٱلْحَيَوٰةَ","meaning":"hayatını"},{"arabic":"ٱلدُّنْيَا","meaning":"dünya"}]},{"number":39,"reference":"79:39","arabic":"فَإِنَّ ٱلْجَحِيمَ هِىَ ٱلْمَأْوَىٰ","meaning":"Cehennem onun varacağı barınaktır.","words":[{"arabic":"فَإِنَّ","meaning":"elbette"},{"arabic":"ٱلْجَحِيمَ","meaning":"cehennemdir"},{"arabic":"هِىَ","meaning":"onun"},{"arabic":"ٱلْمَأْوَىٰ","meaning":"barınağı"}]},{"number":40,"reference":"79:40","arabic":"وَأَمَّا مَنْ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى ٱلنَّفْسَ عَنِ ٱلْهَوَىٰ","meaning":"Ama, kim de Rabbinin makamından korkup, kendisini heveslerine uymaktan alıkoymuşsa,","words":[{"arabic":"وَأَمَّا","meaning":"ama"},{"arabic":"مَنْ","meaning":"kim"},{"arabic":"خَافَ","meaning":"korkmuşsa"},{"arabic":"مَقَامَ","meaning":"divanında durmaktan"},{"arabic":"رَبِّهِۦ","meaning":"Rabbinin"},{"arabic":"وَنَهَى","meaning":"ve men'etmişse"},{"arabic":"ٱلنَّفْسَ","meaning":"nefsi(ni)"},{"arabic":"عَنِ","meaning":"0"},{"arabic":"ٱلْهَوَىٰ","meaning":"kötü heves(ler)-"}]},{"number":41,"reference":"79:41","arabic":"فَإِنَّ ٱلْجَنَّةَ هِىَ ٱلْمَأْوَىٰ","meaning":"Cennet de onun barınağıdır.","words":[{"arabic":"فَإِنَّ","meaning":"cennettir"},{"arabic":"ٱلْجَنَّةَ","meaning":""},{"arabic":"هِىَ","meaning":"onun"},{"arabic":"ٱلْمَأْوَىٰ","meaning":"barınağı"}]},{"number":42,"reference":"79:42","arabic":"يَسْـَٔلُونَكَ عَنِ ٱلسَّاعَةِ أَيَّانَ مُرْسَىٰهَا","meaning":"Sana kıyametin ne zaman gelip, çatacağını soruyorlar.","words":[{"arabic":"يَسْـَٔلُونَكَ","meaning":"sana soruyorlar"},{"arabic":"عَنِ","meaning":"sa'atten"},{"arabic":"ٱلسَّاعَةِ","meaning":""},{"arabic":"أَيَّانَ","meaning":"ne zaman?"},{"arabic":"مُرْسَىٰهَا","meaning":"demir atacak"}]},{"number":43,"reference":"79:43","arabic":"فِيمَ أَنتَ مِن ذِكْرَىٰهَآ","meaning":"Sen onu nereden bileceksin.","words":[{"arabic":"فِيمَ","meaning":"ne (bilirsin)?"},{"arabic":"أَنتَ","meaning":"sen"},{"arabic":"مِن","meaning":"onun söyleyesin"},{"arabic":"ذِكْرَىٰهَآ","meaning":""}]},{"number":44,"reference":"79:44","arabic":"إِلَىٰ رَبِّكَ مُنتَهَىٰهَآ","meaning":"Rabbine aittir, onun sonucu..","words":[{"arabic":"إِلَىٰ","meaning":"aittir"},{"arabic":"رَبِّكَ","meaning":"Rabbine"},{"arabic":"مُنتَهَىٰهَآ","meaning":"onun bilgisi"}]},{"number":45,"reference":"79:45","arabic":"إِنَّمَآ أَنتَ مُنذِرُ مَن يَخْشَىٰهَا","meaning":"Sen ancak ondan korkan kimseye bir uyarıcısın.","words":[{"arabic":"إِنَّمَآ","meaning":"ancak"},{"arabic":"أَنتَ","meaning":"sen"},{"arabic":"مُنذِرُ","meaning":"uyarıcısın"},{"arabic":"مَن","meaning":"olanları"},{"arabic":"يَخْشَىٰهَا","meaning":"ondan korkacak"}]},{"number":46,"reference":"79:46","arabic":"كَأَنَّهُمْ يَوْمَ يَرَوْنَهَا لَمْ يَلْبَثُوٓا۟ إِلَّا عَشِيَّةً أَوْ ضُحَىٰهَا","meaning":"Onu gördükleri gün, onlar sanki, sadece bir akşam veya bir kuşluk vakti süresince (dünyada) kalmış olurlar.","words":[{"arabic":"كَأَنَّهُمْ","meaning":"onlar sanki gibidir"},{"arabic":"يَوْمَ","meaning":"gün"},{"arabic":"يَرَوْنَهَا","meaning":"onu gördükleri"},{"arabic":"لَمْ","meaning":"(dünyada) kalmamışlar"},{"arabic":"يَلْبَثُوٓا۟","meaning":""},{"arabic":"إِلَّا","meaning":"başka"},{"arabic":"عَشِيَّةً","meaning":"bir akşamdan"},{"arabic":"أَوْ","meaning":"veya"},{"arabic":"ضُحَىٰهَا","meaning":"onun kuşluk vaktinden"}]}]}
