{"number":95,"source":"Kur’an metni ve kelime çözümlemesi: Quran.com · Türkçe meal: Shaban Britch; birleşik dört ayetin ayrımı: Dar Al-Salam Center","verses":[{"number":1,"reference":"95:1","arabic":"وَٱلتِّينِ وَٱلزَّيْتُونِ","meaning":"Andolsun, İncir ve zeytine,","words":[{"arabic":"وَٱلتِّينِ","meaning":"incire andolsun"},{"arabic":"وَٱلزَّيْتُونِ","meaning":"ve zeytine"}]},{"number":2,"reference":"95:2","arabic":"وَطُورِ سِينِينَ","meaning":"Sina Dağı’na,","words":[{"arabic":"وَطُورِ","meaning":"ve dağına"},{"arabic":"سِينِينَ","meaning":"sina"}]},{"number":3,"reference":"95:3","arabic":"وَهَـٰذَا ٱلْبَلَدِ ٱلْأَمِينِ","meaning":"Ve bu güvenli beldeye,","words":[{"arabic":"وَهَـٰذَا","meaning":"ve bu"},{"arabic":"ٱلْبَلَدِ","meaning":"Şehre (andolsun)"},{"arabic":"ٱلْأَمِينِ","meaning":"güvenli"}]},{"number":4,"reference":"95:4","arabic":"لَقَدْ خَلَقْنَا ٱلْإِنسَـٰنَ فِىٓ أَحْسَنِ تَقْوِيمٍ","meaning":"Biz, insanı en güzel şekilde yarattık.","words":[{"arabic":"لَقَدْ","meaning":"andolsun"},{"arabic":"خَلَقْنَا","meaning":"biz yarattık"},{"arabic":"ٱلْإِنسَـٰنَ","meaning":"insanı"},{"arabic":"فِىٓ","meaning":"en güzel"},{"arabic":"أَحْسَنِ","meaning":""},{"arabic":"تَقْوِيمٍۢ","meaning":"biçimde"}]},{"number":5,"reference":"95:5","arabic":"ثُمَّ رَدَدْنَـٰهُ أَسْفَلَ سَـٰفِلِينَ","meaning":"Daha sonra, onu aşağıların en aşağısına indirdik.","words":[{"arabic":"ثُمَّ","meaning":"sonra"},{"arabic":"رَدَدْنَـٰهُ","meaning":"onu çevirdik"},{"arabic":"أَسْفَلَ","meaning":"aşağıların"},{"arabic":"سَـٰفِلِينَ","meaning":"aşağısına"}]},{"number":6,"reference":"95:6","arabic":"إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ فَلَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍ","meaning":"Fakat iman edip salih amel işleyenler için eksilmeyen devamlı bir ecir vardır.","words":[{"arabic":"إِلَّا","meaning":"yalnız hariç"},{"arabic":"ٱلَّذِينَ","meaning":"kimseler"},{"arabic":"ءَامَنُوا۟","meaning":"inanan(lar)"},{"arabic":"وَعَمِلُوا۟","meaning":"ve yapanlar"},{"arabic":"ٱلصَّـٰلِحَـٰتِ","meaning":"iyi işler"},{"arabic":"فَلَهُمْ","meaning":"onlar için vardır"},{"arabic":"أَجْرٌ","meaning":"bir mükafat"},{"arabic":"غَيْرُ","meaning":"olmayan"},{"arabic":"مَمْنُونٍۢ","meaning":"kesintisi"}]},{"number":7,"reference":"95:7","arabic":"فَمَا يُكَذِّبُكَ بَعْدُ بِٱلدِّينِ","meaning":"O halde, sana hesap gününü yalan saydıran nedir?","words":[{"arabic":"فَمَا","meaning":"nedir?"},{"arabic":"يُكَذِّبُكَ","meaning":"sana yalanlatan"},{"arabic":"بَعْدُ","meaning":"bundan sonra"},{"arabic":"بِٱلدِّينِ","meaning":"dini"}]},{"number":8,"reference":"95:8","arabic":"أَلَيْسَ ٱللَّهُ بِأَحْكَمِ ٱلْحَـٰكِمِينَ","meaning":"Allah, hüküm verenlerin en üstünü değil midir?","words":[{"arabic":"أَلَيْسَ","meaning":"değil midir?"},{"arabic":"ٱللَّهُ","meaning":"Allah"},{"arabic":"بِأَحْكَمِ","meaning":"en iyi hüküm vereni"},{"arabic":"ٱلْحَـٰكِمِينَ","meaning":"hüküm verenlerin"}]}]}
