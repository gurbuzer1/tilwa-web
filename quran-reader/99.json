{"number":99,"source":"Kur’an metni ve kelime çözümlemesi: Quran.com · Türkçe meal: Shaban Britch; birleşik dört ayetin ayrımı: Dar Al-Salam Center","verses":[{"number":1,"reference":"99:1","arabic":"إِذَا زُلْزِلَتِ ٱلْأَرْضُ زِلْزَالَهَا","meaning":"Yer, şiddetle sarsıldığı zaman,","words":[{"arabic":"إِذَا","meaning":"zaman"},{"arabic":"زُلْزِلَتِ","meaning":"sarsıldığı"},{"arabic":"ٱلْأَرْضُ","meaning":"yer"},{"arabic":"زِلْزَالَهَا","meaning":"yaman sarsıntı ile"}]},{"number":2,"reference":"99:2","arabic":"وَأَخْرَجَتِ ٱلْأَرْضُ أَثْقَالَهَا","meaning":"Yer, ağırlıklarını çıkardığı zaman,","words":[{"arabic":"وَأَخْرَجَتِ","meaning":"ve çıkardığı (zaman)"},{"arabic":"ٱلْأَرْضُ","meaning":"yer"},{"arabic":"أَثْقَالَهَا","meaning":"ağırlıklarını"}]},{"number":3,"reference":"99:3","arabic":"وَقَالَ ٱلْإِنسَـٰنُ مَا لَهَا","meaning":"İnsan: Buna ne oluyor? dediğinde,","words":[{"arabic":"وَقَالَ","meaning":"ve dediği (zaman)"},{"arabic":"ٱلْإِنسَـٰنُ","meaning":"insan"},{"arabic":"مَا","meaning":"ne oluyor?"},{"arabic":"لَهَا","meaning":"ona"}]},{"number":4,"reference":"99:4","arabic":"يَوْمَئِذٍ تُحَدِّثُ أَخْبَارَهَا","meaning":"O gün haberlerini anlatır.","words":[{"arabic":"يَوْمَئِذٍۢ","meaning":"işte o gün"},{"arabic":"تُحَدِّثُ","meaning":"söyler"},{"arabic":"أَخْبَارَهَا","meaning":"haberlerini"}]},{"number":5,"reference":"99:5","arabic":"بِأَنَّ رَبَّكَ أَوْحَىٰ لَهَا","meaning":"Çünkü Rabbin ona vahyetmiştir.","words":[{"arabic":"بِأَنَّ","meaning":"çünkü"},{"arabic":"رَبَّكَ","meaning":"Rabbin"},{"arabic":"أَوْحَىٰ","meaning":"vahyetmiştir"},{"arabic":"لَهَا","meaning":"ona"}]},{"number":6,"reference":"99:6","arabic":"يَوْمَئِذٍ يَصْدُرُ ٱلنَّاسُ أَشْتَاتًا لِّيُرَوْا۟ أَعْمَـٰلَهُمْ","meaning":"O gün insanlar, amelleri kendilerine gösterilmek için bölük bölük dönerler.","words":[{"arabic":"يَوْمَئِذٍۢ","meaning":"o gün"},{"arabic":"يَصْدُرُ","meaning":"çıkarlar"},{"arabic":"ٱلنَّاسُ","meaning":"insanlar"},{"arabic":"أَشْتَاتًۭا","meaning":"ayrı ayrı gruplar halinde"},{"arabic":"لِّيُرَوْا۟","meaning":"gösterilsin diye"},{"arabic":"أَعْمَـٰلَهُمْ","meaning":"yaptıkları işler"}]},{"number":7,"reference":"99:7","arabic":"فَمَن يَعْمَلْ مِثْقَالَ ذَرَّةٍ خَيْرًا يَرَهُۥ","meaning":"Kim zerre ağırlığınca iyilik yapmışsa onu görür.","words":[{"arabic":"فَمَن","meaning":"artık kim"},{"arabic":"يَعْمَلْ","meaning":"yapmışsa"},{"arabic":"مِثْقَالَ","meaning":"ağırlığınca"},{"arabic":"ذَرَّةٍ","meaning":"zerre"},{"arabic":"خَيْرًۭا","meaning":"hayır"},{"arabic":"يَرَهُۥ","meaning":"onu görür"}]},{"number":8,"reference":"99:8","arabic":"وَمَن يَعْمَلْ مِثْقَالَ ذَرَّةٍ شَرًّا يَرَهُۥ","meaning":"Kim de zerre ağırlığınca kötülük yapmışsa onu görür.","words":[{"arabic":"وَمَن","meaning":"ve kim"},{"arabic":"يَعْمَلْ","meaning":"yapmışsa"},{"arabic":"مِثْقَالَ","meaning":"ağırlığınca"},{"arabic":"ذَرَّةٍۢ","meaning":"zerre"},{"arabic":"شَرًّۭا","meaning":"şer"},{"arabic":"يَرَهُۥ","meaning":"onu görür"}]}]}
