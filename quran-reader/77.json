eaning":"suçlularsınız"}]},{"number":47,"reference":"77:47","arabic":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","meaning":"Vay haline o gün, yalanlayanların!","words":[{"arabic":"وَيْلٌۭ","meaning":"vay haline"},{"arabic":"يَوْمَئِذٍۢ","meaning":"o gün"},{"arabic":"لِّلْمُكَذِّبِينَ","meaning":"yalanlayanların"}]},{"number":48,"reference":"77:48","arabic":"وَإِذَا قِيلَ لَهُمُ ٱرْكَعُوا۟ لَا يَرْكَعُونَ","meaning":"Onlara, “Rükû edin!” denildiği zaman, rükû etmezlerdi.","words":[{"arabic":"وَإِذَا","meaning":"ve zaman"},{"arabic":"قِيلَ","meaning":"dendiği"},{"arabic":"لَهُمُ","meaning":"onlara"},{"arabic":"ٱرْكَعُوا۟","meaning":"rüku' edin"},{"arabic":"لَا","meaning":"rüku' etmezler"},{"arabic":"يَرْكَعُونَ","meaning":""}]},{"number":49,"reference":"77:49","arabic":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","meaning":"Vay haline o gün, yalanlayanların!","words":[{"arabic":"وَيْلٌۭ","meaning":"vay haline"},{"arabic":"يَوْمَئِذٍۢ","meaning":"o gün"},{"arabic":"لِّلْمُكَذِّبِينَ","meaning":"yalanlayanların"}]},{"number":50,"reference":"77:50","arabic":"فَبِأَىِّ حَدِيثٍۭ بَعْدَهُۥ يُؤْمِنُونَ","meaning":"Onlar artık bundan (Kur'an'dan) sonra hangi söze iman edecekler?","words":[{"arabic":"فَبِأَىِّ","meaning":"hangi?"},{"arabic":"حَدِيثٍۭ","meaning":"söze"},{"arabic":"بَعْدَهُۥ","meaning":"bundan sonra"},{"arabic":"يُؤْمِنُونَ","meaning":"inanacaklar"}]}]}
