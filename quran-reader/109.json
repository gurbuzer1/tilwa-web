{"number":109,"source":"Kur’an metni ve kelime çözümlemesi: Quran.com · Türkçe meal: Shaban Britch; birleşik dört ayetin ayrımı: Dar Al-Salam Center","verses":[{"number":1,"reference":"109:1","arabic":"قُلْ يَـٰٓأَيُّهَا ٱلْكَـٰفِرُونَ","meaning":"De ki: Ey Kafirler!","words":[{"arabic":"قُلْ","meaning":"de ki"},{"arabic":"يَـٰٓأَيُّهَا","meaning":"ey"},{"arabic":"ٱلْكَـٰفِرُونَ","meaning":"inkar edenler"}]},{"number":2,"reference":"109:2","arabic":"لَآ أَعْبُدُ مَا تَعْبُدُونَ","meaning":"Ben sizin ibadet ettiğinize ibadet etmem.","words":[{"arabic":"لَآ","meaning":"ben ibadet etmem"},{"arabic":"أَعْبُدُ","meaning":""},{"arabic":"مَا","meaning":"şeye"},{"arabic":"تَعْبُدُونَ","meaning":"sizin taptığınız"}]},{"number":3,"reference":"109:3","arabic":"وَلَآ أَنتُمْ عَـٰبِدُونَ مَآ أَعْبُدُ","meaning":"Siz de benim ibadet ettiğime ibadet edenler değilsiniz.","words":[{"arabic":"وَلَآ","meaning":"ve (etmezsiniz)"},{"arabic":"أَنتُمْ","meaning":"siz de"},{"arabic":"عَـٰبِدُونَ","meaning":"ibadeti"},{"arabic":"مَآ","meaning":"benim taptığıma"},{"arabic":"أَعْبُدُ","meaning":""}]},{"number":4,"reference":"109:4","arabic":"وَلَآ أَنَا۠ عَابِدٌ مَّا عَبَدتُّمْ","meaning":"Ben sizin ibadet ettiğinize ibadet edici değilim.","words":[{"arabic":"وَلَآ","meaning":"ve değil(im)"},{"arabic":"أَنَا۠","meaning":"ben"},{"arabic":"عَابِدٌۭ","meaning":"ibadet eden"},{"arabic":"مَّا","meaning":"sizin taptıklarınıza"},{"arabic":"عَبَدتُّمْ","meaning":""}]},{"number":5,"reference":"109:5","arabic":"وَلَآ أَنتُمْ عَـٰبِدُونَ مَآ أَعْبُدُ","meaning":"Siz de benim ibadet ettiğime ibadet ediciler değilsiniz.","words":[{"arabic":"وَلَآ","meaning":"ve değilsiniz"},{"arabic":"أَنتُمْ","meaning":"siz de"},{"arabic":"عَـٰبِدُونَ","meaning":"ibadet eden"},{"arabic":"مَآ","meaning":"benim ibadet ettiğime"},{"arabic":"أَعْبُدُ","meaning":""}]},{"number":6,"reference":"109:6","arabic":"لَكُمْ دِينُكُمْ وَلِىَ دِينِ","meaning":"Sizin dininiz size, benim dinim bana!","words":[{"arabic":"لَكُمْ","meaning":"sizindir"},{"arabic":"دِينُكُمْ","meaning":"sizin dininiz"},{"arabic":"وَلِىَ","meaning":"ve benimdir"},{"arabic":"دِينِ","meaning":"benim dinim"}]}]}
