{"number":85,"source":"Kur’an metni ve kelime çözümlemesi: Quran.com · Türkçe meal: Shaban Britch; birleşik dört ayetin ayrımı: Dar Al-Salam Center","verses":[{"number":1,"reference":"85:1","arabic":"وَٱلسَّمَآءِ ذَاتِ ٱلْبُرُوجِ","meaning":"Yıldızların (yörüngelerine) sahip göğe andolsun.","words":[{"arabic":"وَٱلسَّمَآءِ","meaning":"göğe andolsun"},{"arabic":"ذَاتِ","meaning":"sahibi"},{"arabic":"ٱلْبُرُوجِ","meaning":"burçlar"}]},{"number":2,"reference":"85:2","arabic":"وَٱلْيَوْمِ ٱلْمَوْعُودِ","meaning":"Ve vaad edilen güne.","words":[{"arabic":"وَٱلْيَوْمِ","meaning":"ve güne andolsun"},{"arabic":"ٱلْمَوْعُودِ","meaning":"va'dedilen"}]},{"number":3,"reference":"85:3","arabic":"وَشَاهِدٍ وَمَشْهُودٍ","meaning":"Şahid olana ve şahid olunana.","words":[{"arabic":"وَشَاهِدٍۢ","meaning":"ve şahide andolsun"},{"arabic":"وَمَشْهُودٍۢ","meaning":"ve şahidlik edilene"}]},{"number":4,"reference":"85:4","arabic":"قُتِلَ أَصْحَـٰبُ ٱلْأُخْدُودِ","meaning":"Kahrolsun hendek sahipleri!","words":[{"arabic":"قُتِلَ","meaning":"kahroldu"},{"arabic":"أَصْحَـٰبُ","meaning":"adamları"},{"arabic":"ٱلْأُخْدُودِ","meaning":"hendeğin"}]},{"number":5,"reference":"85:5","arabic":"ٱلنَّارِ ذَاتِ ٱلْوَقُودِ","meaning":"Tutuşturulmuş ateş.","words":[{"arabic":"ٱلنَّارِ","meaning":"ateş"},{"arabic":"ذَاتِ","meaning":"dolu"},{"arabic":"ٱلْوَقُودِ","meaning":"tutuşturulmuş yakıt"}]},{"number":6,"reference":"85:6","arabic":"إِذْ هُمْ عَلَيْهَا قُعُودٌ","meaning":"Kenarında oturmuşlar.","words":[{"arabic":"إِذْ","meaning":"hani"},{"arabic":"هُمْ","meaning":"onlar"},{"arabic":"عَلَيْهَا","meaning":"onun başında"},{"arabic":"قُعُودٌۭ","meaning":"oturmuşlardı"}]},{"number":7,"reference":"85:7","arabic":"وَهُمْ عَلَىٰ مَا يَفْعَلُونَ بِٱلْمُؤْمِنِينَ شُهُودٌ","meaning":"Müminlere yaptıklarını seyretmekteler.","words":[{"arabic":"وَهُمْ","meaning":"ve onlar"},{"arabic":"عَلَىٰ","meaning":"şeyleri"},{"arabic":"مَا","meaning":""},{"arabic":"يَفْعَلُونَ","meaning":"yaptıkları"},{"arabic":"بِٱلْمُؤْمِنِينَ","meaning":"mü'minlere"},{"arabic":"شُهُودٌۭ","meaning":"seyrediyorlardı"}]},{"number":8,"reference":"85:8","arabic":"وَمَا نَقَمُوا۟ مِنْهُمْ إِلَّآ أَن يُؤْمِنُوا۟ بِٱللَّهِ ٱلْعَزِيزِ ٱلْحَمِيدِ","meaning":"Onlardan sadece, Aziz ve Hamid olan Allah’a iman ettikleri için intikam alıyorlar.","words":[{"arabic":"وَمَا","meaning":"ve"},{"arabic":"نَقَمُوا۟","meaning":"öc almadılar"},{"arabic":"مِنْهُمْ","meaning":"onlardan"},{"arabic":"إِلَّآ","meaning":"başka bir sebeple"},{"arabic":"أَن","meaning":"inanmalarından"},{"arabic":"يُؤْمِنُوا۟","meaning":""},{"arabic":"بِٱللَّهِ","meaning":"Allah'a"},{"arabic":"ٱلْعَزِيزِ","meaning":"aziz"},{"arabic":"ٱلْحَمِيدِ","meaning":"övgüye layık"}]},{"number":9,"reference":"85:9","arabic":"ٱلَّذِى لَهُۥ مُلْكُ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۚ وَٱللَّهُ عَلَىٰ كُلِّ شَىْءٍ شَهِيدٌ","meaning":"Göklerin ve yerin mülkü kendisinin olan. Allah her şeye şahittir.","words":[{"arabic":"ٱلَّذِى","meaning":"O ki"},{"arabic":"لَهُۥ","meaning":"O'nundur"},{"arabic":"مُلْكُ","meaning":"hükümranlığı"},{"arabic":"ٱلسَّمَـٰوَٰتِ","meaning":"göklerin"},{"arabic":"وَٱلْأَرْضِ ۚ","meaning":"ve yerin"},{"arabic":"وَٱللَّهُ","meaning":"ve Allah"},{"arabic":"عَلَىٰ","meaning":"üzerine"},{"arabic":"كُلِّ","meaning":"her"},{"arabic":"شَىْءٍۢ","meaning":"şey"},{"arabic":"شَهِيدٌ","meaning":"tanıktır"}]},{"number":10,"reference":"85:10","arabic":"إِنَّ ٱلَّذِينَ فَتَنُوا۟ ٱلْمُؤْمِنِينَ وَٱلْمُؤْمِنَـٰتِ ثُمَّ لَمْ يَتُوبُوا۟ فَلَهُمْ عَذَابُ جَهَنَّمَ وَلَهُمْ عَذَابُ ٱلْحَرِيقِ","meaning":"Erkek ve kadın mü’minleri ateşe atıp, sonra da tevbe etmeyenlere, onlara Cehennem azabı vardır. Onlara yakıcı azap vardır.","words":[{"arabic":"إِنَّ","meaning":"şüphesiz"},{"arabic":"ٱلَّذِينَ","meaning":"kimseler"},{"arabic":"فَتَنُوا۟","meaning":"işkence eden(ler)"},{"arabic":"ٱلْمُؤْمِنِينَ","meaning":"inanan erkeklere"},{"arabic":"وَٱلْمُؤْمِنَـٰتِ","meaning":"ve inanan kadınlara"},{"arabic":"ثُمَّ","meaning":"sonra"},{"arabic":"لَمْ","meaning":"tevbe etmeyenler"},{"arabic":"يَتُوبُوا۟","meaning":""},{"arabic":"فَلَهُمْ","meaning":"onlar için vardır"},{"arabic":"عَذَابُ","meaning":"azabı"},{"arabic":"جَهَنَّمَ","meaning":"cehennem"},{"arabic":"وَلَهُمْ","meaning":"ve onlar için vardır"},{"arabic":"عَذَابُ","meaning":"azabı"},{"arabic":"ٱلْحَرِيقِ","meaning":"yangın"}]},{"number":11,"reference":"85:11","arabic":"إِنَّ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ لَهُمْ جَنَّـٰتٌ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَـٰرُ ۚ ذَٰلِكَ ٱلْفَوْزُ ٱلْكَبِيرُ","meaning":"İman edip, salih amel yapanlara, onlara alt tarafından ırmaklar akan cennetler var. İşte bu büyük kurtuluş…","words":[{"arabic":"إِنَّ","meaning":"şüphesiz"},{"arabic":"ٱلَّذِينَ","meaning":"kimseler"},{"arabic":"ءَامَنُوا۟","meaning":"inanan(lar)"},{"arabic":"وَعَمِلُوا۟","meaning":"ve yapanlar"},{"arabic":"ٱلصَّـٰلِحَـٰتِ","meaning":"iyi işler"},{"arabic":"لَهُمْ","meaning":"onlar için vardır"},{"arabic":"جَنَّـٰتٌۭ","meaning":"cennetler"},{"arabic":"تَجْرِى","meaning":"akan"},{"arabic":"مِن","meaning":"altlarından"},{"arabic":"تَحْتِهَا","meaning":""},{"arabic":"ٱلْأَنْهَـٰرُ ۚ","meaning":"ırmaklar"},{"arabic":"ذَٰلِكَ","meaning":"işte budur"},{"arabic":"ٱلْفَوْزُ","meaning":"başarı"},{"arabic":"ٱلْكَبِيرُ","meaning":"büyük"}]},{"number":12,"reference":"85:12","arabic":"إِنَّ بَطْشَ رَبِّكَ لَشَدِيدٌ","meaning":"Şüphesiz Rabbinin yakalayışı ise çok şiddetlidir.","words":[{"arabic":"إِنَّ","meaning":"şüphesiz"},{"arabic":"بَطْشَ","meaning":"tutuşu"},{"arabic":"رَبِّكَ","meaning":"Rabbinin"},{"arabic":"لَشَدِيدٌ","meaning":"şiddetlidir"}]},{"number":13,"reference":"85:13","arabic":"إِنَّهُۥ هُوَ يُبْدِئُ وَيُعِيدُ","meaning":"İlk defa yaratan ve tekrar diriltecek olan O’dur.","words":[{"arabic":"إِنَّهُۥ","meaning":"şüphesiz O"},{"arabic":"هُوَ","meaning":"O'dur"},{"arabic":"يُبْدِئُ","meaning":"ilkin var eden"},{"arabic":"وَيُعِيدُ","meaning":"sonra yeniden devam eden"}]},{"number":14,"reference":"85:14","arabic":"وَهُوَ ٱلْغَفُورُ ٱلْوَدُودُ","meaning":"Çok bağışlayıcıdır. Çok seven, sevilen O’dur.","words":[{"arabic":"وَهُوَ","meaning":"ve O"},{"arabic":"ٱلْغَفُورُ","meaning":"bağışlayandır"},{"arabic":"ٱلْوَدُودُ","meaning":"sevendir"}]},{"number":15,"reference":"85:15","arabic":"ذُو ٱلْعَرْشِ ٱلْمَجِيدُ","meaning":"Yüce arşın sahibi…","words":[{"arabic":"ذُو","meaning":"sahibidir"},{"arabic":"ٱلْعَرْشِ","meaning":"Arş'ın"},{"arabic":"ٱلْمَجِيدُ","meaning":"yücedir"}]},{"number":16,"reference":"85:16","arabic":"فَعَّالٌ لِّمَا يُرِيدُ","meaning":"Ne dilerse yapandır.","words":[{"arabic":"فَعَّالٌۭ","meaning":"yapandır"},{"arabic":"لِّمَا","meaning":"şeyi"},{"arabic":"يُرِيدُ","meaning":"istediği"}]},{"number":17,"reference":"85:17","arabic":"هَلْ أَتَىٰكَ حَدِيثُ ٱلْجُنُودِ","meaning":"Sana o orduların haberi gelmedi mi?","words":[{"arabic":"هَلْ","meaning":"sana geldimi?"},{"arabic":"أَتَىٰكَ","meaning":""},{"arabic":"حَدِيثُ","meaning":"haberi"},{"arabic":"ٱلْجُنُودِ","meaning":"orduların"}]},{"number":18,"reference":"85:18","arabic":"فِرْعَوْنَ وَثَمُودَ","meaning":"Firavun ve Semud’un...","words":[{"arabic":"فِرْعَوْنَ","meaning":"Fir'avn'ın"},{"arabic":"وَثَمُودَ","meaning":"ve Semud'un"}]},{"number":19,"reference":"85:19","arabic":"بَلِ ٱلَّذِينَ كَفَرُوا۟ فِى تَكْذِيبٍ","meaning":"Kâfir olanlar yalanlayıp duruyorlar.","words":[{"arabic":"بَلِ","meaning":"doğrusu"},{"arabic":"ٱلَّذِينَ","meaning":"kimseler"},{"arabic":"كَفَرُوا۟","meaning":"inkar eden(ler)"},{"arabic":"فِى","meaning":"içindedirler"},{"arabic":"تَكْذِيبٍۢ","meaning":"bir yalanlama"}]},{"number":20,"reference":"85:20","arabic":"وَٱللَّهُ مِن وَرَآئِهِم مُّحِيطٌۢ","meaning":"Allah ise onların arkasından kuşatandır.","words":[{"arabic":"وَٱللَّهُ","meaning":"fakat Allah"},{"arabic":"مِن","meaning":"onları arkalarından"},{"arabic":"وَرَآئِهِم","meaning":""},{"arabic":"مُّحِيطٌۢ","meaning":"kuşatmıştır"}]},{"number":21,"reference":"85:21","arabic":"بَلْ هُوَ قُرْءَانٌ مَّجِيدٌ","meaning":"Hayır! O şerefli Kur'an'dır.","words":[{"arabic":"بَلْ","meaning":"hayır"},{"arabic":"هُوَ","meaning":"o"},{"arabic":"قُرْءَانٌۭ","meaning":"bir Kur'an'dır"},{"arabic":"مَّجِيدٌۭ","meaning":"şerefli"}]},{"number":22,"reference":"85:22","arabic":"فِى لَوْحٍ مَّحْفُوظٍۭ","meaning":"Levh-i Mahfuz’dadır.","words":[{"arabic":"فِى","meaning":"bir levhadadır"},{"arabic":"لَوْحٍۢ","meaning":""},{"arabic":"مَّحْفُوظٍۭ","meaning":"korunan"}]}]}
