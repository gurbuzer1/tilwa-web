{"number":81,"source":"Kur’an metni ve kelime çözümlemesi: Quran.com · Türkçe meal: Shaban Britch; birleşik dört ayetin ayrımı: Dar Al-Salam Center","verses":[{"number":1,"reference":"81:1","arabic":"إِذَا ٱلشَّمْسُ كُوِّرَتْ","meaning":"Güneş dürüldüğü zaman.","words":[{"arabic":"إِذَا","meaning":"zaman"},{"arabic":"ٱلشَّمْسُ","meaning":"güneş"},{"arabic":"كُوِّرَتْ","meaning":"büzüldüğü"}]},{"number":2,"reference":"81:2","arabic":"وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ","meaning":"Yıldızlar, saçılıp dağıldığı zaman.","words":[{"arabic":"وَإِذَا","meaning":"ve zaman"},{"arabic":"ٱلنُّجُومُ","meaning":"yıldızlar"},{"arabic":"ٱنكَدَرَتْ","meaning":"kararıp döküldüğü"}]},{"number":3,"reference":"81:3","arabic":"وَإِذَا ٱلْجِبَالُ سُيِّرَتْ","meaning":"Dağlar yürütüldüğü zaman.","words":[{"arabic":"وَإِذَا","meaning":"ve zaman"},{"arabic":"ٱلْجِبَالُ","meaning":"dağlar"},{"arabic":"سُيِّرَتْ","meaning":"yürütüldüğü"}]},{"number":4,"reference":"81:4","arabic":"وَإِذَا ٱلْعِشَارُ عُطِّلَتْ","meaning":"Gebe develer başıboş bırakıldığı zaman.","words":[{"arabic":"وَإِذَا","meaning":"ve zaman"},{"arabic":"ٱلْعِشَارُ","meaning":"on aylık gebe develer"},{"arabic":"عُطِّلَتْ","meaning":"başı boş bırakıldığı"}]},{"number":5,"reference":"81:5","arabic":"وَإِذَا ٱلْوُحُوشُ حُشِرَتْ","meaning":"Vahşi hayvanlar toplandığı zaman.","words":[{"arabic":"وَإِذَا","meaning":"ve zaman"},{"arabic":"ٱلْوُحُوشُ","meaning":"vahşi hayvanlar"},{"arabic":"حُشِرَتْ","meaning":"bir araya toplandığı"}]},{"number":6,"reference":"81:6","arabic":"وَإِذَا ٱلْبِحَارُ سُجِّرَتْ","meaning":"Denizler kaynatıldığı zaman.","words":[{"arabic":"وَإِذَا","meaning":"ve zaman"},{"arabic":"ٱلْبِحَارُ","meaning":"denizler"},{"arabic":"سُجِّرَتْ","meaning":"kaynatıldığı"}]},{"number":7,"reference":"81:7","arabic":"وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ","meaning":"Nefisler/kişiler (benzerleriyle) birleştirildiği zaman.","words":[{"arabic":"وَإِذَا","meaning":"ve zaman"},{"arabic":"ٱلنُّفُوسُ","meaning":"nefisler"},{"arabic":"زُوِّجَتْ","meaning":"çiftleştirildiği"}]},{"number":8,"reference":"81:8","arabic":"وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ","meaning":"Diri diri gömülen kız çocuğuna sorulduğu zaman.","words":[{"arabic":"وَإِذَا","meaning":"ve zaman"},{"arabic":"ٱلْمَوْءُۥدَةُ","meaning":"o diri diri toprağa gömülen kıza"},{"arabic":"سُئِلَتْ","meaning":"sorulduğu"}]},{"number":9,"reference":"81:9","arabic":"بِأَىِّ ذَنۢبٍ قُتِلَتْ","meaning":"Hangi suçtan öldürüldüğü…","words":[{"arabic":"بِأَىِّ","meaning":"hangi?"},{"arabic":"ذَنۢبٍۢ","meaning":"günah (yüzünden)"},{"arabic":"قُتِلَتْ","meaning":"öldürüldü"}]},{"number":10,"reference":"81:10","arabic":"وَإِذَا ٱلصُّحُفُ نُشِرَتْ","meaning":"Sahifeler (amel defterleri) açıldığı zaman.","words":[{"arabic":"وَإِذَا","meaning":"ve zaman"},{"arabic":"ٱلصُّحُفُ","meaning":"defterler"},{"arabic":"نُشِرَتْ","meaning":"açılıp yayıldığı"}]},{"number":11,"reference":"81:11","arabic":"وَإِذَا ٱلسَّمَآءُ كُشِطَتْ","meaning":"Gök, sıyrılıp, ayrıldığı zaman.","words":[{"arabic":"وَإِذَا","meaning":"ve zaman"},{"arabic":"ٱلسَّمَآءُ","meaning":"gök"},{"arabic":"كُشِطَتْ","meaning":"sıyrılıp açıldığı"}]},{"number":12,"reference":"81:12","arabic":"وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ","meaning":"Cehennem alevlendirildiği zaman.","words":[{"arabic":"وَإِذَا","meaning":"ve zaman"},{"arabic":"ٱلْجَحِيمُ","meaning":"cehennem"},{"arabic":"سُعِّرَتْ","meaning":"alevlendirildiği"}]},{"number":13,"reference":"81:13","arabic":"وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ","meaning":"Cennet yaklaştırıldığı zaman.","words":[{"arabic":"وَإِذَا","meaning":"ve zaman"},{"arabic":"ٱلْجَنَّةُ","meaning":"cennet"},{"arabic":"أُزْلِفَتْ","meaning":"yaklaştırıldığı"}]},{"number":14,"reference":"81:14","arabic":"عَلِمَتْ نَفْسٌ مَّآ أَحْضَرَتْ","meaning":"Herkes ne hazırladığını bilecektir.","words":[{"arabic":"عَلِمَتْ","meaning":"bilir"},{"arabic":"نَفْسٌۭ","meaning":"her can"},{"arabic":"مَّآ","meaning":"ne"},{"arabic":"أَحْضَرَتْ","meaning":"yapıp getirdiğini"}]},{"number":15,"reference":"81:15","arabic":"فَلَآ أُقْسِمُ بِٱلْخُنَّسِ","meaning":"Hayır! Yemin ederim gizlenen (yıldızlara).","words":[{"arabic":"فَلَآ","meaning":"hayır"},{"arabic":"أُقْسِمُ","meaning":"yemin ederim"},{"arabic":"بِٱلْخُنَّسِ","meaning":"geri kalıp gizlenenlere"}]},{"number":16,"reference":"81:16","arabic":"ٱلْجَوَارِ ٱلْكُنَّسِ","meaning":"O akıp akıp yörüngesinde gidenlere.","words":[{"arabic":"ٱلْجَوَارِ","meaning":"akıp gidenlere"},{"arabic":"ٱلْكُنَّسِ","meaning":"dönüp saklananlara"}]},{"number":17,"reference":"81:17","arabic":"وَٱلَّيْلِ إِذَا عَسْعَسَ","meaning":"Karardığında geceye.","words":[{"arabic":"وَٱلَّيْلِ","meaning":"geceye"},{"arabic":"إِذَا","meaning":"zaman"},{"arabic":"عَسْعَسَ","meaning":"sırtını döndüğü"}]},{"number":18,"reference":"81:18","arabic":"وَٱلصُّبْحِ إِذَا تَنَفَّسَ","meaning":"Aydınlanmaya başladığında sabaha.","words":[{"arabic":"وَٱلصُّبْحِ","meaning":"ve sabaha"},{"arabic":"إِذَا","meaning":"zaman"},{"arabic":"تَنَفَّسَ","meaning":"soluk almağa başladığı"}]},{"number":19,"reference":"81:19","arabic":"إِنَّهُۥ لَقَوْلُ رَسُولٍ كَرِيمٍ","meaning":"Şüphesiz o, şerefli bir elçinin sözüdür.","words":[{"arabic":"إِنَّهُۥ","meaning":"şüphesiz o"},{"arabic":"لَقَوْلُ","meaning":"sözüdür"},{"arabic":"رَسُولٍۢ","meaning":"bir elçinin"},{"arabic":"كَرِيمٍۢ","meaning":"değerli"}]},{"number":20,"reference":"81:20","arabic":"ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍ","meaning":"Güçlü, Arş'ın sahibi yanında itibarlı.","words":[{"arabic":"ذِى","meaning":"sahibidir"},{"arabic":"قُوَّةٍ","meaning":"güç"},{"arabic":"عِندَ","meaning":"katında"},{"arabic":"ذِى","meaning":"sahibi"},{"arabic":"ٱلْعَرْشِ","meaning":"Arşın"},{"arabic":"مَكِينٍۢ","meaning":"yücedir"}]},{"number":21,"reference":"81:21","arabic":"مُّطَاعٍ ثَمَّ أَمِينٍ","meaning":"Sözü dinlenir, sonra güvenilir de.","words":[{"arabic":"مُّطَاعٍۢ","meaning":"ita'at edilendir"},{"arabic":"ثَمَّ","meaning":"orada"},{"arabic":"أَمِينٍۢ","meaning":"güvenilendir"}]},{"number":22,"reference":"81:22","arabic":"وَمَا صَاحِبُكُم بِمَجْنُونٍ","meaning":"Arkadaşınız mecnun değildir.","words":[{"arabic":"وَمَا","meaning":"ve değildir"},{"arabic":"صَاحِبُكُم","meaning":"arkadaşınız"},{"arabic":"بِمَجْنُونٍۢ","meaning":"cinli"}]},{"number":23,"reference":"81:23","arabic":"وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ","meaning":"Onu (Cebrail’i) apaçık ufukta görmüştür.","words":[{"arabic":"وَلَقَدْ","meaning":"ve andolsun"},{"arabic":"رَءَاهُ","meaning":"onu görmüştür"},{"arabic":"بِٱلْأُفُقِ","meaning":"ufukta"},{"arabic":"ٱلْمُبِينِ","meaning":"apaçık"}]},{"number":24,"reference":"81:24","arabic":"وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍ","meaning":"O, gayb hakkında cimri değildir.","words":[{"arabic":"وَمَا","meaning":"ve değildir"},{"arabic":"هُوَ","meaning":"O"},{"arabic":"عَلَى","meaning":"hakkında"},{"arabic":"ٱلْغَيْبِ","meaning":"gayb"},{"arabic":"بِضَنِينٍۢ","meaning":"cimri"}]},{"number":25,"reference":"81:25","arabic":"وَمَا هُوَ بِقَوْلِ شَيْطَـٰنٍ رَّجِيمٍ","meaning":"O, kovulmuş şeytanın sözü de değildir.","words":[{"arabic":"وَمَا","meaning":"ve değildir"},{"arabic":"هُوَ","meaning":"O"},{"arabic":"بِقَوْلِ","meaning":"sözü"},{"arabic":"شَيْطَـٰنٍۢ","meaning":"şeytanın"},{"arabic":"رَّجِيمٍۢ","meaning":"kovulmuş"}]},{"number":26,"reference":"81:26","arabic":"فَأَيْنَ تَذْهَبُونَ","meaning":"Öyleyse nereye gidiyorsunuz?","words":[{"arabic":"فَأَيْنَ","meaning":"o halde nereye?"},{"arabic":"تَذْهَبُونَ","meaning":"gidiyorsunuz"}]},{"number":27,"reference":"81:27","arabic":"إِنْ هُوَ إِلَّا ذِكْرٌ لِّلْعَـٰلَمِينَ","meaning":"O, ancak alemler için bir öğüttür.","words":[{"arabic":"إِنْ","meaning":"hayır"},{"arabic":"هُوَ","meaning":"O"},{"arabic":"إِلَّا","meaning":"ancak"},{"arabic":"ذِكْرٌۭ","meaning":"öğüttür"},{"arabic":"لِّلْعَـٰلَمِينَ","meaning":"alemlere"}]},{"number":28,"reference":"81:28","arabic":"لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ","meaning":"Sizden doğru yolu isteyenler için.","words":[{"arabic":"لِمَن","meaning":"kimse için"},{"arabic":"شَآءَ","meaning":"isteyen"},{"arabic":"مِنكُمْ","meaning":"aranızdan"},{"arabic":"أَن","meaning":"doğru hareket etmek"},{"arabic":"يَسْتَقِيمَ","meaning":""}]},{"number":29,"reference":"81:29","arabic":"وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَـٰلَمِينَ","meaning":"Alemlerin Rabbi Allah dilemedikçe siz de dileyemezsiniz.","words":[{"arabic":"وَمَا","meaning":"ve"},{"arabic":"تَشَآءُونَ","meaning":"siz dileyemezsiniz"},{"arabic":"إِلَّآ","meaning":"dışında"},{"arabic":"أَن","meaning":"dilemesi"},{"arabic":"يَشَآءَ","meaning":""},{"arabic":"ٱللَّهُ","meaning":"Allah(ın)"},{"arabic":"رَبُّ","meaning":"Rabbi"},{"arabic":"ٱلْعَـٰلَمِينَ","meaning":"alemlerin"}]}]}
