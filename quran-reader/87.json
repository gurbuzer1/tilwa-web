ne de"},{"arabic":"يَحْيَىٰ","meaning":"yaşam"}]},{"number":14,"reference":"87:14","arabic":"قَدْ أَفْلَحَ مَن تَزَكَّىٰ","meaning":"Arınan kurtuluşa ermiştir.","words":[{"arabic":"قَدْ","meaning":"doğrusu"},{"arabic":"أَفْلَحَ","meaning":"kurtuluşa ermiştir"},{"arabic":"مَن","meaning":"kimse"},{"arabic":"تَزَكَّىٰ","meaning":"nefsini arındıran"}]},{"number":15,"reference":"87:15","arabic":"وَذَكَرَ ٱسْمَ رَبِّهِۦ فَصَلَّىٰ","meaning":"Rabbinin adını anıp, namaz kılan.","words":[{"arabic":"وَذَكَرَ","meaning":"ve anan"},{"arabic":"ٱسْمَ","meaning":"adını"},{"arabic":"رَبِّهِۦ","meaning":"Rabbinin"},{"arabic":"فَصَلَّىٰ","meaning":"ve namaz kılan"}]},{"number":16,"reference":"87:16","arabic":"بَلْ تُؤْثِرُونَ ٱلْحَيَوٰةَ ٱلدُّنْيَا","meaning":"Siz, dünya hayatını tercih ediyorsunuz.","words":[{"arabic":"بَلْ","meaning":"ama"},{"arabic":"تُؤْثِرُونَ","meaning":"siz yeğliyorsunuz"},{"arabic":"ٱلْحَيَوٰةَ","meaning":"hayatını"},{"arabic":"ٱلدُّنْيَا","meaning":"dünya"}]},{"number":17,"reference":"87:17","arabic":"وَٱلْـَٔاخِرَةُ خَيْرٌ وَأَبْقَىٰٓ","meaning":"Ahiret ise daha iyi ve kalıcıdır.","words":[{"arabic":"وَٱلْـَٔاخِرَةُ","meaning":"oysa ahiret"},{"arabic":"خَيْرٌۭ","meaning":"daha iyidir"},{"arabic":"وَأَبْقَىٰٓ","meaning":"ve daha kalıcıdır"}]},{"number":18,"reference":"87:18","arabic":"إِنَّ هَـٰذَا لَفِى ٱلصُّحُفِ ٱلْأُولَىٰ","meaning":"Bu, evvelkilerin sahifelerinde de (yazılıdır).","words":[{"arabic":"إِنَّ","meaning":"şüphesiz"},{"arabic":"هَـٰذَا","meaning":"bu"},{"arabic":"لَفِى","meaning":"elbette vardı"},{"arabic":"ٱلصُّحُفِ","meaning":"sahifelerde de"},{"arabic":"ٱلْأُولَىٰ","meaning":"ilk"}]},{"number":19,"reference":"87:19","arabic":"صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰ","meaning":"İbrahim’in ve Musa’nın sahifelerinde…","words":[{"arabic":"صُحُفِ","meaning":"sayfalarında"},{"arabic":"إِبْرَٰهِيمَ","meaning":"İbrahim'in"},{"arabic":"وَمُوسَىٰ","meaning":"ve Musa'nın"}]}]}
