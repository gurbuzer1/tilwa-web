{"number":82,"source":"Kur’an metni ve kelime çözümlemesi: Quran.com · Türkçe meal: Shaban Britch; birleşik dört ayetin ayrımı: Dar Al-Salam Center","verses":[{"number":1,"reference":"82:1","arabic":"إِذَا ٱلسَّمَآءُ ٱنفَطَرَتْ","meaning":"Gök yarıldığı,","words":[{"arabic":"إِذَا","meaning":"zaman"},{"arabic":"ٱلسَّمَآءُ","meaning":"gök"},{"arabic":"ٱنفَطَرَتْ","meaning":"yarıldığı"}]},{"number":2,"reference":"82:2","arabic":"وَإِذَا ٱلْكَوَاكِبُ ٱنتَثَرَتْ","meaning":"Yıldızlar/gezegenler döküldüğü,","words":[{"arabic":"وَإِذَا","meaning":"ve zaman"},{"arabic":"ٱلْكَوَاكِبُ","meaning":"yıldızlar"},{"arabic":"ٱنتَثَرَتْ","meaning":"saçıldığı"}]},{"number":3,"reference":"82:3","arabic":"وَإِذَا ٱلْبِحَارُ فُجِّرَتْ","meaning":"Denizler kaynayıp birbirine karıştırıldığı,","words":[{"arabic":"وَإِذَا","meaning":"ve zaman"},{"arabic":"ٱلْبِحَارُ","meaning":"denizler"},{"arabic":"فُجِّرَتْ","meaning":"fışkırtıldığı"}]},{"number":4,"reference":"82:4","arabic":"وَإِذَا ٱلْقُبُورُ بُعْثِرَتْ","meaning":"Kabirlerin içi dışına çıkarıldığı zaman,","words":[{"arabic":"وَإِذَا","meaning":"ve zaman"},{"arabic":"ٱلْقُبُورُ","meaning":"kabirlerin"},{"arabic":"بُعْثِرَتْ","meaning":"içi dışına getirildiği"}]},{"number":5,"reference":"82:5","arabic":"عَلِمَتْ نَفْسٌ مَّا قَدَّمَتْ وَأَخَّرَتْ","meaning":"Kişi ne hazırlamış olduğunu ne ertelemiş olduğunu bilecektir.","words":[{"arabic":"عَلِمَتْ","meaning":"bilir"},{"arabic":"نَفْسٌۭ","meaning":"her can"},{"arabic":"مَّا","meaning":"ne"},{"arabic":"قَدَّمَتْ","meaning":"öne sürmüştür"},{"arabic":"وَأَخَّرَتْ","meaning":"ve geride bırakmıştır"}]},{"number":6,"reference":"82:6","arabic":"يَـٰٓأَيُّهَا ٱلْإِنسَـٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلْكَرِيمِ","meaning":"Ey insan! Kerim olan Rabbine karşı seni aldatan nedir?","words":[{"arabic":"يَـٰٓأَيُّهَا","meaning":"ey"},{"arabic":"ٱلْإِنسَـٰنُ","meaning":"insan"},{"arabic":"مَا","meaning":"nedir?"},{"arabic":"غَرَّكَ","meaning":"seni aldatan"},{"arabic":"بِرَبِّكَ","meaning":"Rabbine karşı"},{"arabic":"ٱلْكَرِيمِ","meaning":"engin kerem sahibi"}]},{"number":7,"reference":"82:7","arabic":"ٱلَّذِى خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ","meaning":"Seni yaratan ve seni düzenleyip sana biçim veren.","words":[{"arabic":"ٱلَّذِى","meaning":"O ki"},{"arabic":"خَلَقَكَ","meaning":"seni yarattı"},{"arabic":"فَسَوَّىٰكَ","meaning":"seni düzenledi"},{"arabic":"فَعَدَلَكَ","meaning":"sana ölçülü bir biçim verdi"}]},{"number":8,"reference":"82:8","arabic":"فِىٓ أَىِّ صُورَةٍ مَّا شَآءَ رَكَّبَكَ","meaning":"O, seni dilediği sûrette yarattı.","words":[{"arabic":"فِىٓ","meaning":"hangi;"},{"arabic":"أَىِّ","meaning":""},{"arabic":"صُورَةٍۢ","meaning":"surette"},{"arabic":"مَّا","meaning":"dilediyse"},{"arabic":"شَآءَ","meaning":""},{"arabic":"رَكَّبَكَ","meaning":"( o şekilde) seni terkib etti"}]},{"number":9,"reference":"82:9","arabic":"كَلَّا بَلْ تُكَذِّبُونَ بِٱلدِّينِ","meaning":"Hayır! Hesabı yalanlıyorsunuz.","words":[{"arabic":"كَلَّا","meaning":"hayır"},{"arabic":"بَلْ","meaning":"bilakis"},{"arabic":"تُكَذِّبُونَ","meaning":"siz yalanlıyorsunuz"},{"arabic":"بِٱلدِّينِ","meaning":"cezayı"}]},{"number":10,"reference":"82:10","arabic":"وَإِنَّ عَلَيْكُمْ لَحَـٰفِظِينَ","meaning":"Oysa üzerinizde kaydediciler var.","words":[{"arabic":"وَإِنَّ","meaning":"ve şüphesiz"},{"arabic":"عَلَيْكُمْ","meaning":"üzerinizde vardır"},{"arabic":"لَحَـٰفِظِينَ","meaning":"koruyucular"}]},{"number":11,"reference":"82:11","arabic":"كِرَامًا كَـٰتِبِينَ","meaning":"Şerefli yazıcılar/Kiramen Katibin.","words":[{"arabic":"كِرَامًۭا","meaning":"değerli"},{"arabic":"كَـٰتِبِينَ","meaning":"yazıcılar"}]},{"number":12,"reference":"82:12","arabic":"يَعْلَمُونَ مَا تَفْعَلُونَ","meaning":"Ne yaptığınızı biliyorlar.","words":[{"arabic":"يَعْلَمُونَ","meaning":"bilirler"},{"arabic":"مَا","meaning":"ne"},{"arabic":"تَفْعَلُونَ","meaning":"yapıyorsanız"}]},{"number":13,"reference":"82:13","arabic":"إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍ","meaning":"İyiler, elbette nimetler içinde olacaktır.","words":[{"arabic":"إِنَّ","meaning":"şüphesiz"},{"arabic":"ٱلْأَبْرَارَ","meaning":"iyiler"},{"arabic":"لَفِى","meaning":"içindedirler"},{"arabic":"نَعِيمٍۢ","meaning":"ni'metler"}]},{"number":14,"reference":"82:14","arabic":"وَإِنَّ ٱلْفُجَّارَ لَفِى جَحِيمٍ","meaning":"Kötüler/günahkârlar ise kesinlikle Cehennem'dedir.","words":[{"arabic":"وَإِنَّ","meaning":"ve şüphesiz"},{"arabic":"ٱلْفُجَّارَ","meaning":"kötüler"},{"arabic":"لَفِى","meaning":"içindedirler"},{"arabic":"جَحِيمٍۢ","meaning":"yakıcı ateş"}]},{"number":15,"reference":"82:15","arabic":"يَصْلَوْنَهَا يَوْمَ ٱلدِّينِ","meaning":"Hesap günü oraya atılacaklardır.","words":[{"arabic":"يَصْلَوْنَهَا","meaning":"oraya girerler"},{"arabic":"يَوْمَ","meaning":"günü"},{"arabic":"ٱلدِّينِ","meaning":"ceza"}]},{"number":16,"reference":"82:16","arabic":"وَمَا هُمْ عَنْهَا بِغَآئِبِينَ","meaning":"Onlar, oradan kaybolacak değillerdir.","words":[{"arabic":"وَمَا","meaning":"ve değillerdir"},{"arabic":"هُمْ","meaning":"onlar"},{"arabic":"عَنْهَا","meaning":"ondan"},{"arabic":"بِغَآئِبِينَ","meaning":"kaybolacak"}]},{"number":17,"reference":"82:17","arabic":"وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ","meaning":"Sana bildiren nedir? Hesap gününün ne olduğunu…","words":[{"arabic":"وَمَآ","meaning":"ve nedir?"},{"arabic":"أَدْرَىٰكَ","meaning":"sana bildiren"},{"arabic":"مَا","meaning":"ne olduğunu"},{"arabic":"يَوْمُ","meaning":"gününün"},{"arabic":"ٱلدِّينِ","meaning":"ceza"}]},{"number":18,"reference":"82:18","arabic":"ثُمَّ مَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ","meaning":"Yine, hesap gününün ne olduğunu sana bildiren nedir?","words":[{"arabic":"ثُمَّ","meaning":"sonra yine"},{"arabic":"مَآ","meaning":"nedir?"},{"arabic":"أَدْرَىٰكَ","meaning":"sana bildiren"},{"arabic":"مَا","meaning":"ne olduğunu"},{"arabic":"يَوْمُ","meaning":"gününün"},{"arabic":"ٱلدِّينِ","meaning":"ceza"}]},{"number":19,"reference":"82:19","arabic":"يَوْمَ لَا تَمْلِكُ نَفْسٌ لِّنَفْسٍ شَيْـًٔا ۖ وَٱلْأَمْرُ يَوْمَئِذٍ لِّلَّهِ","meaning":"O gün hiçbir kimse başkası için bir şeye sahip değildir. O gün, emir sadece Allah’ındır.","words":[{"arabic":"يَوْمَ","meaning":"bir gündür"},{"arabic":"لَا","meaning":"malik olmadığı"},{"arabic":"تَمْلِكُ","meaning":""},{"arabic":"نَفْسٌۭ","meaning":"kimsenin"},{"arabic":"لِّنَفْسٍۢ","meaning":"kimseye"},{"arabic":"شَيْـًۭٔا ۖ","meaning":"bir şeye (yardıma)"},{"arabic":"وَٱلْأَمْرُ","meaning":"ve buyruk"},{"arabic":"يَوْمَئِذٍۢ","meaning":"o gün"},{"arabic":"لِّلَّهِ","meaning":"yalnız Allah'ındır"}]}]}
