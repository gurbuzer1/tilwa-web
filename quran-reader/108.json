{"number":108,"source":"Kur’an metni ve kelime çözümlemesi: Quran.com · Türkçe meal: Shaban Britch; birleşik dört ayetin ayrımı: Dar Al-Salam Center","verses":[{"number":1,"reference":"108:1","arabic":"إِنَّآ أَعْطَيْنَـٰكَ ٱلْكَوْثَرَ","meaning":"Biz sana Kevser'i verdik.","words":[{"arabic":"إِنَّآ","meaning":"elbette biz"},{"arabic":"أَعْطَيْنَـٰكَ","meaning":"sana verdik"},{"arabic":"ٱلْكَوْثَرَ","meaning":"Kevser'i"}]},{"number":2,"reference":"108:2","arabic":"فَصَلِّ لِرَبِّكَ وَٱنْحَرْ","meaning":"Öyleyse sen de Rabbin için namaz kıl ve kurban kes!","words":[{"arabic":"فَصَلِّ","meaning":"öyleyse namaz kıl"},{"arabic":"لِرَبِّكَ","meaning":"Rabbin için"},{"arabic":"وَٱنْحَرْ","meaning":"ve kurban kes"}]},{"number":3,"reference":"108:3","arabic":"إِنَّ شَانِئَكَ هُوَ ٱلْأَبْتَرُ","meaning":"Gerçek şu ki sana kin besleyen kesiktir.","words":[{"arabic":"إِنَّ","meaning":"şüphesiz"},{"arabic":"شَانِئَكَ","meaning":"sana buğzeden"},{"arabic":"هُوَ","meaning":"o"},{"arabic":"ٱلْأَبْتَرُ","meaning":"sonu kesik olandır"}]}]}
