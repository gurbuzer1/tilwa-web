{"number":100,"source":"Kur’an metni ve kelime çözümlemesi: Quran.com · Türkçe meal: Shaban Britch; birleşik dört ayetin ayrımı: Dar Al-Salam Center","verses":[{"number":1,"reference":"100:1","arabic":"وَٱلْعَـٰدِيَـٰتِ ضَبْحًا","meaning":"Andolsun, soluya soluya koşanlara,","words":[{"arabic":"وَٱلْعَـٰدِيَـٰتِ","meaning":"andolsun koşanlara (atlara)"},{"arabic":"ضَبْحًۭا","meaning":"soluk soluğa"}]},{"number":2,"reference":"100:2","arabic":"فَٱلْمُورِيَـٰتِ قَدْحًا","meaning":"(Koşarken) kıvılcım saçanlara ,","words":[{"arabic":"فَٱلْمُورِيَـٰتِ","meaning":"(tırnaklarıyla) ateş çıkaranlara"},{"arabic":"قَدْحًۭا","meaning":"çarparak"}]},{"number":3,"reference":"100:3","arabic":"فَٱلْمُغِيرَٰتِ صُبْحًا","meaning":"Sabah vakti baskın yapanlara,","words":[{"arabic":"فَٱلْمُغِيرَٰتِ","meaning":"akın edenlere"},{"arabic":"صُبْحًۭا","meaning":"sabahleyin"}]},{"number":4,"reference":"100:4","arabic":"فَأَثَرْنَ بِهِۦ نَقْعًا","meaning":"Tozu dumana katanlara,","words":[{"arabic":"فَأَثَرْنَ","meaning":"toz koparanlara"},{"arabic":"بِهِۦ","meaning":"onunla (ayaklarıyla)"},{"arabic":"نَقْعًۭا","meaning":"toz"}]},{"number":5,"reference":"100:5","arabic":"فَوَسَطْنَ بِهِۦ جَمْعًا","meaning":"Topluluğun ortasına dalanlara,","words":[{"arabic":"فَوَسَطْنَ","meaning":"derken dalanlara"},{"arabic":"بِهِۦ","meaning":"onunla"},{"arabic":"جَمْعًا","meaning":"bir topluluğa"}]},{"number":6,"reference":"100:6","arabic":"إِنَّ ٱلْإِنسَـٰنَ لِرَبِّهِۦ لَكَنُودٌ","meaning":"İnsan, Rabbine karşı gerçekten nankördür.","words":[{"arabic":"إِنَّ","meaning":"şüphesiz"},{"arabic":"ٱلْإِنسَـٰنَ","meaning":"insan"},{"arabic":"لِرَبِّهِۦ","meaning":"Rabbine karşı"},{"arabic":"لَكَنُودٌۭ","meaning":"çok nankördür"}]},{"number":7,"reference":"100:7","arabic":"وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٌ","meaning":"Kendisi de buna şahittir.","words":[{"arabic":"وَإِنَّهُۥ","meaning":"ve elbette o da"},{"arabic":"عَلَىٰ","meaning":"buna"},{"arabic":"ذَٰلِكَ","meaning":""},{"arabic":"لَشَهِيدٌۭ","meaning":"şah