{"number":89,"source":"Kur’an metni ve kelime çözümlemesi: Quran.com · Türkçe meal: Shaban Britch; birleşik dört ayetin ayrımı: Dar Al-Salam Center","verses":[{"number":1,"reference":"89:1","arabic":"وَٱلْفَجْرِ","meaning":"Andolsun fecre,","words":[{"arabic":"وَٱلْفَجْرِ","meaning":"andolsun fecre"}]},{"number":2,"reference":"89:2","arabic":"وَلَيَالٍ عَشْرٍ","meaning":"On geceye,","words":[{"arabic":"وَلَيَالٍ","meaning":"ve geceye"},{"arabic":"عَشْرٍۢ","meaning":"on"}]},{"number":3,"reference":"89:3","arabic":"وَٱلشَّفْعِ وَٱلْوَتْرِ","meaning":"Çifte ve teke,","words":[{"arabic":"وَٱلشَّفْعِ","meaning":"ve çift'e"},{"arabic":"وَٱلْوَتْرِ","meaning":"ve tek'e"}]},{"number":4,"reference":"89:4","arabic":"وَٱلَّيْلِ إِذَا يَسْرِ","meaning":"Geçip giden geceye,","words":[{"arabic":"وَٱلَّيْلِ","meaning":"ve geceye"},{"arabic":"إِذَا","meaning":"gitmekte olan"},{"arabic":"يَسْرِ","meaning":""}]},{"number":5,"reference":"89:5","arabic":"هَلْ فِى ذَٰلِكَ قَسَمٌ لِّذِى حِجْرٍ","meaning":"Bunlarda akıl sahibi için elbette birer yemin vardır.","words":[{"arabic":"هَلْ","meaning":"değil mi?"},{"arabic":"فِى","meaning":"var"},{"arabic":"ذَٰلِكَ","meaning":"bunda"},{"arabic":"قَسَمٌۭ","meaning":"bir yemin"},{"arabic":"لِّذِى","meaning":"sahibi için"},{"arabic":"حِجْرٍ","meaning":"akıl"}]},{"number":6,"reference":"89:6","arabic":"أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِعَادٍ","meaning":"Ad kavmine Rabbin neler yaptı, görmedin mi?","words":[{"arabic":"أَلَمْ","meaning":"görmedin mi?"},{"arabic":"تَرَ","meaning":""},{"arabic":"كَيْفَ","meaning":"ne"},{"arabic":"فَعَلَ","meaning":"yaptı"},{"arabic":"رَبُّكَ","meaning":"Rabbin"},{"arabic":"بِعَادٍ","meaning":"Ad'e"}]},{"number":7,"reference":"89:7","arabic":"إِرَمَ ذَاتِ ٱلْعِمَادِ","meaning":"Sütunlar sahibi İrem’e…","words":[{"arabic":"إِرَمَ","meaning":"İrem'e?"},{"arabic":"ذَاتِ","meaning":"sütunlu"},{"arabic":"ٱلْعِمَادِ","meaning":""}]},{"number":8,"reference":"89:8","arabic":"ٱلَّتِى لَمْ يُخْلَقْ مِثْلُهَا فِى ٱلْبِلَـٰدِ","meaning":"Ve şehirler arasında bir benzeri yaratılmamıştı.","words":[{"arabic":"ٱلَّتِى","meaning":"ki"},{"arabic":"لَمْ","meaning":"yaratılmamıştı"},{"arabic":"يُخْلَقْ","meaning":""},{"arabic":"مِثْلُهَا","meaning":"onun eşi;"},{"arabic":"فِى","meaning":"ülkeler arasında"},{"arabic":"ٱلْبِلَـٰدِ","meaning":""}]},{"number":9,"reference":"89:9","arabic":"وَثَمُودَ ٱلَّذِينَ جَابُوا۟ ٱلصَّخْرَ بِٱلْوَادِ","meaning":"Ki vadide kayalar oyan Semud’a,","words":[{"arabic":"وَثَمُودَ","meaning":"ve Semud'a?"},{"arabic":"ٱلَّذِينَ","meaning":"oyan"},{"arabic":"جَابُوا۟","meaning":""},{"arabic":"ٱلصَّخْرَ","meaning":"kayaları"},{"arabic":"بِٱلْوَادِ","meaning":"vadide"}]},{"number":10,"reference":"89:10","arabic":"وَفِرْعَوْنَ ذِى ٱلْأَوْتَادِ","meaning":"Kazıklar/ordular sahibi Firavun’a,","words":[{"arabic":"وَفِرْعَوْنَ","meaning":"ve Fir'avn'a?"},{"arabic":"ذِى","meaning":"sahibi"},{"arabic":"ٱلْأَوْتَادِ","meaning":"kazıklar"}]},{"number":11,"reference":"89:11","arabic":"ٱلَّذِينَ طَغَوْا۟ فِى ٱلْبِلَـٰدِ","meaning":"Onlar, ülkelerde azmışlardı.","words":[{"arabic":"ٱلَّذِينَ","meaning":"ki"},{"arabic":"طَغَوْا۟","meaning":"azmışlardı"},{"arabic":"فِى","meaning":"ülkelerde"},{"arabic":"ٱلْبِلَـٰدِ","meaning":""}]},{"number":12,"reference":"89:12","arabic":"فَأَكْثَرُوا۟ فِيهَا ٱلْفَسَادَ","meaning":"Oralarda fesadı çoğaltmışlardı.","words":[{"arabic":"فَأَكْثَرُوا۟","meaning":"çokları"},{"arabic":"فِيهَا","meaning":"oralarda"},{"arabic":"ٱلْفَسَادَ","meaning":"kötülük etmişlerdi"}]},{"number":13,"reference":"89:13","arabic":"فَصَبَّ عَلَيْهِمْ رَبُّكَ سَوْطَ عَذَابٍ","meaning":"Rabbin de onlara azap kırbacı yağdırdı.","words":[{"arabic":"فَصَبَّ","meaning":"bu yüzden çarptı"},{"arabic":"عَلَيْهِمْ","meaning":"onların üzerine"},{"arabic":"رَبُّكَ","meaning":"Rabbin"},{"arabic":"سَوْطَ","meaning":"kırbacını"},{"arabic":"عَذَابٍ","meaning":"azab"}]},{"number":14,"reference":"89:14","arabic":"إِنَّ رَبَّكَ لَبِٱلْمِرْصَادِ","meaning":"Çünkü Rabbin gözetlemektedir.","words":[{"arabic":"إِنَّ","meaning":"elbette"},{"arabic":"رَبَّكَ","meaning":"Rabbin"},{"arabic":"لَبِٱلْمِرْصَادِ","meaning":"gözetleme yerindedir"}]},{"number":15,"reference":"89:15","arabic":"فَأَمَّا ٱلْإِنسَـٰنُ إِذَا مَا ٱبْتَلَىٰهُ رَبُّهُۥ فَأَكْرَمَهُۥ وَنَعَّمَهُۥ فَيَقُولُ رَبِّىٓ أَكْرَمَنِ","meaning":"İşte insan, onu Rabbi imtihan ettiği zaman, ona ikramda bulunup, nimetlendirince: \"Rabbim bana ikramda bulundu\" der.","words":[{"arabic":"فَأَمَّا","meaning":"fakat"},{"arabic":"ٱلْإِنسَـٰنُ","meaning":"insan"},{"arabic":"إِذَا","meaning":"zaman"},{"arabic":"مَا","meaning":"ne"},{"arabic":"ٱبْتَلَىٰهُ","meaning":"kendisini sınasa"},{"arabic":"رَبُّهُۥ","meaning":"Rabbi"},{"arabic":"فَأَكْرَمَهُۥ","meaning":"ve ona ikramda bulunsa"},{"arabic":"وَنَعَّمَهُۥ","meaning":"ve ona ni'met verse"},{"arabic":"فَيَقُولُ","meaning":"der ki"},{"arabic":"رَبِّىٓ","meaning":"Rabbim"},{"arabic":"أَكْرَمَنِ","meaning":"bana ikram etti"}]},{"number":16,"reference":"89:16","arabic":"وَأَمَّآ إِذَا مَا ٱبْتَلَىٰهُ فَقَدَرَ عَلَيْهِ رِزْقَهُۥ فَيَقُولُ رَبِّىٓ أَهَـٰنَنِ","meaning":"Ama onu, imtihan edip rızkını daralttığında: \"Rabbim beni zelil etti\" der.","words":[{"arabic":"وَأَمَّآ","meaning":"ama"},{"arabic":"إِذَا","meaning":"zaman"},{"arabic":"مَا","meaning":"ne"},{"arabic":"ٱبْتَلَىٰهُ","meaning":"onu sınasa"},{"arabic":"فَقَدَرَ","meaning":"ve daraltsa"},{"arabic":"عَلَيْهِ","meaning":"ona"},{"arabic":"رِزْقَهُۥ","meaning":"rızkını"},{"arabic":"فَيَقُولُ","meaning":"der ki"},{"arabic":"رَبِّىٓ","meaning":"Rabbim"},{"arabic":"أَهَـٰنَنِ","meaning":"beni alçalttı"}]},{"number":17,"reference":"89:17","arabic":"كَلَّا ۖ بَل لَّا تُكْرِمُونَ ٱلْيَتِيمَ","meaning":"Hayır! Yetime ikramda bulunmuyorsunuz.","words":[{"arabic":"كَلَّا ۖ","meaning":"hayır"},{"arabic":"بَل","meaning":"doğrusu"},{"arabic":"لَّا","meaning":"siz ikram etmiyorsunuz"},{"arabic":"تُكْرِمُونَ","meaning":""},{"arabic":"ٱلْيَتِيمَ","meaning":"yetime"}]},{"number":18,"reference":"89:18","arabic":"وَلَا تَحَـٰٓضُّونَ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ","meaning":"Düşkünü doyurmaya teşvik etmiyorsunuz","words":[{"arabic":"وَلَا","meaning":"ve"},{"arabic":"تَحَـٰٓضُّونَ","meaning":"teşvik etmiyorsunuz"},{"arabic":"عَلَىٰ","meaning":"yedirmeğe"},{"arabic":"طَعَامِ","meaning":""},{"arabic":"ٱلْمِسْكِينِ","meaning":"yoksula"}]},{"number":19,"reference":"89:19","arabic":"وَتَأْكُلُونَ ٱلتُّرَاثَ أَكْلًا لَّمًّا","meaning":"Mirası da şiddetle (hak gözetmeden) yiyorsunuz.","words":[{"arabic":"وَتَأْكُلُونَ","meaning":"ve yiyorsunuz"},{"arabic":"ٱلتُّرَاثَ","meaning":"mirası"},{"arabic":"أَكْلًۭا","meaning":"bir yiyişle"},{"arabic":"لَّمًّۭا","meaning":"hırsla"}]},{"number":20,"reference":"89:20","arabic":"وَتُحِبُّونَ ٱلْمَالَ حُبًّا جَمًّا","meaning":"Malı da pek çok seviyorsunuz.","words":[{"arabic":"وَتُحِبُّونَ","meaning":"ve seviyorsunuz"},{"arabic":"ٱلْمَالَ","meaning":"malı"},{"arabic":"حُبًّۭا","meaning":"sevgiyle"},{"arabic":"جَمًّۭا","meaning":"pek çok"}]},{"number":21,"reference":"89:21","arabic":"كَلَّآ إِذَا دُكَّتِ ٱلْأَرْضُ دَكًّا دَكًّا","meaning":"Hayır! Yer paramparça olduğu zaman,","words":[{"arabic":"كَلَّآ","meaning":"hayır"},{"arabic":"إِذَا","meaning":"zaman"},{"arabic":"دُكَّتِ","meaning":"dümdüz edildiği"},{"arabic":"ٱلْأَرْضُ","meaning":"yer"},{"arabic":"دَكًّۭا","meaning":"sarsıla"},{"arabic":"دَكًّۭا","meaning":"sarsıla"}]},{"number":22,"reference":"89:22","arabic":"وَجَآءَ رَبُّكَ وَٱلْمَلَكُ صَفًّا صَفًّا","meaning":"Rabbin ve saf saf melekler geldiği zaman,","words":[{"arabic":"وَجَآءَ","meaning":"ve geldiği (zaman)"},{"arabic":"رَبُّكَ","meaning":"Rabbine"},{"arabic":"وَٱلْمَلَكُ","meaning":"melekler"},{"arabic":"صَفًّۭا","meaning":"sıra"},{"arabic":"صَفًّۭا","meaning":"sıra"}]},{"number":23,"reference":"89:23","arabic":"وَجِا۟ىٓءَ يَوْمَئِذٍۭ بِجَهَنَّمَ ۚ يَوْمَئِذٍ يَتَذَكَّرُ ٱلْإِنسَـٰنُ وَأَنَّىٰ لَهُ ٱلذِّكْرَىٰ","meaning":"İşte cehennem o gün getirilir. Ve insan o gün (yaptıklarını) hatırlar. Fakat bu hatırlamanın ne faydası var!","words":[{"arabic":"وَجِا۟ىٓءَ","meaning":"ve getirildiği"},{"arabic":"يَوْمَئِذٍۭ","meaning":"o gün"},{"arabic":"بِجَهَنَّمَ ۚ","meaning":"cehennem"},{"arabic":"يَوْمَئِذٍۢ","meaning":"işte o gün"},{"arabic":"يَتَذَكَّرُ","meaning":"anlar"},{"arabic":"ٱلْإِنسَـٰنُ","meaning":"insan"},{"arabic":"وَأَنَّىٰ","meaning":"artık ne (yararı) var?"},{"arabic":"لَهُ","meaning":"kendisine"},{"arabic":"ٱلذِّكْرَىٰ","meaning":"anlamanın"}]},{"number":24,"reference":"89:24","arabic":"يَقُولُ يَـٰلَيْتَنِى قَدَّمْتُ لِحَيَاتِى","meaning":"Keşke hayatım için (ameller) yapıp sunsaydım.","words":[{"arabic":"يَقُولُ","meaning":"der ki"},{"arabic":"يَـٰلَيْتَنِى","meaning":"ah keşke ben"},{"arabic":"قَدَّمْتُ","meaning":"(iyi işler) gönderseydim"},{"arabic":"لِحَيَاتِى","meaning":"bu hayatım için"}]},{"number":25,"reference":"89:25","arabic":"فَيَوْمَئِذٍ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٌ","meaning":"İşte, hiç kimse o gün Allah’ın cezalandırdığı gibi cezalandıramaz.","words":[{"arabic":"فَيَوْمَئِذٍۢ","meaning":"o gün"},{"arabic":"لَّا","meaning":"azab edemez"},{"arabic":"يُعَذِّبُ","meaning":""},{"arabic":"عَذَابَهُۥٓ","meaning":"O'nun yapacağı azabı"},{"arabic":"أَحَدٌۭ","meaning":"hiç kimse"}]},{"number":26,"reference":"89:26","arabic":"وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدٌ","meaning":"Hiç kimse onun bağladığı gibi bağlayamaz.","words":[{"arabic":"وَلَا","meaning":"ve"},{"arabic":"يُوثِقُ","meaning":"bağ vuramaz"},{"arabic":"وَثَاقَهُۥٓ","meaning":"O'nun vuracağı bağı"},{"arabic":"أَحَدٌۭ","meaning":"hiç kimse"}]},{"number":27,"reference":"89:27","arabic":"يَـٰٓأَيَّتُهَا ٱلنَّفْسُ ٱلْمُطْمَئِنَّةُ","meaning":"Ey huzura ermiş nefis!","words":[{"arabic":"يَـٰٓأَيَّتُهَا","meaning":"ey"},{"arabic":"ٱلنَّفْسُ","meaning":"nefis"},{"arabic":"ٱلْمُطْمَئِنَّةُ","meaning":"huzura eren"}]},{"number":28,"reference":"89:28","arabic":"ٱرْجِعِىٓ إِلَىٰ رَبِّكِ رَاضِيَةً مَّرْضِيَّةً","meaning":"Sen O'ndan hoşnut, O da senden hoşnut olarak Rabbine dön!","words":[{"arabic":"ٱرْجِعِىٓ","meaning":"dön"},{"arabic":"إِلَىٰ","meaning":"Rabbine"},{"arabic":"رَبِّكِ","meaning":""},{"arabic":"رَاضِيَةًۭ","meaning":"razı olarak"},{"arabic":"مَّرْضِيَّةًۭ","meaning":"rızasını kazanarak"}]},{"number":29,"reference":"89:29","arabic":"فَٱدْخُلِى فِى عِبَـٰدِى","meaning":"Kullarımın arasına katıl!","words":[{"arabic":"فَٱدْخُلِى","meaning":"ve gir"},{"arabic":"فِى","meaning":"arasına"},{"arabic":"عِبَـٰدِى","meaning":"kullarım"}]},{"number":30,"reference":"89:30","arabic":"وَٱدْخُلِى جَنَّتِى","meaning":"Ve gir Cennet'ime!","words":[{"arabic":"وَٱدْخُلِى","meaning":"ve gir"},{"arabic":"جَنَّتِى","meaning":"cennetime"}]}]}
