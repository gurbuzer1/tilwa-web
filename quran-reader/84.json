{"number":84,"source":"Kur’an metni ve kelime çözümlemesi: Quran.com · Türkçe meal: Shaban Britch; birleşik dört ayetin ayrımı: Dar Al-Salam Center","verses":[{"number":1,"reference":"84:1","arabic":"إِذَا ٱلسَّمَآءُ ٱنشَقَّتْ","meaning":"Gök yarıldığı,","words":[{"arabic":"إِذَا","meaning":"zaman"},{"arabic":"ٱلسَّمَآءُ","meaning":"gök"},{"arabic":"ٱنشَقَّتْ","meaning":"yarıldığı"}]},{"number":2,"reference":"84:2","arabic":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ","meaning":"Rabbine boyun eğdiği zaman, ki ona yaraşan da budur.","words":[{"arabic":"وَأَذِنَتْ","meaning":"ve dinlediği (zaman)"},{"arabic":"لِرَبِّهَا","meaning":"Rabbini"},{"arabic":"وَحُقَّتْ","meaning":"kendisine yaraştığı üzere"}]},{"number":3,"reference":"84:3","arabic":"وَإِذَا ٱلْأَرْضُ مُدَّتْ","meaning":"Yeryüzü dümdüz edildiği,","words":[{"arabic":"وَإِذَا","meaning":"ve zaman"},{"arabic":"ٱلْأَرْضُ","meaning":"yer"},{"arabic":"مُدَّتْ","meaning":"uzatıldığı"}]},{"number":4,"reference":"84:4","arabic":"وَأَلْقَتْ مَا فِيهَا وَتَخَلَّتْ","meaning":"İçindekiler boşalıp, atıldığı zaman,","words":[{"arabic":"وَأَلْقَتْ","meaning":"dışarı atıp"},{"arabic":"مَا","meaning":"içindekileri"},{"arabic":"فِيهَا","meaning":""},{"arabic":"وَتَخَلَّتْ","meaning":"ve boşaldığı"}]},{"number":5,"reference":"84:5","arabic":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ","meaning":"Ve kendisine yaraştığı gibi Rabbine boyun eğdiği zaman.","words":[{"arabic":"وَأَذِنَتْ","meaning":"ve dinlediği (zaman)"},{"arabic":"لِرَبِّهَا","meaning":"Rabbini"},{"arabic":"وَحُقَّتْ","meaning":"kendisine yaraştığı üzere"}]},{"number":6,"reference":"84:6","arabic":"يَـٰٓأَيُّهَا ٱلْإِنسَـٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدْحًا فَمُلَـٰقِيهِ","meaning":"Ey insan! Sen Rabbine kavuşuncaya kadar çalışıp çabalayacak, sonunda O'na kavuşacaksın.","words":[{"arabic":"يَـٰٓأَيُّهَا","meaning":"ey"},{"arabic":"ٱلْإِنسَـٰنُ","meaning":"insan"},{"arabic":"إِنَّكَ","meaning":"elbette sen"},{"arabic":"كَادِحٌ","meaning":"çabalamaktasın"},{"arabic":"إِلَىٰ","meaning":"(varan yolda)"},{"arabic":"رَبِّكَ","meaning":"Rabbine"},{"arabic":"كَدْحًۭا","meaning":"gayretle"},{"arabic":"فَمُلَـٰقِيهِ","meaning":"nihayet O'na varacaksın"}]},{"number":7,"reference":"84:7","arabic":"فَأَمَّا مَنْ أُوتِىَ كِتَـٰبَهُۥ بِيَمِينِهِۦ","meaning":"Kimin kitabı sağından verilmişse,","words":[{"arabic":"فَأَمَّا","meaning":"ama"},{"arabic":"مَنْ","meaning":"kimin"},{"arabic":"أُوتِىَ","meaning":"verilirse"},{"arabic":"كِتَـٰبَهُۥ","meaning":"Kitabı"},{"arabic":"بِيَمِينِهِۦ","meaning":"sağından"}]},{"number":8,"reference":"84:8","arabic":"فَسَوْفَ يُحَاسَبُ حِسَابًا يَسِيرًا","meaning":"O, kolay bir hesapla hesap verecektir.","words":[{"arabic":"فَسَوْفَ","meaning":"yakında"},{"arabic":"يُحَاسَبُ","meaning":"hesaba çekilecektir"},{"arabic":"حِسَابًۭا","meaning":"bir hesapla"},{"arabic":"يَسِيرًۭا","meaning":"kolay"}]},{"number":9,"reference":"84:9","arabic":"وَيَنقَلِبُ إِلَىٰٓ أَهْلِهِۦ مَسْرُورًا","meaning":"Ailesinin yanına sevinç içinde dönecektir.","words":[{"arabic":"وَيَنقَلِبُ","meaning":"ve dönecektir"},{"arabic":"إِلَىٰٓ","meaning":"ailesine"},{"arabic":"أَهْلِهِۦ","meaning":""},{"arabic":"مَسْرُورًۭا","meaning":"sevinçli olarak"}]},{"number":10,"reference":"84:10","arabic":"وَأَمَّا مَنْ أُوتِىَ كِتَـٰبَهُۥ وَرَآءَ ظَهْرِهِۦ","meaning":"Kimin de kitabı arkasından verilmişse,","words":[{"arabic":"وَأَمَّا","meaning":"ve fakat"},{"arabic":"مَنْ","meaning":"kimin"},{"arabic":"أُوتِىَ","meaning":"verilirse"},{"arabic":"كِتَـٰبَهُۥ","meaning":"Kitabı"},{"arabic":"وَرَآءَ","meaning":"arka"},{"arabic":"ظَهْرِهِۦ","meaning":"tarafından"}]},{"number":11,"reference":"84:11","arabic":"فَسَوْفَ يَدْعُوا۟ ثُبُورًا","meaning":"Ölüp, yok olmayı çağıracak.","words":[{"arabic":"فَسَوْفَ","meaning":"sonra yakında"},{"arabic":"يَدْعُوا۟","meaning":"o çağıracak"},{"arabic":"ثُبُورًۭا","meaning":"ölümü"}]},{"number":12,"reference":"84:12","arabic":"وَيَصْلَىٰ سَعِيرًا","meaning":"Ve alevli ateşe girecektir.","words":[{"arabic":"وَيَصْلَىٰ","meaning":"ve girecektir"},{"arabic":"سَعِيرًا","meaning":"alevli ateşe"}]},{"number":13,"reference":"84:13","arabic":"إِنَّهُۥ كَانَ فِىٓ أَهْلِهِۦ مَسْرُورًا","meaning":"Nitekim o, ailesinin yanında neşeli idi.","words":[{"arabic":"إِنَّهُۥ","meaning":"çünkü o"},{"arabic":"كَانَ","meaning":"idi"},{"arabic":"فِىٓ","meaning":"arasında"},{"arabic":"أَهْلِهِۦ","meaning":"ailesi"},{"arabic":"مَسْرُورًا","meaning":"sevinçli"}]},{"number":14,"reference":"84:14","arabic":"إِنَّهُۥ ظَنَّ أَن لَّن يَحُورَ","meaning":"O, asla dönmeyeceğini sanıyordu.","words":[{"arabic":"إِنَّهُۥ","meaning":"şüphesiz o"},{"arabic":"ظَنَّ","meaning":"sanmıştı"},{"arabic":"أَن","meaning":"hiç"},{"arabic":"لَّن","meaning":""},{"arabic":"يَحُورَ","meaning":"dönmeyeceğini"}]},{"number":15,"reference":"84:15","arabic":"بَلَىٰٓ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيرًا","meaning":"Elbette dönecekti! Senin Rabbin onu görendir.","words":[{"arabic":"بَلَىٰٓ","meaning":"hayır"},{"arabic":"إِنَّ","meaning":"şüphesiz"},{"arabic":"رَبَّهُۥ","meaning":"Rabbi"},{"arabic":"كَانَ","meaning":"idi"},{"arabic":"بِهِۦ","meaning":"O'nu"},{"arabic":"بَصِيرًۭا","meaning":"görmekte"}]},{"number":16,"reference":"84:16","arabic":"فَلَآ أُقْسِمُ بِٱلشَّفَقِ","meaning":"Andolsun şafağa.","words":[{"arabic":"فَلَآ","meaning":"hayır"},{"arabic":"أُقْسِمُ","meaning":"and içerim"},{"arabic":"بِٱلشَّفَقِ","meaning":"akşamın alaca karanlığına"}]},{"number":17,"reference":"84:17","arabic":"وَٱلَّيْلِ وَمَا وَسَقَ","meaning":"Geceye ve topladıklarına.","words":[{"arabic":"وَٱلَّيْلِ","meaning":"ve geceye"},{"arabic":"وَمَا","meaning":"ve şeylere"},{"arabic":"وَسَقَ","meaning":"topladığı"}]},{"number":18,"reference":"84:18","arabic":"وَٱلْقَمَرِ إِذَا ٱتَّسَقَ","meaning":"Dolunay halindeki Ay’a.","words":[{"arabic":"وَٱلْقَمَرِ","meaning":"ve aya"},{"arabic":"إِذَا","meaning":"zaman"},{"arabic":"ٱتَّسَقَ","meaning":"dolunay olduğu"}]},{"number":19,"reference":"84:19","arabic":"لَتَرْكَبُنَّ طَبَقًا عَن طَبَقٍ","meaning":"Şüphesiz siz hâlden hâle